# Project-scoped dotenv for the nobigdeal-pro deploy — firebase-tools
# loads .env.<projectId> into every function's runtime env at deploy
# time, so values here survive redeploys (a gcloud --update-env-vars
# change would be wiped by the next firebase deploy). NON-SECRET values
# only — this file is committed to a public repo; secrets belong in
# Secret Manager via the function's secrets array.
#
# The filename is deliberately .env.nobigdeal-pro, not .env: the root
# .gitignore ignores bare .env at every level.

# Daily ops digest (functions/health-digest.js, 14:00 UTC cron → email
# queue → jd@). Shipped 2026-06 behind this gate and the cron skipped
# itself every day since — flipped on 2026-08-17 (verified via the
# health_digest.skipped log entries) together with the Image Pipeline
# orphan-watch section. Unset or set to anything but 'true' to pause.
HEALTH_DIGEST_ENABLED=true

# Review-ask digest (functions/review-request-nudge.js) -- the function
# already runs daily and writes the in-app bell/activity row in dry-run for
# every tenant; this flag only unlocks the per-rep Resend email summarizing
# recently-won jobs that have not been asked for a review yet. Enabled
# 2026-09-14 per the Grok CRM audit evaluation (documentation/audit/GROK-CRM-AUDIT-EVALUATION-2026-09-13.md).
REVIEW_NUDGE_ENABLED=true

# Automatic homeowner review ask (functions/review-ask-auto.js, 2026-10-15,
# Joe's go): reviewAskAutoSweep (10:00 ET) emails each paid-in-full NBD
# customer ONE Google review ask from jd@, 3-21 days after the payment's DATE
# RECEIVED (never the day it was typed in, so the 2026-10-15 backfill of old
# payments sends nothing). Unsubscribe + postal address via email-suppression.
# Every eligible customer is asked: no rating first, no incentive.
REVIEW_ASK_AUTO_EMAIL_ENABLED=true
# The customer's own before/after photo in that email (functions/review-ask-photo.js,
# 2026-10-16): photos already in the CRM for THAT lead only (tenant-checked), a
# tagged Before + After pair, else the latest After, else no photo (email
# unchanged). Re-encoded without EXIF/GPS and sent inline (cid:), never a link.
REVIEW_ASK_EMAIL_PHOTO_ENABLED=true
# The same ask by TEXT, only for a customer with no email and a stored web-form
# texting consent, 8am-9pm their time. DARK: flip only after A2P approval.
REVIEW_ASK_AUTO_TEXT_ENABLED=false

# Multi-job phase 1 (functions/jobs-mirror.js): keep leads/{id}/jobs/{activeJobId}
# in step with each lead's own stage / value / schedule / claim fields.
# Enabled 2026-09-30 on Jo's go-ahead, right after the one-time backfill
# (scripts/backfill-lead-jobs.js: 254/254 NBD leads, read back in step).
JOBS_MIRROR_ENABLED=true

# 6:45am appointment brief (functions/morning-brief.js): ONE email a day to the
# platform owner only (users/{NBD_OWNER_UID}.email), never a homeowner; nothing
# is sent on a day with no appointments. Shipped dry-run 2026-10-01 (#1954) and
# turned on the same day on Jo's go-ahead ("yes we should fix the morning
# brief"). Per-user off switch: users/{owner}.morningBriefEnabled === false.
MORNING_BRIEF_ENABLED=true

# Call Center ingest (functions/call-center.js): copy Jo's Cube ACR call recordings
# from the Drive folder Jo shared with the functions service account into
# private Storage calls/{owner}/cube-acr/ + phone_calls docs, 40 a run, every
# 30 min, 90-day backfill. Dry run 2026-10-01 counted 477 recordings; turned on
# the same day on Jo's go-ahead ("Yes, all 90 days"). Transcripts stay OFF
# (CALL_CENTER_TRANSCRIBE_ENABLED) until Jo has seen the one-call test.
CALL_CENTER_INGEST_ENABLED=true

# Call Center transcripts + AI notes (functions/call-center.js callCenterTranscribe):
# Groq Whisper transcript, Claude Haiku notes, customer timeline entry, and a
# follow-up task for calls from the last 14 days only. Personal calls keep no
# transcript and their CRM audio copy is deleted. One-call test 2026-10-01 (a
# 63 s customer call: summary + promises right); turned on the same day on
# Jo's go-ahead ("Yes, turn it on").
CALL_CENTER_TRANSCRIBE_ENABLED=true

# "You said you'd…" email (callCenterSweep, 07:15 + 15:15 ET): one internal
# email to the owner listing open call promises; nothing owed → nothing sent.
# Turned on 2026-10-01 on Jo's go-ahead ("Yes, both times").
CALL_CENTER_SWEEP_ENABLED=true
# callWatch (2026-10-02, Jo asked for it): every 2 h 8 AM-8 PM ET, bell + push to Jo only.
CALL_WATCH_ENABLED=true

# One morning email (functions/morning-brief-absorb.js, 2026-10-04, Jo approved):
# the 06:45 brief carries new leads (was dailyLeadDigest 07:00), the morning
# "you said you'd..." list (was callCenterSweep 07:15; the 15:15 run stays) and the
# owner's review asks (was reviewRequestNudge's 08:15 email). Only while
# MORNING_BRIEF_ENABLED=true and the owner has not switched the brief off.
# Unset to get the three separate emails back.
MORNING_BRIEF_ABSORB_ENABLED=true

# Nightly promise cleanup (functions/promise-cleanup.js, 02:30 ET, 2026-10-04, Jo
# approved): Claude Haiku marks a call/text promise kept ONLY when a later call,
# note or text says explicitly that it was done (quoted evidence, checked word for
# word); every change is logged to promise_cleanup_log. Unset = dry run (logs only).
PROMISE_CLEANUP_ENABLED=true

# Roof Care Plan (functions/care-plan.js, 2026-10-05, Jo approved the build): NBD's
# homeowner membership, $199/yr or $19/mo through Stripe Checkout. SHIPS DARK.
#   off  = nothing sells; the public page keeps "Get My Care Plan" -> contact.
#   test = Jo's CRM invite links work, and the page shows checkout only with
#          ?preview=careplan (for Jo's own real $19 signup + cancel).
#   live = the page sells to everyone.
# Also needs STRIPE_CAREPLAN_WEBHOOK_SECRET (its own Stripe webhook endpoint) —
# see documentation/projects/ROOF-CARE-PLAN-2026-10-05.md "Turning it on".
CARE_PLAN_MODE=off

# NBD's Twilio line (functions/twilio-line.js, 2026-10-06): inbound texts +
# delivery callbacks + inbound calls forwarded to Jo's cell, at /api/twilio/*.
# SHIPS DARK: anything but 'true' = fixed TwiML, nothing read or written, and a
# call hears "Please call <TWILIO_VOICE_FORWARD_TO>" instead of being forwarded.
# Flip to true only after the A2P campaign is approved AND the number's webhooks
# point at /api/twilio/* — documentation/runbooks/TWILIO-LINE-GO-LIVE.md.
TWILIO_INBOUND_ENABLED=false
# Speed-to-lead (2026-10-15): when true, the Call Center ingest auto-texts a
# missed caller who is a customer with stored web-form texting consent
# (tcpaConsent), 8am-9pm their time, once per number per 24 h, never after a
# STOP / Do Not Text or with the texting switch off (missed-call-autotext.js).
# Every missed call already gets a one-tap reply DRAFT Jo sends from his own
# phone; that is not behind this flag. Flip only after A2P approval.
MISSED_CALL_AUTOTEXT_ENABLED=false
# Where an inbound call to the Twilio number is forwarded (Jo's cell, E.164).
# The one place this is configured; the dark-mode message reads it too.
TWILIO_VOICE_FORWARD_TO=+18594207382

# Turnstile fail-closed (functions/integrations/turnstile.js, 2026-10-13): with the
# secret unset the verifier used to wave every lead through on App Check +
# honeypot + rate limit alone. "true" makes an UNSET TURNSTILE_SECRET return
# 403 turnstile-required instead, so a cleared or disabled secret can never
# silently switch the CAPTCHA off. Safe because TURNSTILE_SECRET is enabled in
# Secret Manager and bound (secretRef, verified 2026-10-13) to BOTH callers:
# submitPublicLead and carePlanPublic. The authed E2E rig emulates this same
# project id, so it loads this file too: tests/e2e/fixtures/ensure-emulator-env.js
# writes TURNSTILE_REQUIRED=false into the emulator-only functions/.env.local
# (loaded last, never deployed). EMERGENCY OFF: set this to false and
# redeploy (blanking the secret now fails CLOSED, not open) -
# documentation/runbooks/TURNSTILE-SETUP.md "Emergency".
TURNSTILE_REQUIRED=true

# Real drive times (functions/route-drive.js, 2026-10-16): the private OSRM
# routing service on Cloud Run (routing/osrm, runbook
# documentation/runbooks/OSRM-ROUTING.md). Not a secret: the service has no
# allUsers invoker, so the URL alone grants nothing.
OSRM_URL=https://osrm-cincy-717435841570.us-central1.run.app
