{{!--
  PROJECT CONTRACT — D-5
  The doc the customer signs. Legal weight + brand chrome.
  Shared cover, then clauses in numbered sections, signature block.

  Payload:
    preparedFor, preparedBy, projectMeta (cover)
    contract { number, date, startDate, completionDate }
    scope (string or array)
    contractPrice (number)
    paymentSchedule[] { stage, amount, dueDescription, amountText? }
      (from deposit-rule.js via doc pre-flight, 2026-09-25; amountText
      prints when a stage has no fixed amount yet — "Per your policy" for a
      deductible nobody has entered, "Set by your carrier" for the ACV check)
    paymentTerms (string)
    materials (string)
    warranty (string)              — the workmanship warranty (NBD: the NBD Pledge
                                     when warrantyIsPledge; another company: its own)
    manufacturerWarranty (string)  — the manufacturer warranty this job bought
                                     (2026-10-06), printed as its own line
    rightToCancel (string)
    additionalTerms (array of {title, body})
    transactionDate, jurisdiction { address, zip, jobType, claimNumber,
      insuranceCarrier, kentucky, insurance, kyInsurance }  (job FACTS only)
  Server-computed (functions/render-pdf.js buildContractStatutory, never the
  client payload): statutory { css, kyInsurance, contractorAddress,
  contractorFax, kyNoticesHtml, kyFormsHtml, lienClause, ftcStatementHtml,
  ftcFormsHtml } — KRS 367.624 notices + detachable NOTICE OF CANCELLATION
  (Kentucky insurance jobs, 2026 Ky. Acts ch. 54) and the FTC 16 CFR 429.1
  form the cancel sentence promises. Triple-stash is safe: every value inside
  those strings is escaped by ky-insurance-law.js.
--}}
{{{statutory.css}}}

{{> coverPage
  eyebrow="Project Contract · Roofing Services"
  tagline=coverTagline
  sub=coverSub
  preparedFor=preparedFor
  preparedBy=preparedBy
  projectMeta=projectMeta
}}

<section class="page-break">
  <div class="hero" style="margin-bottom: var(--s-5);">
    <div class="hero-eyebrow eyebrow">Agreement</div>
    <div class="hero-title" style="font-size:30pt;">The work, the price, the timeline.</div>
    <p class="hero-sub">This document is a binding agreement between the homeowner and {{company.footerName}} for the roofing services described below. Both parties sign at the end.</p>
  </div>

  {{#if statutory.kyInsurance}}
  {{!-- KRS 367.624(1)-(2): contractor mailing address, phone, fax/email --}}
  <section class="avoid-break" style="margin-bottom: var(--s-5);">
    <div class="eyebrow">Contractor</div>
    <p style="line-height:1.65;margin:0;"><strong>{{company.footerName}}</strong><br>
    Mailing address: {{statutory.contractorAddress}}<br>
    {{#if company.phone}}Phone: {{company.phone}}<br>{{/if}}
    {{#if statutory.contractorFax}}Fax: {{statutory.contractorFax}}<br>{{/if}}
    {{#if statutory.contractorEmail}}Email: {{statutory.contractorEmail}}{{/if}}</p>
  </section>
  {{/if}}

  {{!-- Headline contract price card --}}
  <section class="avoid-break total-block" style="margin-bottom: var(--s-6);">
    <div class="total-eyebrow">Contract Price</div>
    <div class="total-amount">{{money contractPrice}}</div>
    {{#if contract.startDate}}<div class="total-validity">Estimated start: {{contract.startDate}}{{#if contract.completionDate}} · Completion: {{contract.completionDate}}{{/if}}</div>{{/if}}
  </section>

  <h2>1 · Scope of Work</h2>
  {{#if scope}}<div style="line-height: 1.65; white-space: pre-wrap;">{{scope}}</div>{{else}}<p class="meta">See attached Estimate for itemized scope.</p>{{/if}}

  {{#if paymentSchedule.length}}
  <h2>2 · Payment Schedule</h2>
  <table>
    <thead>
      <tr><th>Stage</th><th>Due</th><th class="num">Amount</th></tr>
    </thead>
    <tbody>
      {{#each paymentSchedule}}
      <tr class="avoid-break">
        <td><strong>{{this.stage}}</strong></td>
        <td>{{this.dueDescription}}</td>
        <td class="num money"><strong>{{#if this.amountText}}{{this.amountText}}{{else}}{{money this.amount}}{{/if}}</strong></td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{/if}}

  {{#if paymentTerms}}
  <h2>3 · Payment Terms</h2>
  <p style="line-height:1.65;">{{paymentTerms}}</p>
  {{/if}}

  {{#if materials}}
  <h2>4 · Materials &amp; Workmanship</h2>
  <p style="line-height:1.65;">{{materials}}</p>
  {{/if}}

  {{#if warranty}}
  <h2>5 · Warranty</h2>
  <div class="pull">
    <div>
      <div class="pull-title">{{#if company.isNbd}}NBD Written Workmanship (Labor) Warranty{{else}}Workmanship Warranty{{/if}}</div>
      <div class="pull-body">{{warranty}}</div>
    </div>
  </div>
  {{!-- The NBD Pledge (Jo, 2026-10-06): NBD's promise on every job, printed
       apart from the written warranty — never a "lifetime warranty". --}}
  {{#if company.isNbd}}{{#if warrantyPledge}}
  <div class="pull">
    <div>
      <div class="pull-title">NBD Pledge</div>
      <div class="pull-body">{{warrantyPledge}}</div>
    </div>
  </div>
  {{/if}}{{/if}}
  {{#if manufacturerWarranty}}
  <div class="pull">
    <div>
      <div class="pull-body">{{manufacturerWarranty}}</div>
    </div>
  </div>
  {{/if}}
  {{else}}{{#if manufacturerWarranty}}
  <h2>5 · Warranty</h2>
  <div class="pull">
    <div>
      <div class="pull-body">{{manufacturerWarranty}}</div>
    </div>
  </div>
  {{/if}}{{/if}}

  {{#if rightToCancel}}
  <h2>6 · Right to Cancel</h2>
  <p style="line-height:1.65;">{{rightToCancel}}</p>
  {{/if}}

  {{#if statutory.paymentClause}}
  <h2>Payment</h2>
  <p style="line-height:1.65;">{{statutory.paymentClause}}</p>
  {{/if}}

  {{#if statutory.lienClause}}
  <h2>Mechanic's Liens</h2>
  <p style="line-height:1.65;">{{statutory.lienClause}}</p>
  {{/if}}

  {{#if additionalTerms.length}}
  {{#each additionalTerms}}
  <h2>{{add @index 7}} · {{this.title}}</h2>
  <p style="line-height:1.65;">{{this.body}}</p>
  {{/each}}
  {{/if}}
</section>

<div class="sig-block page-break">
  <h2 style="margin-top:0;">Acceptance &amp; Signatures</h2>
  <p class="meta" style="margin-bottom: var(--s-4);">By signing below, both parties acknowledge they have read, understood, and agree to all terms of this contract. This document constitutes the complete agreement between the parties; no other promises, representations, or agreements shall be binding unless in writing.</p>
  {{!-- KRS 367.624(3) notices, then the 16 CFR 429.1(a) statement "in
        immediate proximity to the space reserved ... for the signature of
        the buyer" — both bold, >= 10pt. --}}
  {{{statutory.kyNoticesHtml}}}
  {{{statutory.ftcStatementHtml}}}
  <div class="sig-grid">
    <div class="sig">
      <div class="sig-line"></div>
      <div class="sig-caption">{{preparedFor.name}} · Homeowner</div>
    </div>
    <div class="sig">
      <div class="sig-line"></div>
      <div class="sig-caption">{{preparedBy.name}} · {{company.footerName}}</div>
    </div>
  </div>
  <p class="meta" style="margin-top: var(--s-4); font-size: 9pt; text-align: center;">Each party should retain a fully-signed copy of this contract for their records.</p>
</div>

{{!-- Detachable cancellation forms, in duplicate, each on its own page after
      the signatures: KRS 367.624(4) (Kentucky insurance jobs) and the FTC
      Cooling-Off form (16 CFR 429.1(b)) the cancel sentence promises. --}}
{{{statutory.kyFormsHtml}}}
{{{statutory.ftcFormsHtml}}}

{{> affiliateRow}}
