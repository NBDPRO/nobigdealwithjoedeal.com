docs/pro/js/package-lock.json

# OS artifacts
.DS_Store
.fuse_hidden*
Thumbs.db

# Environment files
.env
.env.local
.env.production
# Every other env / key / credential shape (security checklist 2026-10-01 —
# the three names above left .env.staging, functions/.env.dev, key files and
# service-account JSON one `git add -A` away from a public repo). The one
# tracked env file holds only non-secret on/off switches and stays tracked.
.env.*
!.env.*.example
!functions/.env.nobigdeal-pro
*.pem
*.key
*.p12
*.pfx
**/service-account*.json
**/*credentials*.json
**/.runtimeconfig.json
# Firebase Functions secret overrides. ci.yml generates functions/.secret.local
# from the defineSecret() calls so the emulator can boot without Secret Manager
# access, and the local QA runbook has you do the same by hand — so this file
# routinely exists in a working tree while being exactly the shape of thing that
# must never be committed. It was not ignored, so a `git add -A` would have
# picked it up. gitleaks would catch a REAL secret in it, but the point is not
# to rely on that.
.secret.local
**/.secret.local

# Claude Code session data
.claude/

# Private catalog cost book. scripts/extract-catalog-costs.js rebuilds the
# wholesale-cost + labor overlay here so scripts/import-catalog-costs.js can
# load it into one tenant's Firestore book. Committing it would recreate the
# exact leak the public/private catalog split exists to close — this is a
# PUBLIC repo, so "not served by hosting" is not the same as "not readable"
# (#1147 → #1149).
.local/

# Firebase build caches
.firebase/*.cache
.firebase/hosting.*.cache
firebase-debug.log
tests/e2e/.audit-report.json
# globals-surface-snapshot.spec.js output (run it before AND after a globals
# refactor and diff the two files; the snapshots themselves are throwaway)
tests/e2e/.globals-*.json
# default output path of scripts/globals-xref.js when no out-file is given
globals-xref.json

# Obsidian vault workspace (documentation/ is usable as a vault; config stays local)
.obsidian/

# Deploy-time version stamp (scripts/verify-live-deploy.js stamp) — written on
# the deploy runner only, never committed.
docs/version.json
