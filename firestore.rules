rules_version = '2';

// NBD Pro Firestore Security Rules — HARDENED (2026-04-11)
// Deploy: firebase deploy --only firestore:rules
//
// Security model:
//   - Roles come from custom claims (`request.auth.token.role`), not from a
//     user-writable `users/{uid}.role` field.
//   - Broad `allow read: if isAuth()` is a footgun — every collection here
//     scopes reads to the resource owner, their company, or an admin.
//   - Subscription, rate_limits, access_codes, audit_log are admin-SDK-only.
//   - Public-write collections keep strict shape checks.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────
    //
    // Role taxonomy (custom claims):
    //   'admin'          → PLATFORM admin (support/ops). Cross-tenant.
    //                      Set only by a manual admin SDK script.
    //   'company_admin'  → tenant owner. Full access within own company.
    //   'manager'        → tenant manager. Read all team leads + reports.
    //   'sales_rep'      → individual rep. Owns their own docs only.
    //   'viewer'         → read-only inside their company.
    //
    // `isAdmin()` is now PLATFORM admin only — never use it on its own
    // for multi-tenant resources. Always pair it with
    // `sameCompanyAsResource()` or a company-scoped helper.
    // R3-7 (review round 3, 2026-10-06): an Anonymous-provider token is NOT a
    // signed-in user. Anonymous sign-in was never used by any page and is now
    // off in the Firebase console, but an account made before that can keep
    // refreshing its ID token, and every rule below built on isAuth() let it
    // read docPrefixes (each tenant's owner uid), squat companies/{its uid}
    // and write its own leads. .get() on both levels: a token without the
    // firebase map (the rules emulator's default) must not throw (NEW-5).
    function isAuth()    {
      return request.auth != null
        && request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'anonymous';
    }
    function isOwner(userId) { return isAuth() && request.auth.uid == userId; }
    function isAdmin()   { return isAuth() && request.auth.token.role == 'admin'; }
    function isCompanyAdmin() { return isAuth() && request.auth.token.role == 'company_admin'; }
    function isManager() { return isAuth() && request.auth.token.role == 'manager'; }

    function myCompanyId() {
      return request.auth.token.companyId;
    }

    // The uid-keyed tenant convention: a solo owner's company id IS their uid,
    // so "companyId == request.auth.uid" has long meant "this is my company".
    // That stops being true after an owner hand-off (transferCompanyOwnership,
    // 2026-10-08): the company keeps its id, the company doc names a new
    // ownerId, and the former owner must hold access only through their
    // claims, like any member (and lose it all when removed). So the uid branch
    // now also requires that no company doc says otherwise. A solo owner with
    // no company doc, or one whose doc names them (or names nobody), is
    // unaffected.
    function ownsTenantByUid(cid) {
      return isAuth() && request.auth.uid == cid
        && (!exists(/databases/$(database)/documents/companies/$(cid))
            || get(/databases/$(database)/documents/companies/$(cid)).data.get('ownerId', request.auth.uid) == request.auth.uid);
    }

    function sameCompanyAsResource() {
      // CRITICAL: require BOTH sides to be non-null. A token without a
      // companyId claim would otherwise pass this check against any
      // legacy doc whose companyId field was never set.
      return isAuth()
        && request.auth.token.companyId != null
        && resource.data.companyId != null
        && resource.data.companyId == request.auth.token.companyId;
    }

    // Company admin / manager acting inside their own tenant. Use this
    // for "see any lead in my team" style rules — NOT isAdmin() alone.
    function isCompanyStaff() {
      return isCompanyAdmin() || isManager();
    }

    // Company-wide PIPELINE readers — the roles the product grants team
    // lead-visibility (role taxonomy above: manager sees all reps' leads,
    // viewer is read-only INSIDE their company). sales_rep is deliberately
    // absent: own-leads-only — the same decision the Wave-110 client
    // hydration filter enforces at the fetch layer so teammates' data
    // never reaches a rep's browser. Role read via .get(): solo operators
    // carry NO role claim and a bare token.role access THROWS (NEW-5).
    function isCompanyReader() {
      return isAuth()
        && request.auth.token.get('role', '') in ['company_admin', 'manager', 'viewer'];
    }

    // 2026-09-25 (Jo's decision B): the 'viewer' role is READ-ONLY on tenant
    // data, everywhere. A viewer reads what isCompanyReader() allows and
    // writes none of it: not the lead (Audit #3 F-1 already said so), and not
    // the rows under a lead they happen to own either. Before this, the owner
    // branch of every lead subcollection (tasks, notes, drawings, documents,
    // warrantyClaims, signatures, activity) ignored role, so a viewer-owner
    // could write rows under a lead they could not update. The same held for
    // every owner-only top-level collection (photos, estimates, pins, ...),
    // and a viewer could CREATE leads, estimates, expenses and invoices.
    //
    // Every tenant-data write rule now ANDs this in on its owner branch (or on
    // the whole rule). It is false only for role == 'viewer', so no other role
    // loses anything. .get() because a solo operator has NO role claim and a
    // bare token.role read throws (NEW-5).
    //
    // Deliberately NOT applied: a viewer's own user-scoped docs — keyed to
    // their own uid / userId, about the viewer themselves, carrying no lead,
    // customer or money data — which the app writes to boot and to remember
    // settings: users/{uid} (+ subcollections: settings, preferences,
    // fcmTokens, jobTemplates, captures), userSettings/{uid}, notifications
    // addressed to them, reps/{uid} (their team profile), academy_progress/
    // {uid}, daily_entries/{uid}, dailyTracker, training_sessions (their own
    // sales-practice record) and estimate_drafts/{uid}. Most are private to
    // the viewer. Two are read by teammates BY DESIGN (corrected 2026-09-25 —
    // an earlier cut of this comment said "nobody else reads" them): every
    // member of the company reads reps/{uid} (it is the viewer's profile,
    // which decision B names as an exception), and a company_admin / manager
    // reads training_sessions to coach (it records the viewer's own practice,
    // not tenant business). The table is in
    // documentation/audit/ROLE-TIGHTENING-2026-09-25.md.
    function notViewer() {
      return isAuth() && request.auth.token.get('role', '') != 'viewer';
    }

    // Field-diff helper used by users/<uid> to block privilege escalation.
    function didNotChange(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // WRITE-ONCE: settable while absent/blank, immutable once set.
    //
    // customerId cannot simply join didNotChange on /leads: the client mints
    // it in a counter transaction and stamps it onto the lead it JUST created
    // (customer-bootstrap.module.js:433, dashboard-bootstrap.module.js:3270
    // and :3347), so freezing it outright breaks lead creation. What must not
    // be possible is REPOINTING an existing lead's customerId at a value
    // belonging to another tenant — the public referral resolver looks
    // customers up by this field (audit 2026-08-02).
    //
    // .get(field, '') on BOTH sides on purpose: comparing an absent map key
    // with == / != throws in rules rather than returning null (the NEW-5
    // lesson from the /leads viewer gate), which would deny every legitimate
    // update on a lead that never had the field.
    function writeOnce(field) {
      return resource.data.get(field, '') == ''
        || request.resource.data.get(field, '') == resource.data.get(field, '');
    }

    // R3-12 (review round 3, 2026-10-06): OWNERSHIP IS WRITE-ONCE on the flat
    // owner-keyed collections (tasks, drawings, communications,
    // lead_documents, review_requests, drip_queue, deal_rooms, dailyTracker,
    // products, templates, notes). Their update rules checked the owner on
    // resource.data.userId and never looked at the new data, so an owner
    // could set userId to any uid (the doc then showed in that user's lists:
    // a planted task "call 1-800-...", uids from docPrefixes) or re-tenant
    // companyId. userId is pinned to the caller at create, so write-once
    // freezes it. companyId may still be stamped ONCE on a legacy doc that
    // never had one (the customerId pattern on /leads), but only with the
    // writer's own tenant key: the companyId claim, or the uid for a solo
    // operator, the same key the /leads create pin uses. Update-only: a
    // delete has no request.resource, so the blocks below split update from
    // delete to carry it.
    function ownershipWriteOnce() {
      return writeOnce('userId') && writeOnce('companyId')
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['companyId'])
            || isAdmin()
            || (request.auth.token.get('companyId', '') != ''
                && request.resource.data.get('companyId', '') == request.auth.token.get('companyId', ''))
            || (request.auth.token.get('companyId', '') == ''
                && ownsTenantByUid(request.resource.data.get('companyId', ''))));
    }

    // Referral money fields are written ONLY by the onReferralLeadWrite trigger
    // (admin SDK). A client must never forge them on a lead (a rep could otherwise
    // fabricate an "owed" bonus or replay a credit). These are absence-safe via
    // diff().affectedKeys(), so normal edits to non-referral leads are unaffected.
    // NOT frozen (deliberately client-writable): redeemReferralCode (rep-entered
    // code) and referralCode/referralCodeCreatedAt (the mint on the referrer's own
    // lead) — and the owed<->paid toggle handled by referralStatusTransitionOk().
    function referralServerFieldsFrozen() {
      return didNotChange([
        'referralRewardAmount', 'referralAttributedAt', 'referrerLeadId',
        'referralDocId', 'referralRewardOwedAt', 'referredBy', 'referralCodeInvalid',
        // Multi-job (J1, 2026-09-30): how many jobs earned a bonus. Forging it
        // would defeat the "first job was already paid" legacy guard.
        'referralRewardJobCount'
      ]);
    }
    // The same server-owned referral fields must be ABSENT on a lead CREATE
    // (security batch 2026-10-03). referralServerFieldsFrozen() only guards
    // updates (diff-based), so a client could create a lead already carrying
    // an 'owed' bonus, a referralDocId / referrerLeadId pointer, or any other
    // field onReferralLeadWrite owns. No client create path writes any of them
    // (they are stamped by the admin SDK: submitReferral, referral-rewards.js).
    // ── Server-side plan lead cap (2026-10-04, tenant-ready) ──────────────
    // Every CLIENT lead create names its meter — 'manual' (Add Lead, D2D),
    // 'import' (CSV import) or 'sample' (Load Sample Data) — and the
    // meterLeadCreate trigger (functions/lead-cap.js) counts it on
    // subscriptions/{companyId}. A create is refused while that doc's
    // leadCap says this plan is at its cap for the month, except an import /
    // sample still inside its one-time allowance (1000 / 20 — equal to
    // functions/lead-cap-logic.js), and refused outright during a cancelled
    // plan's read-only grace (readOnlyUntil). NBD's own company, platform
    // admins and owner-claim accounts are exempt, as in billing-gate.js.
    // Server-created leads (web form, referrals, SMS) bypass rules and are
    // never metered, as before.
    function leadMeterOk(d) {
      return d.companyId == '1phDvAVXHSg82wDLegAbQFq14Ci1'
        || isAdmin()
        || request.auth.token.get('owner', false) == true
        || (d.get('meter', '') in ['manual', 'import', 'sample']
            && leadCapOpen(d.companyId, d.get('meter', '')));
    }
    function leadCapOpen(cid, meter) {
      return !exists(/databases/$(database)/documents/subscriptions/$(cid))
        || subAllowsLead(get(/databases/$(database)/documents/subscriptions/$(cid)).data, meter);
    }
    function subAllowsLead(sub, meter) {
      let ro = sub.get('readOnlyUntil', null);
      let cap = sub.get('leadCap', null);
      return !(ro is timestamp && request.time < ro)
        && ((meter == 'import' && sub.get('importAllowanceUsed', 0) < 1000)
            || (meter == 'sample' && sub.get('sampleAllowanceUsed', 0) < 20)
            || !(cap is map
                 && cap.get('plan', '') == sub.get('plan', 'free')
                 && cap.get('blockedUntil', null) is timestamp
                 && request.time < cap.blockedUntil));
    }
    function leadCreateHasNoServerFields() {
      return !request.resource.data.keys().hasAny([
        'referralRewardStatus', 'referralRewardAmount', 'referralAttributedAt',
        'referrerLeadId', 'referralDocId', 'referralRewardOwedAt', 'referredBy',
        'referralCodeInvalid', 'referralRewardJobCount', 'referralRewardPaidAt',
        // Roof Care Plan mirror (functions/care-plan.js) — server-written only.
        'carePlan',
        // Intake provenance (functions/integrations/calcom.js, lead-bridge.js,
        // thumbtack.js — admin SDK). lead-alert.js decides whether to page
        // someone from these, so a client must not be able to assert them
        // (2026-10-13: lead-alert provenance hardening).
        'publicLeadKind', 'publicLeadCollection', 'publicLeadId',
        'webLead', 'calcomBookingId', 'backfilledBy',
        // Texting consent evidence is server-captured only (2026-10-19, see the update rule).
        'tcpaConsent', 'tcpaConsentAt', 'tcpaConsentText', 'tcpaConsentSource', 'tcpaConsentIp', 'tcpaConsentVersion',
        // Owner-confirmed source (2026-10-19): set only by the owner, on an update.
        'confirmedSource', 'confirmedSourceNote', 'confirmedSourceBy', 'confirmedSourceAt'
      ]);
    }
    // A customerId whose leading segment is a RESERVED prefix
    // (docPrefixes/{PREFIX}, reserveCompanyPrefix) must belong to the lead's
    // own tenant (security batch 2026-10-03). The public referral resolver
    // (functions/referrals.js) maps a code to its tenant by that prefix, so a
    // lead stamped with another tenant's 'OAK-0001-…' was an impersonation of
    // that tenant's customer code. Segments that cannot be a prefix (shape
    // /^[A-Z0-9]{2,12}$/, the resolver's own test) or are not reserved stay
    // allowed: CSV import keeps a legacy CRM's own customer ids. Non-string
    // values can never match the resolver's string query, so they pass.
    function customerIdTenantOk(cid, tenant) {
      return !(cid is string)
        || !cid.split('-')[0].matches('^[A-Z0-9]{2,12}$')
        || !exists(/databases/$(database)/documents/docPrefixes/$(cid.split('-')[0]))
        || get(/databases/$(database)/documents/docPrefixes/$(cid.split('-')[0])).data.get('companyId', '') == tenant;
    }
    // The per-JOB referral latch (functions/referral-rewards.js creditJob).
    // A client must never set, clear or change it on a job: clearing it on a
    // closed job would re-arm onReferralJobWrite and pay the bonus twice.
    function jobReferralFieldsOk() {
      let keys = ['referralRewardOwedAt', 'referralRewardAmount', 'referralRewardLegacy'];
      return request.method == 'create'
        ? !request.resource.data.keys().hasAny(keys)
        : !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }
    // referralRewardStatus is trigger-set (pending->owed). The ONLY client-allowed
    // change is the rep's Mark Paid / Mark Unpaid toggle between owed and paid
    // (referral-rewards-ui.js). Any other transition (e.g. forging ''->owed, or
    // resetting owed->pending to replay Phase B) is denied.
    function referralStatusTransitionOk() {
      let b = resource.data.get('referralRewardStatus', '');
      let a = request.resource.data.get('referralRewardStatus', '');
      return b == a || (b in ['owed', 'paid'] && a in ['owed', 'paid']);
    }

    // 2026-09-15 (CRM stage-progression foundation work): `stageRole` is the
    // field every server-side classifier now trusts before falling back to a
    // hardcoded stage-key list — functions/stage-roles.js's roleFor(), which
    // money-dashboard.js, analytics-kpi.js, leaderboard.js, weekly-digest.js,
    // dormant-leads.js and functions/portal.js's progressKeyFor all read.
    // It's client-stamped on every stage change by stage-write.js's
    // commitStageChange(), but until now nothing at the trust boundary
    // stopped an authorized writer from setting it to an arbitrary string —
    // a forged or simply buggy value would silently misclassify that lead in
    // every revenue/KPI/digest/proactive-nudge surface that reads it.
    //
    // Deliberately narrow, mirroring referralStatusTransitionOk() above: the
    // pipeline itself stays freeform BY DESIGN (no stage-ORDER enforcement
    // exists anywhere, client or server — a tenant can add custom stages via
    // Settings > Pipelines and a rep can move a lead directly from New to
    // Closed). This does not attempt to validate that `stage` is a "legal"
    // value for that transition — only that stageRole, when present, is one
    // of the 5 real semantic roles, and stage is a reasonable string. A rules
    // read against the tenant's companyProfile.pipelines to validate the
    // stage itself is possible but is real added complexity + read cost for
    // a case client-side validation already covers (missingRequiredFields);
    // this closes the actual forgery gap without it.
    // A job doc (leads/{leadId}/jobs/{jobId}, 2026-09-30): the lead's own
    // stage / paperwork / schedule shape checks, plus the ownership stamps the
    // collection-group read trusts must equal the PARENT lead's — so a writer
    // cannot plant a job that another tenant's query would return.
    function jobWriteOk(leadId) {
      let lead = get(/databases/$(database)/documents/leads/$(leadId)).data;
      let d = request.resource.data;
      let valueOk = !('jobValue' in d) || d.jobValue == null
        || ((d.jobValue is int || d.jobValue is float) && d.jobValue >= 0 && d.jobValue < 100000000);
      let titleOk = !('title' in d) || (d.title is string && d.title.size() <= 120);
      return stageWriteOk() && paperworkFieldsOk() && scheduleWindowOk()
        && d.get('userId', '') == lead.get('userId', '')
        && d.get('companyId', '') == lead.get('companyId', '')
        && valueOk && titleOk && jobReferralFieldsOk();
    }

    // Production flow (2026-10-04) — a material order's shape. Owner + tenant
    // match the lead (the collection-group read trusts them); dates are
    // 'YYYY-MM-DD' or empty; status is an enum; the materials list is bounded
    // and carries NO money fields (a sub's job sheet is built from it, and
    // retail/cost figures have no business in an order row).
    function _orderYmdOk(f) {
      let v = request.resource.data.get(f, null);
      return v == null || v == '' || (v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }
    function orderWriteOk(leadId) {
      let lead = get(/databases/$(database)/documents/leads/$(leadId)).data;
      let d = request.resource.data;
      return d.get('userId', '') == lead.get('userId', '')
        && d.get('companyId', '') == lead.get('companyId', '')
        && (!('store' in d) || (d.store is string && d.store.size() <= 80))
        && (!('orderNumber' in d) || d.orderNumber == null || (d.orderNumber is string && d.orderNumber.size() <= 40))
        && (!('notes' in d) || d.notes == null || (d.notes is string && d.notes.size() <= 1000))
        && (!('status' in d) || d.status in ['planned', 'ordered', 'delivered', 'cancelled'])
        && _orderYmdOk('orderedDate') && _orderYmdOk('deliveryDate')
        && (!('items' in d) || (d.items is list && d.items.size() <= 200))
        && !d.keys().hasAny(['cost', 'costCents', 'price', 'priceCents', 'total', 'totalCents', 'materialTotal', 'margin']);
    }

    // Production flow (2026-10-04) — one subcontractor on a company's roster
    // (companies/{companyId}/subs). Crews are independent subs who carry their
    // own insurance; insuranceExpiry drives the expired-certificate warning.
    function subWriteOk() {
      let d = request.resource.data;
      let exp = d.get('insuranceExpiry', null);
      return d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && (!('phone' in d) || d.phone == null || (d.phone is string && d.phone.size() <= 40))
        && (!('email' in d) || d.email == null || (d.email is string && d.email.size() <= 120))
        && (!('trade' in d) || d.trade == null || (d.trade is string && d.trade.size() <= 40))
        && (!('notes' in d) || d.notes == null || (d.notes is string && d.notes.size() <= 1000))
        && (!('active' in d) || d.active is bool)
        && (exp == null || exp == '' || (exp is string && exp.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && subPaperworkOk(d);
    }

    // Sub paperwork tracker (2026-10-19, flag subPaperwork): W-9 status, liability
    // and workers' comp end dates, license note, a legal name for the 1099 prep.
    // Every field is optional and bounded. NO tax ID is ever stored here: a key
    // that names one is refused, and so is free text that holds a Social Security
    // or employer ID number (the W-9 itself is a private Storage file, see
    // sub-papers/ in storage.rules). (?s) so a newline cannot hide the number.
    function _subYmdOk(d, k) {
      return !(k in d) || d[k] == null || d[k] == '' || (d[k] is string && d[k].matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }
    function _subTextOk(d, k, max) {
      return !(k in d) || d[k] == null
        || (d[k] is string && d[k].size() <= max
            && !d[k].matches('(?s).*(^|[^0-9])([0-9]{3}-[0-9]{2}-[0-9]{4}|[0-9]{2}-[0-9]{7}|[0-9]{9})([^0-9]|$).*'));
    }
    function subPaperworkOk(d) {
      return !d.keys().hasAny(['ssn', 'ein', 'tin', 'taxId', 'taxid', 'tax_id', 'ssnLast4', 'einLast4', 'w9Last4', 'socialSecurity'])
        && (!('w9Status' in d) || d.w9Status in ['none', 'requested', 'on_file'])
        && (!('wcExempt' in d) || d.wcExempt is bool)
        && (!('licenseRequired' in d) || d.licenseRequired is bool)
        && _subYmdOk(d, 'w9ReceivedOn') && _subYmdOk(d, 'glExpiry') && _subYmdOk(d, 'wcExpiry')
        && _subYmdOk(d, 'licenseExpiry') && _subYmdOk(d, 'paperworkReviewedAt')
        && _subTextOk(d, 'legalName', 120) && _subTextOk(d, 'entityType', 40) && _subTextOk(d, 'wcExemptNote', 200)
        && _subTextOk(d, 'licenseNote', 200) && _subTextOk(d, 'paperworkNote', 500);
    }

    // 2026-10-12 — per-number contact labels (companies/{companyId}/
    // contact_labels/{digits10}; documentation/projects/CONTACT-ROUTING-TREE-
    // 2026-10-12.md). Shape only: doc id = the 10 digits, the doc says the
    // same, kind / policy are enums, strings are bounded, the doc names its own
    // company and the writer, and NO other key may ride along. A label only
    // decides what surfaces on Today; it carries no customer or money data.
    function contactLabelOk(companyId, digits) {
      let d = request.resource.data;
      return digits.matches('^[0-9]{10}$')
        && d.keys().hasOnly(['digits', 'kind', 'policy', 'name', 'note', 'source', 'companyId', 'updatedBy', 'updatedAtMs', 'createdAtMs', 'ackAtMs', 'capture'])
        && d.keys().hasAll(['digits', 'kind', 'policy', 'companyId', 'updatedBy', 'updatedAtMs', 'createdAtMs'])
        && d.digits == digits
        && d.companyId == companyId
        && d.updatedBy == request.auth.uid
        && d.kind in ['customer', 'prospect', 'contractor', 'sub', 'supplier', 'insurance', 'referral', 'personal', 'spam', 'recruiter', 'other']
        && d.policy in ['surface', 'quiet', 'hide']
        && (!('name' in d) || (d.name is string && d.name.size() <= 80))
        && (!('note' in d) || (d.note is string && d.note.size() <= 200))
        && (!('source' in d) || d.source in ['manual', 'seed-tag', 'thursday', 'lead', 'pattern'])
        // A timestamp from the future (a bad clock, a hostile write) must not park
        // a hidden number for good: ackAtMs / updatedAtMs are what "a hidden number
        // came back" compares calls against (QA 2026-10-13). <= now + 1 day.
        && (!('ackAtMs' in d) || (d.ackAtMs is number && d.ackAtMs >= 0 && d.ackAtMs <= request.time.toMillis() + 86400000))
        && (!('capture' in d) || (d.capture == 'off' && d.kind == 'personal'))
        && d.updatedAtMs is number && d.updatedAtMs >= 0 && d.updatedAtMs <= request.time.toMillis() + 86400000
        && d.createdAtMs is number;
    }

    // 2026-10-12 - "let Thursday handle this number" (companies/{companyId}/
    // thursday_handled/{digits10}; documentation/projects/THURSDAY-LABEL-
    // PLAYBOOKS-2026-10-12.md). The doc's EXISTENCE is the setting: no mode, no
    // flag, nothing sendable. Shape only: doc id = the 10 digits, the doc says the
    // same, the doc names its own company and the writer, a bounded note, and NO
    // other key may ride along.
    function thursdayHandledOk(companyId, digits) {
      let d = request.resource.data;
      return digits.matches('^[0-9]{10}$')
        && d.keys().hasOnly(['digits', 'companyId', 'updatedBy', 'updatedAtMs', 'createdAtMs', 'note'])
        && d.keys().hasAll(['digits', 'companyId', 'updatedBy', 'updatedAtMs', 'createdAtMs'])
        && d.digits == digits
        && d.companyId == companyId
        && d.updatedBy == request.auth.uid
        && (!('note' in d) || (d.note is string && d.note.size() <= 200))
        && d.updatedAtMs is number && d.createdAtMs is number;
    }

    // 2026-10-12 — remembered "Not this" dismissals of label suggestions
    // (companies/{companyId}/contact_suggestions/{digits10}). Shape only: id =
    // the 10 digits, a bounded list (<= 12) of { kind, atMs } — the kinds are
    // checked client-side; the rules bound the list and the keys, so the worst
    // a bad client writes is its own tenant's dismiss list.
    function contactSuggestionOk(companyId, digits) {
      let d = request.resource.data;
      return digits.matches('^[0-9]{10}$')
        && d.keys().hasOnly(['digits', 'dismissed', 'companyId', 'updatedBy', 'updatedAtMs'])
        && d.keys().hasAll(['digits', 'dismissed', 'companyId', 'updatedBy', 'updatedAtMs'])
        && d.digits == digits
        && d.companyId == companyId
        && d.updatedBy == request.auth.uid
        && d.dismissed is list && d.dismissed.size() <= 12
        && d.updatedAtMs is number;
    }

    function stageWriteOk() {
      let newRole = request.resource.data.get('stageRole', null);
      let roleOk = newRole == null || newRole in ['new', 'active', 'job', 'won', 'lost'];
      let newStage = request.resource.data.get('stage', null);
      let stageOk = newStage == null
        || (newStage is string && newStage.size() > 0 && newStage.size() <= 60);
      return roleOk && stageOk;
    }

    // 2026-09-15 (Paperwork Filing) — five flat *FiledAt scalars on the lead
    // gate REQUIRED_FIELDS_BY_TYPE's stage-advance hard block (crm-stages.js,
    // client-side). No rule change is strictly required for the gate to
    // function (the fields aren't in didNotChange()/writeOnce() above, so an
    // owner or same-company staff writer can already set them today, same
    // trust bar as claimNumber/scheduledDate) — but a same-company writer
    // could otherwise stamp an oversized/non-string garbage value into one of
    // these, same class of forgery gap stageWriteOk() above closes for
    // stage/stageRole. Mirrors that function's shape (a per-field helper, not
    // a `.all()` macro — a `let` binding is not valid inside `.all()`'s
    // single-expression predicate argument, so each field gets its own tiny
    // function instead of one clever one-liner).
    function _paperworkFieldOk(f) {
      let v = request.resource.data.get(f, null);
      return v == null || (v is string && v.size() <= 40);
    }
    function paperworkFieldsOk() {
      return _paperworkFieldOk('contractFiledAt')
          && _paperworkFieldOk('permitFiledAt')
          && _paperworkFieldOk('aobFiledAt')
          && _paperworkFieldOk('warrantyCertFiledAt')
          && _paperworkFieldOk('cocFiledAt');
    }

    // 2026-10-19 (Lead source fixer, flag leadSourceFixer) — leads/{id}.confirmedSource
    // is the OWNER's own answer to "where did this customer really come from",
    // the basis for collected-dollars-per-ad-dollar. It is never inferred, so
    // only the tenant owner may set or clear it: a platform admin, a
    // company_admin of the lead's company (the outer update clause already pins
    // the tenant), or a solo operator (no role claim, no foreign companyId)
    // who owns the lead. Managers, reps and viewers cannot, even though they
    // can otherwise edit the lead. When any of the four fields change the
    // value must be well-formed: a known source (or null to clear), a note of
    // 300 chars at most, confirmedSourceBy == the caller, confirmedSourceAt ==
    // request.time (no backdating). Unchanged fields never trigger the check,
    // so ordinary lead saves by any writer are unaffected.
    function confirmedSourceRoleOk() {
      return isAdmin() || isCompanyAdmin()
        || (request.auth.token.get('role', '') == ''
            && isOwner(resource.data.userId)
            && request.auth.token.get('companyId', request.auth.uid) == request.auth.uid);
    }
    function confirmedSourceShapeOk() {
      let d = request.resource.data;
      let src = d.get('confirmedSource', null);
      let note = d.get('confirmedSourceNote', null);
      return (src == null
              || (src is string && src in ['yelp', 'thumbtack_paid', 'thumbtack_direct', 'referral',
                                           'repeat', 'door_knock', 'google', 'manufacturer_locator', 'other']))
        && (note == null || (note is string && note.size() <= 300))
        && d.get('confirmedSourceBy', null) == request.auth.uid
        && d.get('confirmedSourceAt', null) == request.time;
    }
    function confirmedSourceWriteOk() {
      return !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['confirmedSource', 'confirmedSourceNote', 'confirmedSourceBy', 'confirmedSourceAt'])
        || (confirmedSourceRoleOk() && confirmedSourceShapeOk());
    }

    // 2026-09-15 (Warranty Claim lane) — the denormalized pointer to the
    // lead's currently-open warrantyClaims subdoc (or null once resolved).
    // Same shape-only trust bar as paperworkFieldsOk() above: a same-company
    // writer can already set this field (not in didNotChange()/writeOnce()),
    // this only stops an oversized/non-string forgery.
    function openClaimIdOk() {
      let v = request.resource.data.get('openWarrantyClaimId', null);
      return v == null || (v is string && v.size() <= 60);
    }

    // 2026-09-29 (calendar hub Phase 0) — the arrival window and the adjuster
    // meeting. These reach the .ics feed and (the window) the homeowner
    // portal, both of which re-validate; this is the same shape-only bar as
    // paperworkFieldsOk() so a garbage value never lands in the first place.
    // '' is allowed wherever null is: the claim editor saves an empty input
    // as ''. Date ORDER (end ≥ start) is the client's and the readers' job
    // (schedule-window.js) — string dates compare, but a rule that rejected a
    // mid-edit ordering would strand the whole lead save.
    function _hmOk(f) {
      let v = request.resource.data.get(f, null);
      return v == null || v == ''
        || (v is string && v.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'));
    }
    function _ymdOk(f) {
      let v = request.resource.data.get(f, null);
      return v == null || v == ''
        || (v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }
    function scheduleWindowOk() {
      let dur = request.resource.data.get('scheduledDurationMin', null);
      return _hmOk('scheduledStart')
          && _ymdOk('scheduledEndDate')
          && _ymdOk('scheduledWeek')         // the Monday of a week-planned job (2026-09-29)
          && (dur == null || (dur is int && dur >= 1 && dur <= 1440))
          && _ymdOk('adjusterMeetingDate')
          && _hmOk('adjusterMeetingStart');
    }

    // 2026-09-15 (Warranty Claim lane) — shape validator for the claim
    // subdoc itself (leads/{leadId}/warrantyClaims/{claimId}), modeled on
    // stageWriteOk()'s enum-check style. status/reason are the only fields
    // worth enum-gating; free-text notes fields are size-capped only, same
    // trust bar as everything else on this doc (same-company staff writer).
    //
    // CREATE/UPDATE ONLY (2026-09-25). This reads request.resource, which is
    // NULL on a delete, so `request.resource.data` is an evaluation error and
    // the whole condition denies. It sat inside an `allow write` (write =
    // create + update + delete) and so made every claim row undeletable by any
    // client, owner included. Same for documentStatusWriteOk() below. A shape
    // validator belongs on `allow create, update`; delete gets its own line.
    function warrantyClaimWriteOk() {
      let status = request.resource.data.get('status', null);
      let reason = request.resource.data.get('reason', null);
      return (status == null || status in ['open', 'scheduled', 'repaired', 'resolved', 'denied'])
          && (reason == null || reason in ['workmanship', 'material', 'manufacturer', 'goodwill']);
    }

    // 2026-09-17 (Document status field) — shape validator for the
    // draft/sent/signed lifecycle field on leads/{leadId}/documents.
    // Deliberately NOT gated by who can reach 'signed': onPersistFinalized
    // (in-person signing, document-generator.js) sets it via a plain client
    // updateDoc same as signedAt/signedSigners always have been — there is
    // no Cloud Function in that path to defer to, so restricting 'signed' to
    // admin-SDK writers would break real in-person signing, not just close a
    // forgery gap. Same trust bar as the rest of this doc: an owner or
    // same-company staffer could already stamp a fake signedAt; this only
    // stops an oversized/garbage status value, mirroring warrantyClaimWriteOk().
    // CREATE/UPDATE ONLY — see the delete note on warrantyClaimWriteOk().
    function documentStatusWriteOk() {
      let status = request.resource.data.get('status', null);
      return status == null || status in ['draft', 'sent', 'signed'];
    }

    // 2026-10-05 (security review) — htmlPath names the Storage object that
    // remote signing (functions/remote-signing.js) serves to a no-login
    // signer and then OVERWRITES with the executed record. A client that can
    // write this row used to be able to point it at any object in the bucket.
    // A NEW or CHANGED htmlPath must be the writer's own upload for THIS lead,
    // documents/<auth uid>/<leadId>/<file>.html — the exact shape the
    // generator (document-generator.js) and the inspection report
    // (inspection-report-engine.js) write. An UNCHANGED htmlPath passes, so
    // every existing row (whoever generated it) keeps updating as before. The
    // functions re-check the path too (the server is the authority).
    function documentHtmlPathOk(leadId) {
      let p = request.resource.data.get('htmlPath', null);
      let prev = resource == null ? null : resource.data.get('htmlPath', null);
      return p == null || p == prev
        || (p is string && p.size() < 600
            && p.split('/').size() == 4
            && p.split('/')[0] == 'documents'
            && p.split('/')[1] == request.auth.uid
            && p.split('/')[2] == leadId
            && p.split('/')[3].matches('[A-Za-z0-9._-]+[.]html'));
    }

    // 2026-09-29 — a SIGNED document is locked (Jo, 2026-09-25: "nobody can
    // change its content or status; the lead owner or a company_admin can
    // only archive it"). Signed = status 'signed', or a signedAt stamp (rows
    // from before the status field existed). Reaching 'signed' is unchanged:
    // that write goes FROM draft/sent, so the in-person onPersistFinalized
    // and the server's remote-signing path (admin SDK, no rules) both work.
    // Once signed, a client may only:
    //   - flip sharedWithHomeowner (visibility, not content) — any writer;
    //   - archive / un-archive (deleted, deletedAt) — owner or company_admin.
    // Hard delete of a signed row is refused for every client; the admin-SDK
    // sweep on lead deletion (onLeadDeleted) is unaffected.
    // Null-safe: a delete of a row that no longer exists has no `resource`
    // (a double-tap, a sweep race) and must not turn into an evaluation error.
    function documentIsSigned() {
      return resource != null
        && (resource.data.get('status', '') == 'signed'
            || resource.data.get('signedAt', null) != null);
    }
    // The legacy top-level twin has no parent lead: the row's own owner archives.
    function legacySignedDocumentUpdateOk() {
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      return keys.hasOnly(['sharedWithHomeowner', 'updatedAt'])
        || (keys.hasOnly(['deleted', 'deletedAt']) && isOwner(resource.data.userId));
    }
    function signedDocumentUpdateOk(leadId) {
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      return keys.hasOnly(['sharedWithHomeowner', 'updatedAt'])
        || (keys.hasOnly(['deleted', 'deletedAt'])
            && (isOwner(get(/databases/$(database)/documents/leads/$(leadId)).data.userId)
                || (isCompanyAdmin() && parentLeadInMyCompany(leadId))));
    }

    // A tenant's customer-ID prefix (brand.docPrefix) + its display twin
    // (brand.seal) are set ONLY by the reserveCompanyPrefix callable (admin SDK)
    // after it atomically claims docPrefixes/{PREFIX}. They must be immutable to
    // client writes — else a tenant could pick a prefix already reserved by
    // another company, and the public referral endpoint (resolves a lead by
    // exact customerId match) would misroute a homeowner's PII into the wrong
    // tenant's CRM. .get() on both the map and the key so an absent brand map or
    // key returns null instead of throwing.
    function brandPrefix(d) { return d.get('brand', {}).get('docPrefix', null); }
    function brandSeal(d)   { return d.get('brand', {}).get('seal', null); }

    // Parent-lead company check for lead SUBCOLLECTION reads: the caller
    // is a company reader (see isCompanyReader) and the PARENT lead
    // belongs to their tenant — so a manager opening a teammate's
    // customer page gets its activity/notes/documents, not a shell.
    // Fully throw-proof (.get() on BOTH sides): subcollection parents can
    // be legacy docs without companyId, and defensive tokens may lack the
    // claim. The get() is the same parent read the owner clause already
    // pays — rules dedupe repeated access to one document per request.
    // Today home (2026-10-03): the dashboard loads every task in ONE
    // collection-group query filtered on the task's own userId / companyId
    // (the recursive tasks rule below). Those stamps decide who can READ a
    // task, so a writer may only set them to values that keep the task inside
    // its own tenant: userId = the lead's owner or the writer, companyId = the
    // lead's tenant, the writer's tenant, or the writer's uid (a solo
    // operator's tenant key). Absent/null stays allowed — every legacy writer
    // and cached bundle omits them; functions/tasks-stamp.js fills them.
    function taskStampOk(leadId) {
      let lead = get(/databases/$(database)/documents/leads/$(leadId)).data;
      let d = request.resource.data;
      let u = d.get('userId', null);
      let c = d.get('companyId', null);
      return (u == null || u == lead.get('userId', '') || u == request.auth.uid)
        && (c == null || c == lead.get('companyId', '') || ownsTenantByUid(c)
            || c == request.auth.token.get('companyId', ''));
    }

    function parentLeadInMyCompany(leadId) {
      return isCompanyReader()
        && request.auth.token.get('companyId', '') != ''
        && get(/databases/$(database)/documents/leads/$(leadId)).data.get('companyId', '')
             == request.auth.token.get('companyId', '');
    }

    // 2026-10-05 (security review) — flat collections (/photos, /invoices)
    // name their lead by a leadId FIELD, which the writer chooses. These bind
    // it to a lead the writer may reach: they own it, or it is in their
    // tenant (company staff), or they are platform admin. A missing or
    // malformed leadId errors to deny inside leadReachable; callers check
    // noLeadId() first for collections where an unattached row is legal.
    function noLeadId(v) {
      return v == null || v == '';
    }
    function leadReachable(leadId) {
      return leadId is string && leadId.size() > 0 && leadId.size() <= 128
        && (isAdmin()
            || isOwner(get(/databases/$(database)/documents/leads/$(leadId)).data.get('userId', ''))
            || (isCompanyStaff() && parentLeadInMyCompany(leadId)));
    }
    // UPDATE: leadId unchanged, or a row that had none attached once.
    function leadIdStable() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['leadId'])
        || (noLeadId(resource.data.get('leadId', null))
            && (noLeadId(request.resource.data.get('leadId', null))
                || leadReachable(request.resource.data.leadId)));
    }

    // Same idea for FLAT collections that reference a lead by field
    // (photos carry leadId but predate companyId stamping): the caller is
    // a company reader and the REFERENCED lead is in their tenant. Guard
    // the key with `in` before path-interpolating it; a missing or
    // malformed leadId errors to deny.
    function docLeadInMyCompany() {
      return isCompanyReader()
        && request.auth.token.get('companyId', '') != ''
        && 'leadId' in resource.data
        && get(/databases/$(database)/documents/leads/$(resource.data.leadId)).data.get('companyId', '')
             == request.auth.token.get('companyId', '');
    }

    // ── LEADS ─────────────────────────────────────────
    // companyId is required on create. The Rock 3 backfill
    // (PR #56 audit/backfill callable) stamped companyId on every
    // pre-existing lead, so the field is now an invariant — every
    // lead in /leads/{leadId} must carry the creator's tenant scope.
    // Enforcing it here closes the "stray lead with no companyId"
    // hole that would otherwise let team-scoped queries (managers,
    // leaderboard rollups) silently miss new records.
    //
    // Token-claim ownership match (companyId == myCompanyId()) is
    // intentionally NOT enforced yet — that's a follow-up after
    // verifying every active user's custom claims include companyId.
    match /leads/{leadId} {
      // Team pipeline visibility (2026-07-06) — the follow-up the comment
      // above promised, unblocked once provisioning/claimInvite guarantee
      // companyId claims (proven end-to-end by the Stranger Test).
      // company_admin/manager/viewer read every lead in THEIR tenant;
      // sales_rep stays own-only (isCompanyReader excludes it). Shape
      // mirrors /expenses exactly — the form the rules tests prove
      // query-compliant for where('companyId','==',claim) list queries.
      // Owner check stays FIRST: legacy docs without companyId remain
      // owner-readable (absent-key access in the company clause errors
      // to deny, never widens).
      allow read: if isOwner(resource.data.userId)
        || isAdmin()
        || (isCompanyReader()
            && resource.data.companyId != null
            && resource.data.companyId == myCompanyId());
      // Audit #3 F-1: writes require a non-viewer role. A 'viewer' who happens
      // to own a lead can still READ it but can no longer mutate it at the rules
      // layer (read-only was previously UI-enforced only). Users with no role
      // claim (solo operators) keep write access.
      // NEW-5: use .get('role','') NOT `.role != 'viewer'`. Reading an ABSENT
      // map key with != THROWS in Firestore rules (it does not return undefined),
      // so a solo operator with no role claim — the intended-allowed case above —
      // was getting PERMISSION_DENIED on EVERY lead update/delete (soft-delete
      // silently failed; the optimistic-UI removal masked it, so deleted leads
      // reappeared on the next loadLeads, incl. bridged /inspect web-leads).
      // .get(key, default) returns the default when the key is absent and never
      // throws, preserving the viewer-only deny.
      // Manager edit rights (2026-07-06, Jo's call after team visibility):
      // same-company STAFF (company_admin + manager — isCompanyStaff, which
      // never matches viewer or sales_rep) can UPDATE any tenant lead so the
      // shared kanban is fully workable — but provenance is frozen
      // (didNotChange userId/companyId: managers edit content, they don't
      // reassign ownership or re-tenant a lead; reassignment ships as its
      // own feature). DELETE stays owner + same-company company_admin —
      // managers manage the board, only the lead owner or the tenant owner
      // destroys data. Legacy docs without companyId stay owner-only for
      // both (the company clause errors-to-deny on the absent key).
      allow update: if isAdmin()
        || (
          (
            (isOwner(resource.data.userId) && notViewer())
            || (isCompanyStaff()
              && resource.data.companyId != null
              && resource.data.companyId == myCompanyId())
          )
          // Provenance frozen for BOTH owner and staff (reassignment / re-tenanting
          // ships as its own feature). Server-owned referral money fields are
          // admin-SDK-only; the sole client write is the rep's Mark Paid / Mark
          // Unpaid toggle (owed<->paid), carved out below. See onReferralLeadWrite.
          && didNotChange(['userId', 'companyId'])
          // activeJobId names the job the lead's fields describe
          // (functions/jobs-mirror.js). Server-owned in phase 1: a client
          // re-saving the same value is fine, changing it is not.
          && didNotChange(['activeJobId'])
          // paymentBackfill is set once at create by the owner side, never toggled after.
          && didNotChange(['paymentBackfill'])
          // leads/{id}.carePlan mirrors the Roof Care Plan membership
          // (functions/care-plan.js webhook). It drives the member badge, the
          // 10% repair discount and storm priority, so only the server sets it.
          && didNotChange(['carePlan'])
          // Texting consent is evidence the SERVER captured from a website form (submitPublicLead / the
          // bridge, admin SDK). A rep must not be able to write it onto a lead to unlock texting a cold
          // number (messaging hardening 2026-10-19; sms-consent-declined.js consentBasis reads these).
          && didNotChange(['tcpaConsent', 'tcpaConsentAt', 'tcpaConsentText', 'tcpaConsentSource', 'tcpaConsentIp', 'tcpaConsentVersion'])
          // customerId is the key the PUBLIC referral resolver matches on, so
          // a lead whose customerId can be repointed can be aimed at another
          // tenant's customer. Write-once rather than frozen because the
          // client stamps it onto a just-created lead (see writeOnce).
          && writeOnce('customerId')
          // …and its first value (the client's mint, right after create) may
          // not claim another tenant's reserved prefix either. Only evaluated
          // when customerId is in the write, so ordinary edits cost no read.
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['customerId'])
              || customerIdTenantOk(request.resource.data.get('customerId', null),
                                    resource.data.get('companyId', resource.data.userId)))
          && referralServerFieldsFrozen()
          && referralStatusTransitionOk()
          && stageWriteOk()
          && paperworkFieldsOk()
          && confirmedSourceWriteOk()
          && openClaimIdOk()
          && scheduleWindowOk()
        );
      allow delete: if (isOwner(resource.data.userId) && notViewer())
        || isAdmin()
        || (isCompanyAdmin()
            && resource.data.companyId != null
            && resource.data.companyId == myCompanyId());
      // Decision B: a viewer cannot add a lead to the pipeline either.
      allow create: if isAuth()
        && notViewer()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.companyId is string
        && request.resource.data.companyId.size() > 0
        // Phase-1.5: pin companyId to the caller's own tenant (claim or, for
        // solo operators, their uid). Stops a rep stamping a foreign tenant's
        // companyId onto a lead and polluting that tenant's company-scoped
        // rollups. Client always stamps `claims.companyId || uid`.
        && (request.resource.data.companyId == myCompanyId()
            || (request.auth.token.get('companyId', '') == ''
                && ownsTenantByUid(request.resource.data.companyId)))
        // The lead modal's Add Lead carries the window too (2026-09-29).
        && scheduleWindowOk()
        // Server-owned referral fields never arrive on a create, and a
        // customerId (CSV import may carry one) cannot claim another
        // tenant's reserved prefix (security batch 2026-10-03).
        && leadCreateHasNoServerFields()
        // Server-minted doc ids (calcom__<booking>, <collection>__<id>) belong
        // to the webhook / bridge; a client may not squat one.
        && !leadId.matches('^(calcom|thumbtack_leads)__.*')
        && customerIdTenantOk(request.resource.data.get('customerId', null), request.resource.data.companyId)
        // The first job is made by the server (jobs-mirror.js), never claimed
        // by the client.
        && !('activeJobId' in request.resource.data)
        // paymentBackfill silences every after-install automation: owner side only.
        && (!('paymentBackfill' in request.resource.data) || backfillWriterOk())
        // Plan lead cap, enforced here and metered by the server (above).
        && leadMeterOk(request.resource.data);

      // D3: flat-path subcollections — the measurementWebhook +
      // esignWebhook auto-append activity here via admin SDK. Rules
      // only expose READ to the lead's owner + platform admin;
      // writes are admin-SDK only so webhook-stamped events can't
      // be forged by a rep.
      //
      // F-05: tightened. Reps can append manual notes/calls/sms/etc.
      // but can NOT fabricate webhook- or payment-shaped entries.
      // Every client-written activity must declare `source: 'rep'`
      // and restrict `type` to the human-action allowlist. Any
      // financial or webhook-scoped fields are disallowed on client
      // writes; those come only from admin SDK (webhooks).
      match /activity/{activityId} {
        allow read:  if isAuth() && (isAdmin()
          || isOwner(get(/databases/$(database)/documents/leads/$(leadId)).data.userId)
          || parentLeadInMyCompany(leadId));
        // Reps can append their own notes/activity via direct write; the
        // rule enforces shape. Webhook-written activities (measurement,
        // stripe, esign, calcom) bypass these rules via admin SDK.
        allow create: if isAuth()
          && notViewer()   // decision B: not even on a lead the viewer owns
          && request.resource.data.userId == request.auth.uid
          // Manager edit rights (2026-07): same-company staff may append
          // timeline entries on teammate leads; every F-05 shape constraint
          // below (source=='rep', type allowlist, financial-key denylist)
          // still applies to them unchanged.
          && (isOwner(get(/databases/$(database)/documents/leads/$(leadId)).data.userId)
              || (isCompanyStaff() && parentLeadInMyCompany(leadId)))
          && request.resource.data.source == 'rep'
          // F-05 allowlist of rep-authored, first-party activity types. These
          // are UI/timeline labels (drive timeline icons + lead-score signals)
          // — NOT webhook/payment-shaped — and remain gated by source=='rep',
          // the parent-lead owner check, and the financial-key denylist below.
          // ('voicemail','supplement_created','lead_created' added 2026-06-23:
          // these legit rep actions were silently permission-denied without it.)
          && request.resource.data.type in [
               'note', 'call', 'sms_out', 'email_out',
               'photo_added', 'task_done', 'appointment_set',
               'door_knock', 'follow_up', 'status_change',
               'voicemail', 'supplement_created', 'lead_created'
             ]
          && !(request.resource.data.keys().hasAny([
               'stripeInvoiceId', 'stripeCustomerId', 'stripePaymentIntentId',
               'amountCents', 'hostedInvoiceUrl',
               'signatureDocumentId', 'signatureProvider',
               'externalJobId', 'measurements', 'reportUrl'
             ]));
        allow update, delete: if false;
      }
      // Decision B (2026-09-25): notViewer() on every write below. The owner
      // branch used to ignore role, so a viewer who owned the lead could write
      // here while the lead doc itself refused them.
      match /tasks/{taskId} {
        allow read:   if isAuth() && (isAdmin()
          || isOwner(get(/databases/$(database)/documents/leads/$(leadId)).data.userId)
          || parentLeadInMyCompany(leadId));
        // 2026-10-03: create / a stamp change must keep the task in its
        // tenant (taskStampOk); an update that leaves the stamps alone (tick
        // done, move the due date) is unchanged.
        allow create: if isAuth() && notViewer()
          && (isOwner(get(/databases/$(database)/documents/leads/$(leadId)).data.userId)
              || (isCompanyStaff() && parentLeadInMyCompany(leadId)))
          && taskStampOk(leadId);
        allow update: if isAuth() && notViewer()
          && (isOwner(get(/databases/$(database)/documents/leads/$(leadId)).data.userId)
              || (isCompanyStaff() && parentLeadInMyCompany(leadId)))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'companyId'])
              || taskStampOk(leadId));
        allow delete: if isAuth() && notViewer()
          && (isOwner(get(/databases/$(database)/documents/leads/$(leadId)).data.userId)
              || (isCompanyStaff() && parentLeadInMyCompany(leadId)));
      }
      // ── DOC DRAFTS (stage-triggered "Docs to review", 2026-10-13) ──────
      // The server (functions/doc-drafts.js, admin SDK) drafts the customer
      // email that belongs to a stage event. The browser only reviews it:
      //   read    lead owner / same-company STAFF / platform admin — never a
      //           viewer or a rep who does not own the lead (it carries the
      //           customer's address and the money in a receipt);
      //   update  (2026-10-13, send bound to the draft) the browser can no
      //           longer say a draft was sent. The SERVER (sendEmail with a
      //           draftId, admin SDK) is the only writer of 'sending' / 'sent'
      //           / sentAt / messageId / the claim fields. A client may:
      //             - while status is 'draft': edit subject / body, move to
      //               'dismissed', or to 'copied' ("I sent it myself,
      //               outside the CRM" — the Thumbtack / Yelp / text path);
      //             - while status is 'failed' (a marker): dismiss it;
      //             - while status is 'sending' AND the server has given up
      //               waiting (sendState 'check_provider', or 'sent_unrecorded'
      //               = it went out but could not be marked) or the claim is
      //               over 5 minutes old: move it to 'copied' or 'dismissed'
      //               — never back to 'draft', so an unconfirmed send is
      //               never silently retried.
      //           A sent / copied / dismissed draft is final.
      //   create / delete  never from a client (a forged draft would sit in
      //           the owner's review queue looking like the system's).
      match /doc_drafts/{draftId} {
        allow read: if isAuth() && notViewer() && (isAdmin()
          || isOwner(get(/databases/$(database)/documents/leads/$(leadId)).data.userId)
          || (isCompanyStaff() && parentLeadInMyCompany(leadId)));
        allow update: if isAuth() && notViewer()
          && (isAdmin()
              || isOwner(get(/databases/$(database)/documents/leads/$(leadId)).data.userId)
              || (isCompanyStaff() && parentLeadInMyCompany(leadId)))
          && (
            (resource.data.status == 'draft'
              && request.resource.data.status in ['draft', 'dismissed', 'copied']
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status', 'subject', 'body', 'dismissedAt', 'copiedAt'])
              && request.resource.data.subject is string && request.resource.data.subject.size() <= 300
              && request.resource.data.body is string && request.resource.data.body.size() <= 10000
              && (!('copiedAt' in request.resource.data) || request.resource.data.copiedAt == null || request.resource.data.copiedAt is timestamp)
              && (!('dismissedAt' in request.resource.data) || request.resource.data.dismissedAt == null || request.resource.data.dismissedAt is timestamp))
            || (resource.data.status == 'failed'
              && request.resource.data.status == 'dismissed'
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status', 'dismissedAt'])
              && (!('dismissedAt' in request.resource.data) || request.resource.data.dismissedAt == null || request.resource.data.dismissedAt is timestamp))
            || (resource.data.status == 'sending'
              && request.resource.data.status in ['copied', 'dismissed']
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status', 'dismissedAt', 'copiedAt'])
              && (resource.data.get('sendState', '') in ['check_provider', 'sent_unrecorded']
                  || (resource.data.get('sendingAt', null) is timestamp
                      && request.time > resource.data.sendingAt + duration.value(5, 'm')))
              && (!('copiedAt' in request.resource.data) || request.resource.data.copiedAt == null || request.resource.data.copiedAt is timestamp)
              && (!('dismissedAt' in request.resource.data) || request.resource.data.dismissedAt == null || request.resource.data.dismissedAt is timestamp))
          );
        allow create, delete: if false;
      }
      match /notes/{noteId} {
        allow read:   if isAuth() && (isAdmin()
          || isOwner(get(/databases/$(database)/documents/leads/$(leadId)).data.userId)
          || parentLeadInMyCompany(leadId));
        allow write:  if isAuth() && notViewer()
          && (isOwner(get(/databases/$(database)/documents/leads/$(leadId)).data.userId)
              || (isCompanyStaff() && parentLeadInMyCompany(leadId)));
      }

      // ── RECORDINGS (Voice Intelligence) ───────────────
      // C2 — written by the Storage-triggered pipeline
      // (functions/integrations/voice-intelligence.js) via admin
      // SDK; clients never write directly so shape forgery is
      // impossible (same pattern as F-05 activity rule).
      //
      // Reads: lead owner, platform admin, or a company manager
      // whose companyId matches the recording's stamped companyId.
      // The company-scope check lets team managers review their
      // reps' calls without cross-tenant leakage.
      //
      // Audio files live at audio/{uid}/{leadId}/{recordingId}.ext
      // in Storage (see storage.rules); the doc here is the
      // transcript + structured summary + metadata.
      match /recordings/{recordingId} {
        allow read: if isAuth() && (
          isAdmin()
          || isOwner(resource.data.userId)
          || (isCompanyStaff()
              && resource.data.companyId != null
              && resource.data.companyId == myCompanyId())
        );
        allow write: if false;  // admin SDK only
      }

      // ── STORM PROOFS (idea #1 Phase 2) ──────────────────────────
      // Server-verified, adjuster-grade hail evidence written ONLY by the
      // attachStormProof callable (admin SDK). Client-read-only so the record
      // an adjuster is shown could not have been forged from the browser —
      // that immutability is the whole point. Read gate mirrors recordings
      // (owner OR same-company manager). Distinct from the client-writable
      // stormEvents[] array on the lead doc (Phase 1's informal note).
      match /storm_proofs/{proofId} {
        allow read: if isAuth() && (
          isAdmin()
          || isOwner(resource.data.userId)
          || (isCompanyStaff()
              && resource.data.companyId != null
              && resource.data.companyId == myCompanyId())
        );
        allow write: if false;  // admin SDK only — immutable evidence
      }

      // ── PORTAL MESSAGES (homeowner ↔ rep async chat) ──
      // Wave 123: bidirectional messaging surface. The homeowner
      // sends via the portal token-authed Cloud Function
      // (sendPortalMessage); the rep sends via a uid-authed callable
      // (replyToPortalMessage). Both write through admin SDK so
      // shape forgery is impossible — clients never write here.
      //
      // Reads: lead owner (rep) for the customer-page thread view,
      // or admin. Homeowner reads via getPortalMessages Cloud
      // Function with token auth (no Firebase user, so no rule
      // applies on that path — it goes through admin SDK).
      match /portal_messages/{messageId} {
        allow read: if isAuth() && (isAdmin()
          || isOwner(get(/databases/$(database)/documents/leads/$(leadId)).data.userId)
          || parentLeadInMyCompany(leadId));
        allow write: if false; // admin SDK only
      }

      // ── DOCUMENTS attached to a lead ──────────────────
      // Generated proposals/contracts/invoices/etc. that the rep
      // attaches to a customer record. Same auth shape as notes/tasks
      // — readable + writable by the lead owner (or admin). Without
      // this rule the Firestore default-deny silently hid every
      // attached document from the customer page documents list.
      match /documents/{documentId} {
        allow read:  if isAuth() && (isAdmin()
          || isOwner(get(/databases/$(database)/documents/leads/$(leadId)).data.userId)
          || parentLeadInMyCompany(leadId));
        // Manager edit rights, completing the 2026-07 pass. That pass gave
        // same-company staff write on activity/tasks/notes (:270, :297, :306)
        // and left documents and drawings on the pre-pass owner-only clause,
        // even though their READ already admitted a company reader. The result
        // was a manager who could SEE every document on a teammate's lead and
        // attach none: no signed doc, no generated contract, and — once the
        // photo report started filing itself — no report row either.
        // isCompanyStaff() is company_admin|manager, so `viewer` and
        // `sales_rep` stay read-only exactly as they are on notes and tasks.
        //
        // 2026-09-25: split out of `allow write`. documentStatusWriteOk() reads
        // request.resource, which is null on a delete, so the old single line
        // denied EVERY client delete here, owner included (emulator: "Null
        // value error" at the helper). #1771 gave delete the same writer check
        // create/update use; the 2026-09-25 decisions below then narrowed it
        // (managers and viewer-owners no longer hard-delete). A viewer or
        // sales_rep on someone else's lead is refused, and so is the platform
        // admin, the same set as tasks/notes/drawings.
        // The parent lead has to still exist for the check to pass. A
        // hard-deleted lead's rows are swept by onLeadDeleted (admin SDK,
        // functions/lead-artifact-cleanup.js); see the privacy note there.
        //
        // 2026-09-25, Jo's two calls on the review of #1771 (both final):
        //  A. Hard delete of a documents row (a signed contract) is the set
        //     that can delete the lead itself: the lead's owner, or a
        //     company_admin of the lead's tenant. Managers keep create/update
        //     (including the soft delete, an update of deleted:true) but lose
        //     the hard delete. The platform admin stays refused, as in #1771.
        //  B. A viewer writes nothing here, a viewer-owner included, so the
        //     viewer-owner exception described above is gone on all three
        //     operations.
        allow create: if isAuth() && notViewer()
          && (isOwner(get(/databases/$(database)/documents/leads/$(leadId)).data.userId)
              || (isCompanyStaff() && parentLeadInMyCompany(leadId)))
          && documentStatusWriteOk()
          && documentHtmlPathOk(leadId);
        // Split from create (2026-09-29): an update reads `resource`, which a
        // create does not have. A signed row is locked — see documentIsSigned().
        allow update: if isAuth() && notViewer()
          && (isOwner(get(/databases/$(database)/documents/leads/$(leadId)).data.userId)
              || (isCompanyStaff() && parentLeadInMyCompany(leadId)))
          && documentStatusWriteOk()
          && documentHtmlPathOk(leadId)
          && (!documentIsSigned() || signedDocumentUpdateOk(leadId));
        allow delete: if isAuth() && notViewer()
          && (isOwner(get(/databases/$(database)/documents/leads/$(leadId)).data.userId)
              || (isCompanyAdmin() && parentLeadInMyCompany(leadId)))
          && !documentIsSigned();
      }

      // ── WARRANTY CLAIMS (2026-09-15) ───────────────────
      // A claim opened against an already-CLOSED job (see crm-stages.js's
      // S.WARRANTY_CLAIM comment). Same owner-or-same-company-staff shape as
      // /documents directly above — a manager needs to open/resolve a
      // teammate's claim, not just view it. warrantyClaimWriteOk() closes
      // the same class of forgery gap stageWriteOk()/paperworkFieldsOk() do
      // for the parent lead: a same-company writer could already write here,
      // this only stops a garbage status/reason value.
      match /warrantyClaims/{claimId} {
        allow read:  if isAuth() && (isAdmin()
          || isOwner(get(/databases/$(database)/documents/leads/$(leadId)).data.userId)
          || parentLeadInMyCompany(leadId));
        // 2026-09-25: same split, same reason as /documents directly above.
        // warrantyClaimWriteOk() reads request.resource, so the old
        // `allow write` denied every client delete of a claim row.
        // Decisions A + B apply exactly as on /documents: hard delete is the
        // lead owner or a company_admin of its tenant; no viewer writes.
        allow create, update: if isAuth() && notViewer()
          && (isOwner(get(/databases/$(database)/documents/leads/$(leadId)).data.userId)
              || (isCompanyStaff() && parentLeadInMyCompany(leadId)))
          && warrantyClaimWriteOk();
        allow delete: if isAuth() && notViewer()
          && (isOwner(get(/databases/$(database)/documents/leads/$(leadId)).data.userId)
              || (isCompanyAdmin() && parentLeadInMyCompany(leadId)));
      }

      // ── JOBS (2026-09-30, a customer can have more than one job) ──
      // leads/{id} is the CUSTOMER; each piece of work is a job here
      // (functions/jobs-logic.js). Phase 1: the server writes these, by
      // mirroring the lead's own fields into its active job
      // (functions/jobs-mirror.js).
      // Stage 1 (2026-09-30): a client may also WRITE a job — the same set
      // that may write the lead's other subcollections (owner, or same-company
      // staff; never a viewer) — with the lead's own shape checks, and the
      // job must carry its lead's owner + tenant (the collection-group read
      // below trusts those two fields). The ACTIVE job's edits still go
      // through the lead (jobs-store.js routes them); these writes are for a
      // customer's other jobs. Hard delete: owner or company_admin.
      match /jobs/{jobId} {
        allow read: if isAuth() && (isAdmin()
          || isOwner(get(/databases/$(database)/documents/leads/$(leadId)).data.userId)
          || parentLeadInMyCompany(leadId));
        allow create, update: if isAuth() && notViewer()
          && (isOwner(get(/databases/$(database)/documents/leads/$(leadId)).data.userId)
              || (isCompanyStaff() && parentLeadInMyCompany(leadId)))
          && jobWriteOk(leadId);
        allow delete: if isAuth() && notViewer()
          && (isOwner(get(/databases/$(database)/documents/leads/$(leadId)).data.userId)
              || (isCompanyAdmin() && parentLeadInMyCompany(leadId)));

        // ── MATERIAL ORDERS (production flow, 2026-10-04) ──
        // leads/{id}/jobs/{jobId}/orders/{orderId}: store, ordered date,
        // delivery date, status, and the saved materials list (quantities and
        // names — never prices; the sub's job sheet is built from it). The
        // job doc need not exist (a lead whose jobs mirror has not run yet
        // keys its orders under 'j1', the id the mirror will create). Same
        // writer set as the job itself; the order carries its lead's owner +
        // tenant so the collection-group read below can trust them.
        // onOrderCalendarWrite turns a delivery day into a FREE all-day event.
        match /orders/{orderId} {
          allow read: if isAuth() && (isAdmin()
            || isOwner(get(/databases/$(database)/documents/leads/$(leadId)).data.userId)
            || parentLeadInMyCompany(leadId));
          allow create, update: if isAuth() && notViewer()
            && (isOwner(get(/databases/$(database)/documents/leads/$(leadId)).data.userId)
                || (isCompanyStaff() && parentLeadInMyCompany(leadId)))
            && orderWriteOk(leadId);
          allow delete: if isAuth() && notViewer()
            && (isOwner(get(/databases/$(database)/documents/leads/$(leadId)).data.userId)
                || (isCompanyAdmin() && parentLeadInMyCompany(leadId)));
        }
      }

      // ── DRAWINGS (roof measurements, sketches) ────────
      // Persistent maps.js drawings keyed under the lead. Same
      // owner-or-admin auth pattern. Default-deny was hiding every
      // saved drawing on customer page reload.
      match /drawings/{drawingId} {
        allow read:  if isAuth() && (isAdmin()
          || isOwner(get(/databases/$(database)/documents/leads/$(leadId)).data.userId)
          || parentLeadInMyCompany(leadId));
        // Same gap, same fix as /documents directly above — a manager could
        // open a teammate's roof measurements and not correct them.
        allow write: if isAuth() && notViewer()
          && (isOwner(get(/databases/$(database)/documents/leads/$(leadId)).data.userId)
              || (isCompanyStaff() && parentLeadInMyCompany(leadId)));
      }

      // ── AI TEXTING DRAFTS (T-2) ───────────────────────
      // generateAIDraft (incomingSMS webhook, admin SDK) writes a
      // suggested SMS reply here with status:'pending'. The rep's
      // customer-page panel reads them and flips status to 'approved'
      // (the onAiDraftApproved trigger then sends via Twilio) or
      // 'dismissed'. Owner-scoped via the draft's own stamped userId
      // (set from lead.userId at creation) — cheaper than a get() and
      // matches the recordings block's pattern.
      //
      // Rep updates are tightly constrained: they may only touch the
      // approve/dismiss/edit fields and may only move status to
      // 'approved' or 'dismissed'. They can NOT forge 'sent'/'failed'
      // (the trigger owns terminal states) nor mutate leadId/userId/
      // companyId/draftText-provenance/Twilio fields. create+delete are
      // admin-SDK only so a rep can't fabricate or destroy drafts.
      // notViewer() on the update (decision B, 2026-09-25): approving a draft
      // SENDS a text.
      match /ai_drafts/{draftId} {
        allow read: if isAuth() && (isAdmin() || isOwner(resource.data.userId));
        // Status moves a rep may make (review R2-3-3, 2026-10-06):
        //   pending → approved | dismissed   (approve sends — onAiDraftApproved)
        //   failed  → pending  | dismissed   ("edit and try again" re-queues it)
        //   send_uncertain → pending | dismissed  (review R6-3-3, 2026-10-07:
        //     Twilio may have taken it; only the rep, after checking the
        //     thread, puts it back — the panel never does that by itself)
        // NEVER sent / approved / failed / send_uncertain → approved: a stale
        // tab tapping Approve on a draft already sent must not text the
        // homeowner again.
        allow update: if isAuth()
          && isOwner(resource.data.userId) && notViewer()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'draftText', 'approvedAt', 'approvedBy', 'editedByRep', 'dismissedAt'])
          && ((resource.data.status == 'pending'
                && request.resource.data.status in ['approved', 'dismissed'])
            || (resource.data.status in ['failed', 'send_uncertain']
                && request.resource.data.status in ['pending', 'dismissed']));
        allow create, delete: if false; // admin SDK only
      }

      // ── SAVED SIGNATURES (PR3a — reuse store) ─────────
      // The doc generator writes each captured signature PNG here keyed
      // by role (Homeowner/Rep/Witness/…) after the customer signs, so a
      // future doc for the same lead can offer "Use saved" (PR3b). Same
      // owner-or-admin auth as documents/drawings — the rep owns their
      // lead's signature store; nobody else can read or write it.
      match /signatures/{sigRole} {
        allow read:  if isAuth() && (isAdmin()
          || isOwner(get(/databases/$(database)/documents/leads/$(leadId)).data.userId)
          || parentLeadInMyCompany(leadId));
        allow write: if isAuth() && notViewer()
          && isOwner(get(/databases/$(database)/documents/leads/$(leadId)).data.userId);
      }
    }

    // Audit #23: the nested /leads/{uid}/leads/{leadId} rule was a leftover
    // from an earlier nested schema. The live app stores leads flat at
    // /leads/{leadId} (see rule above). Only archived code under
    // docs/pro/js/_archive/ still references the nested path, so this rule
    // was granting unused read/write surface area. Removed — flat rule above
    // is the canonical path.

    // ── ESTIMATES ─────────────────────────────────────
    match /estimates/{estimateId} {
      // Team visibility (2026-07): every company READER (company_admin /
      // manager / viewer) reads the tenant's estimates so the pipeline /
      // estCount / estimate rows reflect the whole team. viewer is included by
      // owner decision (read-only staff who need to see quotes) — the same
      // isCompanyReader set /email_log + /sms_log use. Still tenant-scoped:
      // companyId must match, and sameCompany requires BOTH companyIds non-null,
      // so a solo user or a legacy estimate with no companyId falls back to
      // owner-only. delete + write provenance stay owner-only below.
      allow read: if isOwner(resource.data.userId) || isAdmin()
        || (isCompanyReader()
            && resource.data.companyId != null
            && resource.data.companyId == myCompanyId());
      // notViewer() on the owner branch of every write (decision B, 2026-09-25).
      allow delete: if (isOwner(resource.data.userId) && notViewer()) || isAdmin();
      // Edit-estimate legitimately rewrites the money fields (updateDoc with the
      // rebuilt payload), so DON'T freeze totals — but owner/provenance and the
      // server-stamped view counters must be immutable from the client (else an
      // owner could rewrite userId/createdBy or spoof viewCount/viewedAt to fake
      // engagement). The edit payload (_buildSavePayload) carries none of these
      // keys, so normal edits pass `didNotChange`. Mirrors the /expenses guard.
      allow update: if (isOwner(resource.data.userId) && notViewer()
            && didNotChange(['userId', 'companyId', 'createdBy', 'createdAt', 'viewedAt', 'viewCount', 'lastViewedAt', 'lastViewedVia', 'signedPrice']))
        || isAdmin();
      // companyId (when present) must be the caller's tenant — pins it so an
      // owner can't stamp a VICTIM tenant's companyId and inject an estimate
      // into that team's company-scoped rollups. Absent is allowed (legacy /
      // solo clients that don't stamp); '== uid' is the solo convention.
      allow create: if isAuth() && notViewer() && request.resource.data.userId == request.auth.uid
        && (request.resource.data.get('companyId', '') == ''
            || request.resource.data.companyId == request.auth.token.get('companyId', '')
            || (request.auth.token.get('companyId', '') == ''
                && ownsTenantByUid(request.resource.data.companyId)))
        && !('signedPrice' in request.resource.data);
      // signedPrice (review R6-2-2, Jo 2026-10-07) is the price the homeowner
      // SIGNED, which every bill charges until they re-sign. Only the server
      // stamps it when a signature lands (functions/signed-price.js): frozen
      // on update above (an edit re-prices the estimate, never what was
      // signed) and refused on create.
    }

    // ── SUPPLEMENTS (insurance leverage tool) ─────────
    // Wave 144: opened by adding the supplement-builder UI on the
    // customer-page estimate row. Engine
    // (estimate-supplement.js) was complete but the collection
    // had no Firestore rule — every saveToFirestore() call
    // silently 403'd. Same owner-scope shape as estimates: a
    // supplement always has userId stamped by saveToFirestore;
    // reads + updates require owner; creates require the caller's
    // uid be on the new doc. Schema: { userId, leadId,
    // parentEstimateId, version, status, reason, addedItems[],
    // modifications[], createdAt, updatedAt }.
    match /supplements/{supplementId} {
      // read and delete were one line; split 2026-09-25 so delete can carry
      // notViewer() (decision B) without touching read.
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if (isOwner(resource.data.userId) && notViewer()) || isAdmin();
      // Freeze the provenance on this financial doc: a saved supplement can't be
      // re-owned or re-pointed to a different parent estimate. Supplements are
      // created append-only (addDoc, versioned), so a legit update keeps userId +
      // parentEstimateId stable → passes; only tampering trips the guard.
      allow update: if (isOwner(resource.data.userId) && notViewer()
            && didNotChange(['userId', 'parentEstimateId']))
        || isAdmin();
      allow create: if isAuth() && notViewer() && request.resource.data.userId == request.auth.uid;
    }

    // ── EXPENSES (job costs / supplier spend) ─────────
    // Company-shared expense ledger that feeds per-job gross margin
    // (ProfitTracker.computeJobPL) and the supplier-spend reports.
    //
    // Ownership: an expense is created by a rep (userId == caller) and
    // stamped with the caller's tenant (companyId), pinned to the
    // caller's OWN company exactly like /leads — a rep can never write
    // an expense into a foreign tenant's rollups. Reads follow the
    // recordings/ + leaderboard precedent: the owning rep sees their
    // own; a company_admin or manager sees the whole team's spend (same
    // companyId — this is the "team admin sees all reps' spend" intent);
    // platform admin sees all. Updates/deletes stay with the owner
    // (non-viewer) or platform admin, and the immutable audit fields
    // (userId/companyId/createdAt/createdBy) can NEVER be mutated — IRS
    // "adequate records" (Rev. Proc. 97-22) want a stable provenance
    // trail and an un-rewritable original.
    //
    // Schema: { userId, companyId, leadId|null, category, costType
    //   ('direct'|'overhead'), supplier, amountCents (int), taxCents?
    //   (int), currency, date (Timestamp), note?, receiptStoragePath|null,
    //   receiptDocRef|null, source ('manual'|'ocr'), ocr?, needsReview,
    //   createdAt, createdBy, updatedAt }. The category→costType map and
    //   the single revenue basis live in docs/pro/js/expense-config.js
    //   (one source of truth shared by the form, reports, and margin
    //   engine — prevents the metric-definition drift that lets margins
    //   lie).
    //
    // Indexes (firestore.indexes.json, shipped in THIS change per the
    // rule-mismatch-audit discipline): {companyId,date}, {userId,date},
    // {userId,leadId,date}, {companyId,leadId,date}. A missing composite
    // index makes the spend report SILENTLY EMPTY — static CI catches
    // neither that nor a missing rule.
    // Money-field integrity for the shared, multi-writer expense ledger (it feeds
    // team rollups + the owner's monthly overhead digest). The client form gates
    // these, but rules are the real gate — a direct SDK write could otherwise forge
    // a negative/huge amount or flip costType to corrupt every downstream total.
    // Absence-safe (taxCents/costType validated only when present) so a legacy or
    // fallback-costType doc still edits; amountCents is required + a non-negative int.
    // Payment backfill (2026-10-19, docs/pro/js/payment-backfill.js): only the
    // OWNER side may write the backfill markers. The screen is owner-only in the UI;
    // this makes it true at the rules layer: platform admin, company_admin, or a solo
    // operator (no role, no company claim or the company is their own uid).
    function backfillWriterOk() {
      return isAdmin()
        || request.auth.token.get('role', '') == 'company_admin'
        || (request.auth.token.get('role', '') == ''
            && (request.auth.token.get('companyId', '') == '' || request.auth.token.get('companyId', '') == request.auth.uid));
    }
    function hasBackfillMark(d) {
      return d.get('source', '') == 'backfill' || d.get('backfilled', false) == true || d.get('backfillKey', '') != ''
        || d.get('paymentBackfill', false) == true;
    }
    // On an update the markers are frozen: set at create, never added, changed or removed.
    function backfillMarksFrozen() {
      return request.resource.data.get('backfilled', false) == resource.data.get('backfilled', false)
        && request.resource.data.get('backfillKey', '') == resource.data.get('backfillKey', '')
        && request.resource.data.get('paymentBackfill', false) == resource.data.get('paymentBackfill', false)
        && ((request.resource.data.get('source', '') == 'backfill') == (resource.data.get('source', '') == 'backfill'));
    }
    // A void (deleted false -> true) on an invoice carries a plain-text note.
    function invoiceVoidNoted() {
      return !(request.resource.data.get('deleted', false) == true && resource.data.get('deleted', false) != true)
        || (request.resource.data.get('voidNote', null) is string
            && request.resource.data.get('voidNote', '').size() > 0
            && request.resource.data.get('voidNote', '').size() <= 300);
    }
    // Sub-payment proof photos: each entry is a path inside THE WRITER'S OWN receipts/sub-proofs
    // folder (the Storage rules make that folder owner-only), never a URL.
    function proofPathAt(p, i) {
      return p.size() <= i
        || (p[i] is string && p[i].matches('receipts/' + request.auth.uid + '/sub-proofs/[A-Za-z0-9._-]+'));
    }
    function proofPathsOk(p) {
      return p.size() <= 10
        && proofPathAt(p, 0) && proofPathAt(p, 1) && proofPathAt(p, 2) && proofPathAt(p, 3) && proofPathAt(p, 4)
        && proofPathAt(p, 5) && proofPathAt(p, 6) && proofPathAt(p, 7) && proofPathAt(p, 8) && proofPathAt(p, 9);
    }
    function validExpenseMoney() {
      let d = request.resource.data;
      return d.amountCents is int && d.amountCents >= 0 && d.amountCents < 1000000000
        && (!('taxCents' in d) || (d.taxCents is int && d.taxCents >= 0))
        && (!('costType' in d) || d.costType in ['direct', 'overhead'])
        // Receipt sorter (2026-10-18): the kept line items are a bounded list and
        // the review state is one of four words; nothing else rides in either.
        && (!('items' in d) || (d.items is list && d.items.size() <= 60))
        && (!('reviewState' in d) || d.reviewState in ['unsorted', 'suggested', 'assigned', 'overhead'])
        // Cash payouts (cash-payouts.js, 2026-10-19): how the crew was paid and
        // a bounded edit/void audit trail.
        && (!('paymentMethod' in d) || d.paymentMethod in ['cash', 'zelle', 'check', 'other'])
        && (!('editLog' in d) || (d.editLog is list && d.editLog.size() <= 25))
        // Sub payments sorter (sub-payments.js, 2026-10-19): the proof photos are
        // Storage PATHS (receipts/{uid}/sub-proofs/...), a bounded list, and the
        // "Not a job cost" answer is a plain boolean.
        && (!('proofPaths' in d) || (d.proofPaths is list && (isAdmin() || proofPathsOk(d.proofPaths))))
        && (!('notJobCost' in d) || d.notJobCost is bool);
    }
    // Yard signs (yard-signs.js, 2026-09-29): where each sign is, a photo,
    // placed / pickup dates. The rep who placed it owns it; the company
    // (admins, managers, viewers) can see them; a company_admin can also
    // update one (pick up a rep's sign). Never hard-deleted from the client —
    // a sign ends as status 'picked_up' or 'missing'. The daily pickup
    // reminder (functions/yard-sign-reminder.js) reads them with the admin SDK.
    match /yardSigns/{signId} {
      allow read: if isOwner(resource.data.userId) || isAdmin()
        || (isCompanyReader()
            && resource.data.get('companyId', '') != ''
            && resource.data.get('companyId', '') == myCompanyId());
      allow create: if isAuth()
        && notViewer()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.companyId is string
        && request.resource.data.companyId.size() > 0
        && (request.resource.data.companyId == request.auth.token.get('companyId', '')
            || (request.auth.token.get('companyId', '') == '' && ownsTenantByUid(request.resource.data.companyId)))
        && request.resource.data.status == 'out';
      allow update: if (
          (isOwner(resource.data.userId) && notViewer())
          || (isCompanyAdmin() && resource.data.get('companyId', '') != '' && resource.data.get('companyId', '') == myCompanyId())
          || isAdmin())
        && didNotChange(['userId', 'companyId', 'createdAt'])
        && request.resource.data.status in ['out', 'picked_up', 'missing'];
      allow delete: if isAdmin();
    }

    match /expenses/{expenseId} {
      allow read: if isOwner(resource.data.userId)
        || isAdmin()
        || (isCompanyStaff()
            && resource.data.companyId != null
            && resource.data.companyId == myCompanyId());
      // companyId must be the caller's tenant claim. The `== uid` fallback is
      // ONLY for true solo operators (no companyId claim); a MEMBER whose token
      // carries companyId must stamp it, else they could set companyId=own-uid
      // and hide the expense from the company_admin/manager rollup + the
      // monthly-overhead cron (both filter companyId==tenant). (#12)
      // Uses .get('companyId','') NOT myCompanyId() — reading an ABSENT claim
      // key with == THROWS (same hazard as the role guard below), which would
      // permission-deny a legit claimless solo's own create.
      // notViewer() on create too (decision B, 2026-09-25): a viewer used to be
      // able to CREATE an expense and then not edit or delete it.
      allow create: if isAuth()
        && notViewer()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.companyId is string
        && request.resource.data.companyId.size() > 0
        && (request.resource.data.companyId == request.auth.token.get('companyId', '')
            || (request.auth.token.get('companyId', '') == '' && ownsTenantByUid(request.resource.data.companyId)))
        && validExpenseMoney();
      // notViewer() reads the role with .get('role','') NOT `.role != 'viewer'`
      // — reading an ABSENT claim key with != THROWS in rules (solo operators
      // have no role claim), which would permission-deny their own edits.
      allow update: if (isOwner(resource.data.userId)
            && notViewer()
            && didNotChange(['userId', 'companyId', 'createdAt', 'createdBy'])
            && validExpenseMoney())
        || isAdmin();
      allow delete: if (isOwner(resource.data.userId) && notViewer())
        || isAdmin();
    }

    // ── RECURRING EXPENSES (templates) ────────────────
    // One-tap-add templates for recurring costs (insurance, software, etc.).
    // Same owner + company-shared shape as /expenses. Generated occurrences are
    // normal /expenses docs; this just holds the template + nextDueDate.
    match /recurringExpenses/{templateId} {
      allow read: if isOwner(resource.data.userId) || isAdmin()
        || (isCompanyStaff() && resource.data.companyId != null && resource.data.companyId == myCompanyId());
      // Solo-only `== uid` fallback, same as /expenses create — absence-safe
      // .get('companyId','') so a claimless solo isn't THROW-denied. (#12)
      allow create: if isAuth()
        && notViewer()   // decision B, 2026-09-25 (update/delete already barred viewers)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.companyId is string && request.resource.data.companyId.size() > 0
        && (request.resource.data.companyId == request.auth.token.get('companyId', '')
            || (request.auth.token.get('companyId', '') == '' && ownsTenantByUid(request.resource.data.companyId)))
        && validExpenseMoney();
      allow update: if (isOwner(resource.data.userId) && notViewer()
            && didNotChange(['userId', 'companyId', 'createdAt', 'createdBy'])
            && validExpenseMoney()) || isAdmin();
      allow delete: if (isOwner(resource.data.userId) && notViewer()) || isAdmin();
    }

    // ── SUPPLIERS / VENDORS (1099 tracking) ───────────
    // Vendor records for 1099 tracking. NO TIN/SSN is stored here (or anywhere,
    // yet — product decision). Firestore rules can't hide a field, so a TIN on
    // a readable doc would leak to every same-company reader; the create/update
    // rules below therefore HARD-REJECT any client write carrying tin/ssn/ein.
    // The suppliers/{id}/private/** subtree is a locked, server-only seam
    // reserved for a future admin-SDK-encrypted TIN — clients can't touch it.
    match /suppliers/{supplierId} {
      allow read: if isOwner(resource.data.userId) || isAdmin()
        || (isCompanyStaff() && resource.data.companyId != null && resource.data.companyId == myCompanyId());
      // ALLOWLIST (not a denylist): only these tracking fields may be written
      // from the client, so ANY tax-ID key variant (tin/ssn/ein/taxId/social/…)
      // is rejected, not just three spellings (QA finding). The full TIN lives
      // only in the locked private/** subtree (server-only), never here.
      allow create: if isAuth()
        && notViewer()   // decision B, 2026-09-25 (update/delete already barred viewers)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.companyId is string && request.resource.data.companyId.size() > 0
        && (request.resource.data.companyId == myCompanyId()
            || (request.auth.token.get('companyId', '') == '' && ownsTenantByUid(request.resource.data.companyId)))
        && request.resource.data.keys().hasOnly(['userId', 'companyId', 'displayName', 'legalName',
             'taxClassification', 'is1099Eligible', 'w9Status', 'contact', 'createdAt', 'createdBy', 'updatedAt']);
      allow update: if (isOwner(resource.data.userId) && notViewer()
            && didNotChange(['userId', 'companyId', 'createdAt', 'createdBy'])
            && request.resource.data.keys().hasOnly(['userId', 'companyId', 'displayName', 'legalName',
                 'taxClassification', 'is1099Eligible', 'w9Status', 'contact', 'createdAt', 'createdBy', 'updatedAt'])) || isAdmin();
      allow delete: if (isOwner(resource.data.userId) && notViewer()) || isAdmin();

      // Server-only seam for a future encrypted TIN — locked to ALL clients.
      match /private/{doc} {
        allow read, write: if false;
      }
    }

    // ── PHOTOS ────────────────────────────────────────
    // Team visibility (2026-07-06): company readers see the photos of any
    // lead in THEIR tenant, so a manager opening a teammate's customer
    // page gets the gallery, not an empty grid. Two read paths, in order:
    //   1. companyId clause — photos stamped by post-2026-07 clients (and
    //      migration 004's backfill). This is the /leads-shape clause that
    //      makes where('companyId','==',claim) LIST queries provable —
    //      the dashboard thumbnail cache depends on it. Uses .get(), NOT
    //      bare access: an absent companyId must fall THROUGH to the
    //      leadId path below, and a thrown absent-key access would
    //      error-poison the whole disjunction to deny instead.
    //   2. docLeadInMyCompany — leadId → parent-lead lookup for docs the
    //      backfill hasn't reached (or whose lead predates stamping).
    //      Keep it even after 004 lands: it costs nothing on stamped
    //      docs (clause 1 short-circuits first) and keeps stragglers
    //      readable forever.
    // Writes stay owner-only. Create pins companyId to the caller's own
    // tenant when present (claim or solo uid — the Phase-1.5 /leads
    // shape) but still ACCEPTS its absence: open sessions run cached
    // pre-stamp bundles for days, and their uploads must not break.
    // Requiring the field outright is a follow-up once sessions cycle.
    match /photos/{photoId} {
      allow read: if isOwner(resource.data.userId) || isAdmin()
        || (isCompanyReader()
            && resource.data.get('companyId', '') != ''
            && resource.data.get('companyId', '') == myCompanyId())
        || docLeadInMyCompany();
      // UPDATE freezes provenance — mirrors /pins (~line 673) and /leads.
      // Create pins companyId, but update did not, so an owner could
      // legitimately create a photo in their OWN tenant and then issue one
      // follow-up updateDoc moving companyId to a VICTIM tenant, planting
      // an image in that company's shared gallery (audit 2026-08-02 — the
      // 2026-07-08 /pins fix never reached this rule). Delete is untouched.
      // notViewer() on the owner branch of every write (decision B, 2026-09-25).
      // 2026-10-05 (security review): leadId is frozen too (an unattached
      // photo may be attached once, to a lead the writer may reach).
      // source + path are frozen too, and a client may never CREATE a
      // source:'homeowner' photo: getHomeownerPortalView signs a homeowner
      // photo's `path` with the admin SDK (review R3-3, 2026-10-06). Only the
      // portal upload (admin SDK) writes those photos.
      // Object-path fields (2026-10-06, follow-up to R3-2/R3-3): storagePath,
      // thumbStoragePath and path are read by admin-SDK servers that sign,
      // download or delete the object (reel/social studio, money-paper plate,
      // tenant export, cleanup). A client may only name an object under its
      // OWN upload prefix, photos/{uid}/ — every client uploader writes there
      // (storage.rules owns that prefix). Absent / null / '' is fine.
      // On update: `path` stays frozen (admin-only homeowner/web-form field);
      // storagePath / thumbStoragePath may stay as they are or move to the
      // writer's own prefix — the annotation save-over re-points storagePath
      // at the flattened copy it just uploaded under photos/{uid}/.
      function ownPhotoObject(v) {
        return v == null || v == ''
          || (v is string
              && v.matches('photos/' + request.auth.uid + '/.+')
              && !v.matches('.*[.][.].*')
              && !v.matches('.*[/][/].*'));
      }
      function photoPathFieldOk(field) {
        return ownPhotoObject(request.resource.data.get(field, null));
      }
      allow update: if ((isOwner(resource.data.userId) && notViewer()) || isAdmin())
        && didNotChange(['userId', 'companyId', 'source', 'path'])
        && leadIdStable()
        && (didNotChange(['storagePath']) || photoPathFieldOk('storagePath'))
        && (didNotChange(['thumbStoragePath']) || photoPathFieldOk('thumbStoragePath'));
      allow delete: if (isOwner(resource.data.userId) && notViewer()) || isAdmin();
      // CREATE (2026-10-05): a photo that names a lead must name one the
      // writer owns or can reach in their own tenant — the flat collection
      // used to take any leadId, planting a photo in another tenant's
      // gallery / portal / invoice plate. No leadId (an unattached photo)
      // still passes, as before.
      allow create: if isAuth() && notViewer() && request.resource.data.userId == request.auth.uid
        && request.resource.data.get('source', '') != 'homeowner'
        && photoPathFieldOk('storagePath')
        && photoPathFieldOk('thumbStoragePath')
        && photoPathFieldOk('path')
        && (request.resource.data.get('companyId', '') == ''
            || request.resource.data.companyId == myCompanyId()
            || (request.auth.token.get('companyId', '') == ''
                && ownsTenantByUid(request.resource.data.companyId)))
        && (noLeadId(request.resource.data.get('leadId', null))
            || leadReachable(request.resource.data.leadId));
    }

    // ── ALERT OUTBOX ──────────────────────────────────
    // Admin-SDK-written ledger of lead-alert routing decisions
    // (functions/lead-alert.js recordAlertOutbox). Reads: platform admin
    // + the tenant's own company readers (/expenses shape — companyId is
    // always present on these docs, null for NBD-fallback alerts, so the
    // != null guard is safe). All client writes denied — alerts can't be
    // forged or scrubbed from the audit trail.
    match /alert_outbox/{outboxId} {
      allow read: if isAdmin()
        || (isCompanyReader()
            && resource.data.companyId != null
            && resource.data.companyId == myCompanyId());
      allow create, update, delete: if false;
    }

    // ── MAP PINS ──────────────────────────────────────
    match /pins/{pinId} {
      // Team territory visibility (2026-07-08): a pin carries the creator's
      // companyId (stamped by _savePin). Same-company members read each other's
      // door-knock / customer pins so the whole team sees ONE map — mirrors
      // /reports. sameCompanyAsResource() requires BOTH companyIds non-null, so
      // a solo user (no companyId claim) or a LEGACY pin (no companyId field)
      // falls back to owner-only via isOwner — no cross-tenant leak.
      allow read: if isOwner(resource.data.userId) || isAdmin() || sameCompanyAsResource();
      // Owner or same-company company_admin may edit/remove a pin (an admin
      // curates shared territory); legacy pins (no companyId) stay owner-only
      // because sameCompanyAsResource() denies on the absent field.
      // UPDATE freezes provenance (userId/companyId) — mirrors /leads (line
      // ~198). Without it an owner could updateDoc their pin's companyId to a
      // VICTIM tenant, injecting a spoofed pin into that team's shared map
      // (create pins companyId, but update did not — audit 2026-07-08).
      // notViewer() on the owner branch (decision B, 2026-09-25).
      allow update: if ((isOwner(resource.data.userId) && notViewer()) || isAdmin()
          || (isCompanyAdmin() && sameCompanyAsResource()))
        && didNotChange(['userId', 'companyId']);
      allow delete: if (isOwner(resource.data.userId) && notViewer()) || isAdmin()
        || (isCompanyAdmin() && sameCompanyAsResource());
      // Pin companyId on create (mirrors /leads, /reports, /expenses). Without
      // it a crafted write could inject a pin into another tenant's team-visible
      // map. _savePin stamps companyId = claims.companyId || uid.
      allow create: if isAuth()
        && notViewer()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.companyId is string
        && request.resource.data.companyId.size() > 0
        && (request.resource.data.companyId == myCompanyId()
            || (request.auth.token.get('companyId', '') == ''
                && ownsTenantByUid(request.resource.data.companyId)));
    }

    // ── TERRITORY ZONES (drawn canvassing areas, optionally rep-assigned) ──
    // Persisted + team-shared so a rep's territory survives reload and every
    // teammate sees the same map. Identical shape to /pins: same-company read;
    // owner or same-company admin edits/removes; companyId pinned on create.
    match /zones/{zoneId} {
      allow read: if isOwner(resource.data.userId) || isAdmin() || sameCompanyAsResource();
      // UPDATE freezes provenance so a zone's companyId can't be repointed to a
      // victim tenant's shared map (same fix as /pins — audit 2026-07-08).
      // notViewer() on the owner branch (decision B, 2026-09-25).
      allow update: if ((isOwner(resource.data.userId) && notViewer()) || isAdmin()
          || (isCompanyAdmin() && sameCompanyAsResource()))
        && didNotChange(['userId', 'companyId']);
      allow delete: if (isOwner(resource.data.userId) && notViewer()) || isAdmin()
        || (isCompanyAdmin() && sameCompanyAsResource());
      allow create: if isAuth()
        && notViewer()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.companyId is string
        && request.resource.data.companyId.size() > 0
        && (request.resource.data.companyId == myCompanyId()
            || (request.auth.token.get('companyId', '') == ''
                && ownsTenantByUid(request.resource.data.companyId)));
    }

    // ── UNLINKED DRAWINGS (draw tool, no matching lead) ──
    // saveDrawingToCustomer (maps-routing.js) falls back to this
    // top-level collection (leadId '_unlinked_<uid>') when no lead
    // matches the drawn address; loadDrawingFromCustomer queries it
    // with where(userId == uid) + orderBy(version desc). It had NO
    // rule, so default-deny made every unlinked save AND load
    // permission-denied (NEW-D40a) — the lead-linked path already
    // works via leads/{leadId}/drawings above. Same owner-scope
    // shape as photos / pins.
    //
    // 2026-09-25 (decision B): this block and the owner-only blocks below that
    // shared one `allow read, update, delete` line are split, so the writes
    // can carry notViewer() while read stays exactly as it was.
    match /drawings/{drawingId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow update: if ((isOwner(resource.data.userId) && notViewer()) || isAdmin())
        && ownershipWriteOnce();
      allow delete: if (isOwner(resource.data.userId) && notViewer()) || isAdmin();
      allow create: if isAuth() && notViewer() && request.resource.data.userId == request.auth.uid;
    }

    // ── TASKS ─────────────────────────────────────────
    match /tasks/{taskId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow update: if ((isOwner(resource.data.userId) && notViewer()) || isAdmin())
        && ownershipWriteOnce();
      allow delete: if (isOwner(resource.data.userId) && notViewer()) || isAdmin();
      allow create: if isAuth() && notViewer() && request.resource.data.userId == request.auth.uid;
    }

    // ── COMMUNICATIONS (call / email / SMS log) ───────
    // Written from customer.html when a rep taps call / email / SMS
    // shortcut buttons. Owner scope by userId.
    match /communications/{commId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow update: if ((isOwner(resource.data.userId) && notViewer()) || isAdmin())
        && ownershipWriteOnce();
      allow delete: if (isOwner(resource.data.userId) && notViewer()) || isAdmin();
      allow create: if isAuth() && notViewer() && request.resource.data.userId == request.auth.uid;
    }

    // ── NOTIFICATIONS ─────────────────────────────────
    // No notViewer() here on purpose (decision B, 2026-09-25): these are the
    // caller's own inbox rows. Marking one read or dismissing it is personal
    // UI state, not tenant data, and a viewer needs it to use the bell.
    match /notifications/{notifId} {
      allow read, delete: if isOwner(resource.data.userId) || isAdmin();
      // Update = the owner flipping read/dismissed state. The identity of a
      // notification (who, what kind, which lead, which day, when) never
      // changes after create — which also makes a client setDoc onto an
      // EXISTING deterministic id (crm-snooze.js follow-up ids,
      // followup_<uid>_<lead>_<day>) a refused overwrite: create-only. Before
      // 2026-10-03 the engine used addDoc + a 50-doc in-memory dedupe and
      // wrote 18,169 follow_up docs across 89 leads.
      allow update: if isAdmin() || (isOwner(resource.data.userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['userId', 'type', 'leadId', 'dateKey', 'createdAt']));
      // Creation is server-side (admin SDK). Allow self-create too for client-initiated flows
      // but only if the userId matches the caller, to prevent cross-tenant spam.
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
    }

    // ── EMAILS (sent log) ─────────────────────────────
    // Ownership binds to the IMMUTABLE uid (sentByUid). The token email is a
    // mutable identity key, so it's kept only as a fallback for docs written
    // before sentByUid existed — new writes additionally bind to the uid.
    match /emails/{emailId} {
      // The sentBy-email branch requires a VERIFIED email claim (security
      // batch 2026-10-03): sign-up is open, so an account registered with
      // someone else's address — unverified — read every row that address sent.
      allow read: if isAuth() && (
        resource.data.get('sentByUid', '') == request.auth.uid ||
        (request.auth.token.get('email_verified', false) == true
          && resource.data.sentBy == request.auth.token.email)
      );
      // notViewer(): a sent-mail log row for a lead (decision B, 2026-09-25).
      // sendEmail already refuses a viewer sender server-side.
      allow create: if isAuth() && notViewer() &&
        request.resource.data.sentBy == request.auth.token.email &&
        (!('sentByUid' in request.resource.data) ||
         request.resource.data.sentByUid == request.auth.uid);
    }

    // ── DOCUMENTS ─────────────────────────────────────
    // Split read from the writes 2026-09-25 so they can carry notViewer().
    // Legacy top-level documents ({userId, leadId}). Empty in production as of
    // 2026-09-30, but still writable, so the signed-document lock applies here
    // too (documentIsSigned, §leads documents): once signed, only the share
    // toggle, or an archive by the row's owner, and no client hard delete.
    match /documents/{docId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow update: if ((isOwner(resource.data.userId) && notViewer()) || isAdmin())
        && (!documentIsSigned() || legacySignedDocumentUpdateOk());
      allow delete: if ((isOwner(resource.data.userId) && notViewer()) || isAdmin())
        && !documentIsSigned();
      allow create: if isAuth() && notViewer() && request.resource.data.userId == request.auth.uid;
    }

    // ── NOTES ─────────────────────────────────────────
    // Activity-log notes carry { leadId, userId(author), text, ... }. Read is
    // scoped to the PARENT LEAD, not the note's author, so the lead owner sees
    // teammates' notes on their lead (e.g. a manager's "Stage moved to X") and a
    // same-company member sees the whole timeline — mirrors the subcollection
    // /leads/{id}/notes rule. Before this, read was note-author-only, so a
    // manager-authored stage-change note was invisible in the owner's timeline.
    // A query filtered by leadId lets Firestore evaluate these get()s once.
    // update/delete stay author-only (isOwner(note.userId)).
    match /notes/{noteId} {
      allow read: if isAuth() && (isAdmin()
        || isOwner(get(/databases/$(database)/documents/leads/$(resource.data.leadId)).data.userId)
        || parentLeadInMyCompany(resource.data.leadId));
      // UPDATE: leadId frozen (2026-10-05, no move onto another tenant's
      // lead); userId/companyId write-once (R3-12).
      allow update: if ((isOwner(resource.data.userId) && notViewer()) || isAdmin())
        && ownershipWriteOnce()
        && didNotChange(['leadId']);
      allow delete: if (isOwner(resource.data.userId) && notViewer()) || isAdmin();
      // CREATE must check the PARENT LEAD, not just the author (audit
      // 2026-08-02). Pinning userId alone let ANY authenticated user —
      // no shared company, no role at all — write a note onto someone
      // else's lead, where it renders in that tenant's customer timeline
      // and generated photo reports as though staff had written it.
      // Mirrors the subcollection twin at /leads/{leadId}/notes above:
      // lead owner, or same-company STAFF. isCompanyStaff() deliberately
      // excludes 'viewer', so the read-only role stays read-only here too
      // (it is enforced for /leads at ~line 165 and must not be weaker on
      // the notes that hang off them). Since 2026-09-25 (decision B) that
      // holds on a lead the viewer OWNS too: notViewer() below.
      allow create: if isAuth()
        && notViewer()
        && request.resource.data.userId == request.auth.uid
        && (isAdmin()
            || isOwner(get(/databases/$(database)/documents/leads/$(request.resource.data.leadId)).data.userId)
            || (isCompanyStaff() && parentLeadInMyCompany(request.resource.data.leadId)));
    }

    // ── USER SETTINGS / PROFILE ───────────────────────
    // Profile is self-owned but privileged fields are locked to the server.
    // e2eTestAccount (+ its provisioning stamps) is written only by
    // provisionE2ETestUser and is the gate on cleanupE2ETestData, which
    // deletes Storage objects with the admin SDK; it was client-settable
    // until 2026-10-06 (review R3-2).
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && !request.resource.data.keys().hasAny(['role','plan','accessCode','isAdmin','companyId',
                                                 'e2eTestAccount','provisionedBy','provisionedAt','provisionAction']);
      allow update: if isOwner(uid)
        && didNotChange(['role','plan','accessCode','isAdmin','companyId',
                         'e2eTestAccount','provisionedBy','provisionedAt','provisionAction']);
      allow delete: if isAdmin();

      // ── Template sync subcollections (feat/template-sync) ──
      // job-templates.js write-through-mirrors CUSTOM job templates (plus
      // the single '_usage' rollup doc) at users/{uid}/jobTemplates/{tplId}
      // and hydrates them back at boot; users/{uid}/templates/{tplId} held
      // the retired NBDTemplateSuite mirror (#1017) — kept writable so any
      // legacy docs stay readable. These explicit matches PIN the sync
      // contract (covered by tests/firestore-rules.test.js §29). Since
      // 2026-09-25 the /{subcol}/{docId} wildcard below grants WRITE only to
      // an allowlist that does not repeat these two names, so these matches
      // are now the only write grant template sync has.
      match /jobTemplates/{tplId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
      match /templates/{tplId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      // ── In-person visit recordings (feat/visit-recorder-local-first) ──
      // users/{uid}/visit_captures/{visitId}: the metadata for one recorded
      // visit (docs/pro/js/visit-recorder.js). The AUDIO goes to Storage at
      // audio/{uid}/_inbox/{visitId}.{ext}; this doc points at it.
      //   - OWNER-only read and write (a viewer writes nothing); platform
      //     admin may read.
      //   - A strict field allowlist (vcKeys below). Anything the server
      //     pipeline will later write (transcript, summary, suggested
      //     customer, analysis status) is NOT in it, so a client can never set
      //     a server-owned field. The server writes with the admin SDK.
      //   - leadId is null or a lead the writer may reach (their own, or a
      //     same-tenant lead for company staff): one tenant cannot file a
      //     recording under another tenant's customer.
      //   - audioPath, if present, can only be THIS user's _inbox path for THIS
      //     visit. The server step reads audioPath with admin credentials, so a
      //     client-chosen path would be a read of any object in the bucket.
      //   - startedAtMs is write-once.
      // The users/{uid}/{subcol} wildcard below grants write only to a short
      // allowlist that does not include visit_captures, so this match is the
      // only write grant the collection has.
      // tests/firestore-rules.visit-captures.test.js
      match /visit_captures/{visitId} {
        function vcKeys() {
          return ['startedAtMs', 'endedAtMs', 'durationSec', 'lat', 'lng', 'accuracyM',
                  'mime', 'sizeBytes', 'status', 'leadId', 'source', 'consentMode',
                  'appointmentId', 'audioPath', 'uploadedAtMs', 'chunkCount',
                  'backgroundSec', 'partOf', 'disclosureAckedAtMs', 'recoveredAtMs',
                  'attachedAtMs', 'discardedAtMs', 'createdAtMs'];
        }
        function vcNum(d, k, lo, hi) {
          return d.get(k, null) == null || (d[k] is number && d[k] >= lo && d[k] <= hi);
        }
        function vcStr(d, k, max) {
          return d.get(k, null) == null || (d[k] is string && d[k].size() <= max);
        }
        // The per-field checks, valid for a whole doc that may ALSO carry
        // server-owned fields (PR 2: transcript, notes, suggestions, pipelineStatus,
        // ...). Only create pins the key set; update pins what CHANGED.
        function vcFieldsOk(d) {
          return d.keys().hasAll(['startedAtMs', 'status', 'source', 'consentMode'])
            && visitId.matches('^[A-Za-z0-9_-]{8,64}$')
            && d.startedAtMs is number && d.startedAtMs > 0
            && d.status in ['recording', 'stored', 'uploading', 'uploaded', 'failed', 'discarded']
            && d.source in ['fab', 'appointment', 'customer', 'deeplink']
            && d.consentMode in ['one_party', 'two_party_attested', 'two_party_verbal']
            && vcNum(d, 'endedAtMs', 0, 99999999999999)
            && vcNum(d, 'durationSec', 0, 14400)
            && vcNum(d, 'lat', -90, 90)
            && vcNum(d, 'lng', -180, 180)
            && vcNum(d, 'accuracyM', 0, 1000000)
            && vcNum(d, 'sizeBytes', 0, 209715200)
            && vcNum(d, 'uploadedAtMs', 0, 99999999999999)
            && vcNum(d, 'chunkCount', 0, 100000)
            && vcNum(d, 'backgroundSec', 0, 86400)
            && vcNum(d, 'disclosureAckedAtMs', 0, 99999999999999)
            && vcNum(d, 'recoveredAtMs', 0, 99999999999999)
            && vcNum(d, 'attachedAtMs', 0, 99999999999999)
            && vcNum(d, 'discardedAtMs', 0, 99999999999999)
            && vcNum(d, 'createdAtMs', 0, 99999999999999)
            && vcStr(d, 'mime', 64)
            && (d.get('mime', null) == null || d.mime.matches('^audio/.*'))
            && vcStr(d, 'appointmentId', 128)
            && vcStr(d, 'partOf', 64)
            && (d.get('audioPath', null) == null
                || (d.audioPath is string
                    && d.audioPath.matches('^audio/' + uid + '/_inbox/' + visitId + '\\.(webm|m4a|ogg|mp3|wav)$')));
        }
        function vcShapeOk(d) {
          return d.keys().hasOnly(vcKeys()) && vcFieldsOk(d);
        }
        // An update may change allowlisted keys only. Comparing the CHANGED keys
        // (not the whole doc) is what lets the server's own fields sit on the doc
        // while the phone keeps patching its upload state - and still means a
        // client can never write or alter one of them.
        function vcChangedOk() {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(vcKeys());
        }
        // A leadId containing "/" would be spliced into get(/leads/$(leadId)) as extra path
        // segments (leads/LA/activity/LB), and could pass as "a lead I own" while the
        // server resolved the same string to a different document. Ids only.
        function vcLeadOk(d) {
          return d.get('leadId', null) == null
            || (d.leadId is string && !d.leadId.matches('.*[/].*') && leadReachable(d.leadId));
        }
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) && notViewer()
          && vcShapeOk(request.resource.data)
          && vcLeadOk(request.resource.data);
        allow update: if isOwner(uid) && notViewer()
          && vcChangedOk()
          && vcFieldsOk(request.resource.data)
          && request.resource.data.startedAtMs == resource.data.startedAtMs
          && request.resource.data.consentMode == resource.data.consentMode
          && vcLeadOk(request.resource.data);
        allow delete: if (isOwner(uid) && notViewer()) || isAdmin();
      }

      // 2026-09-25 (invite-claim path check): WRITE is an allowlist of the
      // subcollection names the app writes; READ is unchanged. This wildcard
      // used to grant write on ANY name under the caller's own uid. Several
      // server handlers find docs with collectionGroup(<name>), which matches
      // that name under ANY parent: claimInvite + onRepSignup ('members'), the
      // recording retention cron + adjuster board ('recordings'), AI texting
      // stats ('ai_drafts'). A doc written here under one of those names was
      // read as if the server had written it; for 'members' that meant it was
      // accepted as a team invite. The handlers now also check the parent
      // path themselves (functions/collection-group-paths.js). The list below
      // is every client write under users/{uid}/..., grepped across docs/ and
      // functions/ on 2026-09-25:
      //   captures     quick-capture.js, quick-capture-inbox.js, talk-tank.js
      //   ds_meta      daily-success/ds-firebase-sync.js (streaks doc)
      //   ds_pages     daily-success/ds-firebase-sync.js
      //   ds_workouts  daily-success/ds-firebase-sync.js (Workout Coach sessions)
      //   fcmTokens    push-registration.js
      //   preferences  mobile-nav-customizer.js
      //   settings     ai-texting-persona.js (aiPersona)
      // jobTemplates + templates keep their explicit matches above.
      // notificationLogs is written by the admin SDK only and needs no rule.
      // A NEW client-written subcollection must be added here or its writes
      // are denied; tests/firestore-rules.test.js section 35 pins the list.
      function userWritableSubcollection(name) {
        return name in ['captures', 'ds_meta', 'ds_pages', 'ds_workouts', 'fcmTokens', 'preferences', 'settings'];
      }
      match /{subcol}/{docId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if (isOwner(uid) || isAdmin()) && userWritableSubcollection(subcol);
      }
    }

    // My Skin keeps one entry per theme under mySkin.themes (private
    // per-theme backgrounds, my-skin.js). The live onSnapshot resends the
    // whole doc on every change, so the map is bounded: the client writes at
    // most one entry per theme and there are ~200 themes. A doc with no
    // mySkin, or a mySkin without themes, is unaffected.
    function mySkinThemesBounded(d) {
      return !(d.get('mySkin', null) is map)
        || !(d.mySkin.get('themes', null) is map)
        || d.mySkin.themes.size() <= 220;
    }
    match /userSettings/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if (isOwner(uid) || isAdmin()) && mySkinThemesBounded(request.resource.data);
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ── COMPANY PROFILE ──────────────────────────────────
    // Per-tenant config that drives the editable legal text / financing
    // tiers / marketing copy / code references baked into EVERY generated
    // document (contracts, estimates, invoices). Phase-1 audit fix: the
    // old `companyProfile/main` singleton with `allow read, write: if
    // isAuth()` let any authenticated user of ANY tenant read a tenant's
    // legal/financing config and OVERWRITE it — corrupting the terms in
    // every doc that tenant generates. Now keyed per tenant:
    //   - team members key by their companyId claim
    //   - solo operators key by uid (companyId == uid convention, same as
    //     requireTeamAdmin in functions/handlers/_shared.js). An owner's
    //     uid equals the companyId their invited members carry, so the
    //     whole tenant resolves to one doc while staying isolated from
    //     other tenants.
    // The legacy `companyProfile/main` doc is migrated to the per-tenant
    // key by functions/migrate-companyprofile-per-tenant.js and is no
    // longer client-reachable (its id matches neither branch below).
    match /companyProfile/{companyId} {
      // READ is open to all same-tenant members; WRITE is owner + company_admin
      // only (product decision 2026-07-08). companyProfile drives the legal
      // clauses, financing APRs, pricing and letterhead baked into every
      // generated contract/estimate/invoice — a read-only 'viewer' or sales_rep
      // must not be able to rewrite tenant-wide, money-/law-bearing config.
      // Scope: key by companyId claim, or by uid for solo operators
      // (companyId == uid convention).
      function cpScoped() {
        return isAuth() && (companyId == myCompanyId() || ownsTenantByUid(companyId));
      }
      // Writers: platform admin, the solo owner (doc keyed by their uid), or a
      // company_admin acting inside their own tenant. isCompanyAdmin() implies a
      // role claim (and thus a companyId claim) so myCompanyId() is safe here.
      // notViewer() on the uid branch (decision B, 2026-09-25): a viewer is a
      // member of someone else's tenant, never a solo owner, so the only doc
      // that branch let them write was an orphan companyProfile/{their uid}.
      function cpCanWrite() {
        return isAdmin()
          || (ownsTenantByUid(companyId) && notViewer())
          || (isCompanyAdmin() && companyId == myCompanyId());
      }
      allow read: if cpScoped();
      // create: a client may NOT seed a docPrefix/seal — those come from the
      // reserveCompanyPrefix callable only (both must be absent/null here).
      allow create: if cpCanWrite()
        && brandPrefix(request.resource.data) == null
        && brandSeal(request.resource.data) == null;
      // update: an owner/admin may write anything EXCEPT introducing or changing
      // docPrefix/seal. A deep-merge that doesn't touch them carries the existing
      // value forward (request == resource) and passes; only the admin SDK (which
      // bypasses rules) can actually set/rotate them.
      allow update: if cpCanWrite()
        && brandPrefix(request.resource.data) == brandPrefix(resource.data)
        && brandSeal(request.resource.data) == brandSeal(resource.data);
      // delete: owner/admin only (deleting does NOT release the docPrefixes/{PREFIX}
      // reservation, which is admin-SDK-only, so no prefix-collision abuse).
      allow delete: if cpCanWrite();
    }

    // ── DOC-PREFIX REGISTRY (global customer-ID prefix uniqueness) ─────
    // docPrefixes/{PREFIX} → { companyId } is the authoritative claim that a
    // customer-ID prefix (e.g. 'OAK') belongs to exactly ONE tenant, platform-
    // wide. Prefixes were previously first-come-first-served PER TENANT with no
    // cross-tenant check (onboarding validated only the /^[A-Z0-9]{2,4}$/ shape
    // and reserved the literal 'NBD'), so two self-serve tenants that derived
    // the same seal (deriveSeal is company-name initials) each minted 'OAK-0001'
    // — and the public referral endpoint, which finds a lead by unscoped
    // customerId match, could then drop a friend's lead into the WRONG tenant's
    // CRM. Reservations are written ONLY by the reserveCompanyPrefix callable
    // (admin SDK) inside a transaction that first checks the doc is free; the
    // migration functions/migrate-docprefixes.js seeds the existing tenants.
    // Reads are open to authed users so onboarding can show availability; all
    // writes are denied to clients (admin SDK bypasses rules).
    match /docPrefixes/{prefix} {
      allow read: if isAuth();
      allow write: if false;
    }

    // ── SUBSCRIPTIONS ─────────────────────────────────
    // READ-ONLY for the owner. All writes go through the Stripe webhook or
    // the hardened validateAccessCode Cloud Function (admin SDK).
    match /subscriptions/{uid} {
      // Pillar 4: billing is company-level. The doc is keyed by the OWNER's
      // uid (== the companyId their team carries), so same-company members
      // may READ their company's plan — billing-gate and the dashboard
      // resolve limits from subscriptions/{companyId || uid}. Cross-tenant
      // stays denied (myCompanyId() never equals another owner's uid).
      allow read: if isOwner(uid) || isAdmin()
        || (isAuth() && myCompanyId() == uid);
      allow write: if false;
    }

    // ── STRIPE CONNECT ────────────────────────────────
    // Per-tenant connected-account state. Admin-SDK-only writes
    // (createConnectAccount / getConnectStatus / stripeConnectWebhook), exactly
    // like subscriptions above — this is a MONEY ENTITLEMENT, not a preference.
    //
    // It deliberately does NOT live on companyProfile: that doc is writable by
    // any company_admin, who could then set chargesEnabled:true from devtools
    // and self-authorise online collection with no Stripe account behind it —
    // re-opening the custody hole #1123 closed.
    //
    // READ is same-tenant (not owner-only) on purpose: reps create invoices, so
    // the client capability check has to resolve for a rep too. Reading is
    // safe; writing is the hazard.
    match /connectAccounts/{companyId} {
      allow read: if isAdmin()
        || (isAuth() && (companyId == myCompanyId() || ownsTenantByUid(companyId)));
      allow write: if false;
    }
    // Reverse index acct_… → companyId, used only by the webhook to resolve a
    // tenant. No client ever reads it (it would leak the tenant map).
    match /connectAccountIds/{accountId} {
      allow read, write: if false;
    }

    // ── ACCESS CODES ──────────────────────────────────
    // Admin-SDK-only. Clients can neither read nor write.
    match /access_codes/{codeId} {
      allow read, write: if false;
    }

    // ── LEADERBOARD ───────────────────────────────────
    // Readable within the same company (or admin/owner). Writes are
    // admin-SDK only — counters must come from a Cloud Function that
    // aggregates authoritative data, never from the client. This
    // prevents trivial inflation of closedDeals/revenue from the rep's
    // own session.
    match /leaderboard/{uid} {
      allow read: if isAdmin()
        || isOwner(uid)
        || (isAuth() && myCompanyId() != null && resource.data.companyId == myCompanyId());
      allow write: if false;
    }

    // ── ROOF REP (the sales game, docs/pro/roof-rep.html, 2026-10-03) ──
    // roofRep/{uid}: the rep's own career save. Owner-only.
    // roofRepScores/{uid}: the crew board. Readable by the owner and by
    // members of the SAME company (never another tenant); the owner writes
    // only their own row, stamped with their own companyId (null when the
    // token carries none), and only the board's fields.
    match /roofRep/{uid} {
      allow read, write: if isOwner(uid);
    }
    match /roofRepScores/{uid} {
      allow read: if isOwner(uid)
        || (isAuth() && request.auth.token.get('companyId', null) != null
            && resource.data.companyId == request.auth.token.get('companyId', null));
      allow create, update: if isOwner(uid)
        && request.resource.data.companyId == request.auth.token.get('companyId', null)
        && request.resource.data.keys().hasOnly(['xp', 'level', 'title', 'weekKey', 'weekXp', 'bestDay', 'days', 'cleanDays', 'collected', 'badges', 'avatar', 'name', 'companyId', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40;
      allow delete: if isOwner(uid);
    }

    // ── COUNTERS (atomic ID sequences) ────────────────
    // Used by dashboard.html + customer.html runTransaction calls to mint
    // sequential customer IDs (NBD-####). `customerIds` is the only counter.
    // Phase-1.5 audit (#1.2): writes are now MONOTONIC — create at 1, update
    // by exactly +1 — so a tenant can no longer overwrite/garble another
    // tenant's ID sequence (e.g. set it to 999999). Read stays open because
    // the client mint transaction must read the current value to compute
    // next+1. Residual (accepted P3): the read still leaks the count, and an
    // authed user could advance the counter via repeated +1s — true
    // per-tenant isolation = a per-company ID scheme + server-side
    // allocation, a separate product decision.
    //
    // 2026-10-05 (security review): scoped to the caller's own tenant. The
    // client mint (company-profile.js _custIdMint / _custCounterId) only
    // ever touches two shapes: NBD's legacy shared `customerIds` (minted
    // ONLY when the tenant key IS the NBD owner uid — the platform-identity
    // veto) and `customerIds_<tenantKey lower-cased>` for every other
    // tenant, where tenantKey = the companyId claim, else the solo uid. So
    // a tenant can read and advance its own sequence and no one else's.
    // Platform admin keeps access (support). Server counters
    // (moneyPaper_*, …) are admin-SDK and never reach these rules.
    function myTenantKey() {
      return request.auth.token.get('companyId', '') != ''
        ? request.auth.token.get('companyId', '')
        : (ownsTenantByUid(request.auth.uid) ? request.auth.uid : '');
    }
    function counterIsMine(counterId) {
      return isAuth()
        && ((counterId == 'customerIds' && myTenantKey() == '1phDvAVXHSg82wDLegAbQFq14Ci1')
            || counterId == 'customerIds_' + myTenantKey().lower()
            || isAdmin());
    }
    match /counters/{counterId} {
      allow read:   if counterIsMine(counterId);
      // notViewer() (decision B, 2026-09-25): the mint only runs to stamp a
      // customer id on a lead, which a viewer can neither create nor update.
      allow create: if counterIsMine(counterId) && notViewer() && request.resource.data.next == 1;
      allow update: if counterIsMine(counterId) && notViewer()
        && request.resource.data.next is int
        && request.resource.data.next == resource.data.next + 1;
    }

    // ── API USAGE LOGGING ─────────────────────────────
    // Writes happen via admin SDK (Cloud Function). Reads: own usage or admin.
    match /api_usage/{docId} {
      allow read: if isAuth() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ── API USAGE DAILY COUNTERS (admin-SDK only) ─────
    // M2: materialized per-(day, uid) and per-(day, company) token
    // counters that replace the N-doc range scan on the claudeProxy
    // hot path. Clients see budget headroom only via the 429
    // response — direct reads would be an information-leak surface
    // AND an abuse vector (a client that can read the counter could
    // time-probe it for competitor intel).
    match /api_usage_daily/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── RATE LIMITS (admin-SDK only) ──────────────────
    match /rate_limits/{uid}        { allow read, write: if false; }

    // ── CONFIRMED LEAD-ALERT RECIPIENTS (2026-10-13) ──
    // alertRecipients/{companyId} -> { confirmed: { <addrKey>: {email, ...} } }
    // is the server-side record that an owner confirmed a custom alert address
    // by clicking the one-time link NBD emailed to it. A client must never be
    // able to write it (that would let a tenant "confirm" any inbox) or read
    // the pending tokens. Admin SDK only (functions/alert-recipients*.js).
    match /alertRecipients/{companyId}      { allow read, write: if false; }
    match /alertRecipientTokens/{tokenHash} { allow read, write: if false; }

    // ── MORNING BRIEF STATE (2026-10-18) ──────────────
    // morningBriefState/{companyId} -> { companyId, snapshot: { lists: { <list>:
    // { atMs, ids[] } } } }: the IDS the previous 06:45 brief listed, so delta
    // mode (MORNING_BRIEF_DELTA_ENABLED) can name only what is new. Ids only, no
    // names or contact data. A client that could write it could hide items from
    // the owner's brief; one that could read it learns nothing it can't already
    // see, but there is no reason to allow it. Admin SDK only (morning-brief.js).
    match /morningBriefState/{companyId} { allow read, write: if false; }
    match /_rate_limits_ip/{docId}  { allow read, write: if false; }

    // ── PER-TENANT CATALOG COST BOOK ──────────────────
    // catalogCosts/{companyId} → { costs: { [productId]: { cost: {good,
    // better,best}, labor: {…} } },
    //                              jtCosts: { [jt-<slug>-<index>]:
    //                                { materialCost, laborCost } } }
    // — every tenant's OWN wholesale cost and labor/margin model.
    //
    // This data used to ship inside docs/pro/js/product-data.js, which
    // hosting serves unauthenticated from a public repo: one company's
    // buy prices were published to the internet AND handed to every other
    // tenant as their seed. Costs are now tenant-owned and never leave
    // the tenant — there is no platform-wide copy to leak or distribute.
    //
    // READ is open to same-tenant members (a rep needs the margin readout
    // in the Product Library); WRITE is owner + company_admin only. That
    // is deliberately the same split companyProfile uses (product decision
    // 2026-07-08): the cost book is tenant-wide, money-bearing config, so
    // a viewer or sales_rep must not be able to rewrite it for everyone.
    // A rep's own edits still land in their local product store; they just
    // don't propagate. Scope key: companyId claim, or uid for solo
    // operators (the companyId == uid convention).
    //
    // `jtCosts` (2026-08-18) is the SAME class of data from a second
    // subsystem: the 84 job-template custom line items that used to ship
    // materialCost/laborCost inside the public docs/pro/js/
    // job-templates-data.js. It rides this document deliberately — the rule
    // below already governs every field of it, so that migration needed NO
    // rules change, and a rules typo is the failure mode that locks a live
    // tenant out of their own money data. Do not split it out.
    //
    // Note the scoping split it introduces, because it is not accidental:
    // template DEFINITIONS stay uid-scoped (users/{uid}/jobTemplates, above)
    // because a fork is one rep's working copy, while template COSTS are
    // company-scoped here because a buy price is tenant-wide, money-bearing
    // pricing policy a sales_rep must not rewrite for everyone. Two reps who
    // each forked the same default template therefore share ONE cost entry,
    // keyed jt-<slug(templateId)>-<index>. That is correct — a company has one
    // buy price for "Masonry water repellent" — and it is a behaviour change
    // from the per-device drift that preceded it.
    match /catalogCosts/{companyId} {
      allow read: if isAuth() && (companyId == myCompanyId() || ownsTenantByUid(companyId));
      // notViewer() on the uid branch: same orphan-doc reason as cpCanWrite().
      allow write: if isAdmin()
        || (ownsTenantByUid(companyId) && notViewer())
        || (isCompanyAdmin() && companyId == myCompanyId());
    }

    // The company's Product Library (product-library.js, 2026-09-29): its
    // custom / edited / archived products and tombstones, WITHOUT costs (those
    // stay in catalogCosts above). It lived only in per-device localStorage,
    // which every sign-out purges. Jo: one company-wide library, the owner and
    // company admins edit, everyone in the company reads. Identical access to
    // catalogCosts on purpose — same tenant, same editors.
    // The company's price book (price-book.js, 2026-10-02): what it actually
    // paid per store SKU, learned from receipts (Home Depot import) and later
    // manual entries. COST data, so the same tenant scoping and the same
    // owner / company_admin write split as catalogCosts — a sales_rep reads
    // it (the materials list shows last-paid prices) but cannot rewrite it.
    match /priceBook/{companyId} {
      allow read: if isAuth() && (companyId == myCompanyId() || ownsTenantByUid(companyId));
      allow write: if isAdmin()
        || (ownsTenantByUid(companyId) && notViewer())
        || (isCompanyAdmin() && companyId == myCompanyId());
    }

    // Job-name memory (hd-import.js, receipt sorter 2026-10-18): which lead a
    // PO/Job name on a Home Depot / Lowe's receipt means, learned from the
    // company's own past assignments. One doc per company: any non-viewer
    // member of the tenant reads and writes it (whoever sorts the receipts);
    // a viewer can read nothing here and write nothing; another tenant sees
    // nothing. Bounded: only these keys, at most 2000 entries.
    match /companyAliases/{companyId} {
      allow read: if isAuth() && notViewer() && (companyId == myCompanyId() || ownsTenantByUid(companyId));
      allow create, update: if isAuth() && notViewer()
        && (companyId == myCompanyId() || ownsTenantByUid(companyId))
        && request.resource.data.keys().hasOnly(['aliases', 'updatedAt', 'updatedBy'])
        && request.resource.data.aliases is map
        && request.resource.data.aliases.size() <= 2000
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Agent inbox (2026-10-02): what the Grok Bot team FILES through the NBD
    // CRM connection — notes, reminders, reports — for the owner to review.
    // Items are created server-side only (the connection's function, admin
    // SDK). The owner / company_admin reads them and may only DECIDE: flip a
    // pending item to approved / dismissed, stamp who and when, and edit the
    // text before approving. Nothing else on the item can change, and a
    // decided item stays decided.
    // Bot keys (hashed) and the bot audit trail — server only (agent-mcp.js).
    match /agent_keys/{keyId}   { allow read, write: if false; }
    // Social Studio media index (key → social-media/ Storage path of a
    // re-encoded copy). Server only: functions/social-studio.js.
    match /social_media/{key}   { allow read, write: if false; }
    match /agent_audit/{auditId} { allow read, write: if false; }
    // A company's own bots and its bot settings (on/off switch, house rules)
    // — server only, managed through the Bots & API callables (2026-10-04).
    match /agent_bots/{botId}       { allow read, write: if false; }
    match /agent_settings/{companyId} { allow read, write: if false; }

    match /agent_inbox/{itemId} {
      allow read: if isAdmin()
        || (ownsTenantByUid(resource.data.companyId) && notViewer())
        || (isCompanyAdmin() && resource.data.companyId == myCompanyId());
      allow update: if (isAdmin()
          || (ownsTenantByUid(resource.data.companyId) && notViewer())
          || (isCompanyAdmin() && resource.data.companyId == myCompanyId()))
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'dismissed']
        && request.resource.data.decidedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'decidedBy', 'result', 'text']);
      allow create, delete: if false;
    }

    // ── AWAY MODE + BACKUP PERSON (never-forget lane, 2026-10-12) ──────────
    // Design + security model: documentation/projects/AWAY-MODE-BACKUP-2026-10-12.md.
    // Every write is the Admin SDK's (the manageAway callable and the
    // awayModeTick) — no client may name a backup, fake consent or approve
    // customer wording, so there is NO client write path here.
    //
    //   away_mode/{companyId}     status only (away window, backup first name +
    //                             state, "wording approved", pending hand-back
    //                             count). No phone, email or customer data, so
    //                             any member of the company may read it — the
    //                             Today status line needs it. Viewers too.
    //   away_private/{companyId}  config incl. an external backup's contact and
    //                             the wording draft: never client-readable;
    //                             manageAway returns it to the owner only.
    //   away_windows/{id}         per-window ledger naming customers + numbers
    //                             (id = companyId__windowId). Owner or the
    //                             company's company_admin only. The BACKUP gets
    //                             no read here: they are served a minimal packet
    //                             by manageAway backupList.
    match /away_mode/{companyId} {
      allow read: if isAdmin()
        || ownsTenantByUid(companyId)
        || (isAuth() && request.auth.token.get('companyId', '') == companyId);
      allow write: if false;
    }
    match /away_private/{companyId} {
      allow read, write: if false;
    }
    match /away_windows/{windowKey} {
      allow read: if isAdmin()
        || (isAuth() && notViewer() && ownsTenantByUid(resource.data.companyId))
        || (isCompanyAdmin() && resource.data.companyId == myCompanyId());
      allow write: if false;
    }

    match /productLibrary/{companyId} {
      allow read: if isAuth() && (companyId == myCompanyId() || ownsTenantByUid(companyId));
      allow write: if isAdmin()
        || (ownsTenantByUid(companyId) && notViewer())
        || (isCompanyAdmin() && companyId == myCompanyId());
    }

    // ── PHOTO VISION COST METERS (admin-SDK writes) ──
    // Owner can read their own meters so the client knows when caps
    // are approaching ("$8.40 of $10 used on this lead"). Writes are
    // funnel-locked: only analyzePhotoVision (admin SDK) increments.
    match /leadCostMeter/{leadId} {
      allow read: if isAuth() && resource.data.ownerUid == request.auth.uid;
      allow write: if false;
    }
    match /userCostMeter/{docId} {
      // Doc id is "{uid}__{YYYY-MM}". Owner can read any of their
      // months. Useful for "you've used $32/$50 this month" UI.
      allow read: if isAuth() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Vision response cache (admin-SDK only — sha256(imageUrl) → suggestion).
    // Clients never touch this directly; the function reads/writes.
    match /visionCache/{cacheKey} {
      allow read, write: if false;
    }

    // ── CUSTOMER AUDIT EVENTS (Batch 7) ──────────────────
    // Server-stamped log of what the homeowner did on the portal —
    // portal_open, photo_view, estimate_view, etc. The rep reads them
    // on customer.html; writes are admin-SDK-only (recordCustomerEvent
    // validates the portal token before writing).
    match /customerAuditEvents/{eventId} {
      allow read:  if isOwner(resource.data.ownerUid) || isAdmin();
      allow write: if false;
    }

    // ── DAILY SUCCESS ─────────────────────────────────
    match /daily_entries/{uid}/entries/{entryId} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    // ── DAILY TRACKER ────────────────────────────────
    match /dailyTracker/{docId} {
      allow read, delete: if isOwner(resource.data.userId) || isAdmin();
      allow update: if (isOwner(resource.data.userId) || isAdmin()) && ownershipWriteOnce();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
    }

    // ── D2D KNOCKS ────────────────────────────────────
    match /knocks/{knockId} {
      // isCompanyStaff(), not isManager(): company_admin IS the tenant owner
      // and is strictly more privileged everywhere else in this file. Gating
      // team reads on manager alone locked the owner out of their own team's
      // knocks — the D2D Team panel rendered empty, indistinguishable from
      // "nobody is knocking today" (audit 2026-08-02).
      allow read: if isAdmin()
        || isOwner(resource.data.userId)
        || (isCompanyStaff() && sameCompanyAsResource());
      // Phase-1.5: companyId, if present, must be the caller's own tenant —
      // a rep can't tag a knock with another company's id (which would make
      // it readable by that company's managers). Presence not required so a
      // missed client path degrades to owner-only, never cross-tenant.
      // notViewer() on every write (decision B, 2026-09-25): a knock is a
      // customer's address and outcome on the team map, not personal state.
      allow create: if isAuth() && notViewer() && request.resource.data.userId == request.auth.uid
        && (!('companyId' in request.resource.data)
            || request.resource.data.companyId == myCompanyId()
            || (request.auth.token.get('companyId', '') == ''
                && ownsTenantByUid(request.resource.data.companyId)));
      // Provenance frozen on update — see /photos above. Without this an
      // owner re-stamps their own knock into a victim tenant's live D2D map.
      allow update: if ((isOwner(resource.data.userId) && notViewer()) || isAdmin())
        && didNotChange(['userId', 'companyId']);
      allow delete: if (isOwner(resource.data.userId) && notViewer()) || isAdmin();
    }

    // ── REPS (team member profiles) ──────────────────
    // Reads scoped to same company or admin. Never globally enumerable.
    match /reps/{repId} {
      allow read: if isAdmin()
        || isOwner(repId)
        || (isAuth() && myCompanyId() != null && resource.data.companyId == myCompanyId());
      allow create: if isOwner(repId)
        && !request.resource.data.keys().hasAny(['role','isAdmin'])
        // Phase-1.5: companyId, if present, must be the caller's own tenant.
        && (!('companyId' in request.resource.data)
            || request.resource.data.companyId == myCompanyId()
            || (request.auth.token.get('companyId', '') == ''
                && ownsTenantByUid(request.resource.data.companyId)));
      allow update: if (isOwner(repId) && didNotChange(['role','isAdmin','companyId']))
        || isAdmin();
      allow delete: if isAdmin();
    }

    // ── TERRITORIES ──────────────────────────────────
    match /territories/{territoryId} {
      allow read: if isAdmin()
        || isOwner(resource.data.userId)
        || (isAuth() && myCompanyId() != null && resource.data.companyId == myCompanyId());
      // Phase-1.5: companyId, if present, must be the caller's own tenant.
      // notViewer() on every write (decision B, 2026-09-25).
      allow create: if isAuth() && notViewer() && request.resource.data.userId == request.auth.uid
        && (!('companyId' in request.resource.data)
            || request.resource.data.companyId == myCompanyId()
            || (request.auth.token.get('companyId', '') == ''
                && ownsTenantByUid(request.resource.data.companyId)));
      // Provenance frozen on update — see /photos above. A territory
      // re-stamped into a victim tenant draws a polygon on their live map.
      allow update: if ((isOwner(resource.data.userId) && notViewer()) || isAdmin())
        && didNotChange(['userId', 'companyId']);
      allow delete: if (isOwner(resource.data.userId) && notViewer()) || isAdmin();
    }

    // ── D2D DOOR LISTS (2026-10-16) ───────────────────
    // Imported address lists (js/d2d-door-import.js): an aging-roof list or any
    // CSV of doors, shown as walkable routes in the D2D tracker. Addresses and
    // roof-age estimates only — the importer never stores a person's name,
    // phone or email (the keys below are the whole allowlist).
    // Read: the importer, their company's owner / managers (same company), and
    // the teammate it is assigned to (same company). Write: the importer only,
    // never a viewer; companyId must be the importer's own tenant and is frozen.
    // tests/firestore-rules.d2d-doorlists.test.js.
    function doorListShapeOk(d) {
      return d.keys().hasOnly(['userId', 'companyId', 'assignedTo', 'name', 'source', 'createdAt', 'rowCount', 'doors', 'notes'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && (!('source' in d) || (d.source is string && d.source.size() <= 120))
        && d.doors is list && d.doors.size() <= 1500
        && (!('notes' in d) || (d.notes is list && d.notes.size() <= 40))
        && (!('rowCount' in d) || (d.rowCount is int && d.rowCount >= 0 && d.rowCount <= 1500))
        && (!('assignedTo' in d) || d.assignedTo == null || (d.assignedTo is string && d.assignedTo.size() <= 128));
    }
    match /d2d_doorlists/{listId} {
      allow read: if isAdmin()
        || isOwner(resource.data.userId)
        || (isCompanyStaff() && sameCompanyAsResource())
        || (isAuth() && resource.data.get('assignedTo', null) == request.auth.uid && sameCompanyAsResource());
      allow create: if isAuth() && notViewer() && request.resource.data.userId == request.auth.uid
        && request.resource.data.companyId is string
        && (request.resource.data.companyId == myCompanyId()
            || (request.auth.token.get('companyId', '') == ''
                && ownsTenantByUid(request.resource.data.companyId)))
        && doorListShapeOk(request.resource.data);
      allow update: if isOwner(resource.data.userId) && notViewer()
        && didNotChange(['userId', 'companyId'])
        && doorListShapeOk(request.resource.data);
      allow delete: if (isOwner(resource.data.userId) && notViewer()) || isAdmin();
    }

    // ── CANVASSERS (2026-10-16) ───────────────────────
    // Canvasser mode (js/canvasser-ui.js): the company owner marks a Sales Rep
    // teammate as a commission-only canvasser with a commission %. Doc id =
    // <companyId>__<uid>. Written ONLY by the company owner (company_admin of
    // that company, or a solo owner whose uid is the company); read by the
    // company's owner / managers and by the rep it names. A rep can never set
    // their own %. Tracking only: nothing here pays anyone.
    // tests/firestore-rules.canvassers.test.js.
    function canvasserOwner(cid) {
      return isAdmin()
        || (isCompanyAdmin() && myCompanyId() == cid)
        || (request.auth.token.get('companyId', '') == '' && ownsTenantByUid(cid))
        || (request.auth.token.get('role', '') == '' && ownsTenantByUid(cid));
    }
    function canvasserShapeOk(d, docId) {
      return d.keys().hasOnly(['companyId', 'uid', 'name', 'pct', 'active', 'updatedBy', 'updatedAt'])
        && d.companyId is string && d.uid is string && docId == d.companyId + '__' + d.uid
        && d.pct is number && d.pct >= 0 && d.pct <= 50
        && (!('name' in d) || (d.name is string && d.name.size() <= 80))
        && (!('active' in d) || d.active is bool)
        && d.updatedBy == request.auth.uid;
    }
    match /canvassers/{docId} {
      allow read: if isAdmin()
        || (isAuth() && resource.data.uid == request.auth.uid)
        || (isCompanyStaff() && sameCompanyAsResource())
        || canvasserOwner(resource.data.companyId);
      allow create: if canvasserOwner(request.resource.data.companyId) && canvasserShapeOk(request.resource.data, docId);
      allow update: if canvasserOwner(resource.data.companyId)
        && didNotChange(['companyId', 'uid'])
        && canvasserShapeOk(request.resource.data, docId);
      allow delete: if canvasserOwner(resource.data.companyId);
    }

    // ── CANVASS CHECKS (2026-10-16) ───────────────────
    // The rep's pre-knock checklist for one town on one day: permit, ID badge,
    // cancel notice at signing, knocking hours. Created by the rep for
    // themselves in their own company with every item ticked; never edited
    // (a record of what was confirmed). Read by the rep and their company's
    // owner / managers. tests/firestore-rules.canvassers.test.js.
    match /canvass_checks/{checkId} {
      allow read: if isAdmin()
        || isOwner(resource.data.userId)
        || (isCompanyStaff() && sameCompanyAsResource())
        || canvasserOwner(resource.data.companyId);
      allow create: if isAuth() && notViewer()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.companyId is string
        && (request.resource.data.companyId == myCompanyId()
            || (request.auth.token.get('companyId', '') == ''
                && ownsTenantByUid(request.resource.data.companyId)))
        && request.resource.data.keys().hasOnly(['userId', 'companyId', 'ymd', 'townId', 'town', 'items', 'hours', 'createdAt'])
        && request.resource.data.ymd is string && request.resource.data.ymd.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.town is string && request.resource.data.town.size() <= 80
        && request.resource.data.townId is string && request.resource.data.townId.size() <= 60
        && (!('hours' in request.resource.data) || (request.resource.data.hours is string && request.resource.data.hours.size() <= 120))
        && request.resource.data.items.keys().hasOnly(['permit', 'badge', 'cancelNotice', 'quietHours'])
        && request.resource.data.items.permit == true && request.resource.data.items.badge == true
        && request.resource.data.items.cancelNotice == true && request.resource.data.items.quietHours == true;
      allow update: if false;
      allow delete: if isAdmin() || canvasserOwner(resource.data.companyId);
    }

    // ── PRODUCTS ──────────────────────────────────────
    // Read split from the writes 2026-09-25 so they can carry notViewer().
    match /products/{productId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow update: if ((isOwner(resource.data.userId) && notViewer()) || isAdmin())
        && ownershipWriteOnce();
      allow delete: if (isOwner(resource.data.userId) && notViewer()) || isAdmin();
      allow create: if isAuth() && notViewer() && request.resource.data.userId == request.auth.uid;
    }

    // ── ML TRAINING DATA (roof edge detection) ────────
    // Audit A: maps.js draw flow writes labeled training pairs (auto-
    // detected polygon + user-corrected polygon) here. Previously had
    // NO rule so default-deny silently 403'd every save — every
    // training pair was lost. Same owner-scope pattern as photos /
    // pins: userId on the doc, create requires self-stamp, read locked
    // to owner + platform admin (training-data is sensitive aerial
    // imagery metadata; should never leak cross-tenant).
    match /ml_training_data/{docId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      // notViewer(): a pair is written when a drawing is SAVED (decision B).
      allow create: if isAuth() && notViewer() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();  // training data is append-only from the rep's perspective
    }

    // ── TEMPLATES ─────────────────────────────────────
    // Read split from the writes 2026-09-25 so they can carry notViewer().
    // (A user's own template forks live at users/{uid}/templates and
    // users/{uid}/jobTemplates, which stay writable for everyone.)
    match /templates/{templateId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow update: if ((isOwner(resource.data.userId) && notViewer()) || isAdmin())
        && ownershipWriteOnce();
      allow delete: if (isOwner(resource.data.userId) && notViewer()) || isAdmin();
      allow create: if isAuth() && notViewer() && request.resource.data.userId == request.auth.uid;
    }

    // ── COMPANIES ─────────────────────────────────────
    match /companies/{companyId} {
      // Readable by members of that company, the owner, or admin.
      allow read: if isAdmin()
        || (isAuth() && resource.data.ownerId == request.auth.uid)
        || (isAuth() && myCompanyId() == companyId);
      // Pin the doc id to the caller's uid: no legitimate client path creates
      // company docs (registration provisions via the createCompany callable /
      // admin SDK), and an unpinned create let anyone squat companies/{ANY-uid}
      // as long as they stamped ownerId=self — locking out a legacy owner from
      // team management and exposing that tenant's members subcollection.
      // `plan` (entitlement) + `ownerId` (provenance) are admin-SDK-only — the
      // Stripe webhook sets plan, provisioning sets ownerId. Freezing them on
      // UPDATE (below) stops a free-tier owner from client-writing
      // plan:'enterprise' on their own doc to defeat the team-seat gate
      // (createTeamInvite/assignSeats trust companies.plan). That freeze alone
      // is not enough: it never touches CREATE, and createCompany's own
      // idempotency check (existing.exists) only re-validates ownerId, never
      // plan, on a re-call — so an owner could squat companies/{own-uid} with
      // plan:'enterprise' at document CREATION and keep it forever. Require
      // plan to be absent or 'free' at create too, matching the only shape the
      // admin SDK ever writes there (createCompany always seeds plan:'free').
      // notViewer() (decision B, 2026-09-25): a viewer belongs to another
      // tenant, so a companies/{their uid} doc could only be a squat.
      // Public-site publication (2026-10-04): `status` and `sitePublished` /
      // `sitePublishedAt` decide whether /sites/t/<id> serves a page on Jo's
      // domain (functions/handlers/public-site.js isPublishedCompany). Only the
      // admin SDK writes them — createCompany / setSiteSlug (status, and
      // sitePublished:false) and the owner's publishTenantSite callable (which
      // checks name + phone + service area first). A client create carrying
      // any of them, or an update that changes one, would be a self-publish.
      allow create: if isAuth() && notViewer()
        && companyId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && (!('plan' in request.resource.data) || request.resource.data.plan == 'free')
        && !request.resource.data.keys().hasAny(['status', 'sitePublished', 'sitePublishedAt',
                                                 'previousOwnerId', 'ownershipTransferredAt', 'ownershipTransferredBy']);
      allow update: if ((isAuth() && notViewer() && resource.data.ownerId == request.auth.uid)
            && didNotChange(['plan', 'ownerId', 'status', 'sitePublished', 'sitePublishedAt',
                             'previousOwnerId', 'ownershipTransferredAt', 'ownershipTransferredBy'])) || isAdmin();
      // A company that has been handed off (transferCompanyOwnership) is not
      // client-deletable: with the doc gone, ownsTenantByUid() would see "no
      // company doc" and hand the uid-keyed tenant back to the former owner.
      allow delete: if (isAuth() && notViewer() && resource.data.ownerId == request.auth.uid
                        && !('previousOwnerId' in resource.data)) || isAdmin();

      // Members subcollection is writable only by the company owner or admin.
      // QA 2026-06-21 #10: the live app queries /companies/{_user.uid}/members,
      // so companyId == the caller's own uid. The ownerId-doc check below FAILS
      // for solo owners who never had a /companies/{uid} doc created (get() of a
      // missing doc denies), so loadTeamMembers/invite were PERMISSION_DENIED.
      // Allow the company-keyed-by-uid owner directly — they can only ever reach
      // the members subcollection under their OWN uid, so this is tenant-safe.
      // My Skin company background set (2026-10, spec section 18):
      // companies/{companyId}/skin/config is the ONE doc members listen to.
      // Members of the company read it; the company admin (or the solo owner
      // of a company of one, or the platform admin) writes it. usage and
      // usageUpdatedAt belong to functions/skin-quota.js (admin SDK) and a
      // client write may not touch them. The per-theme map is bounded like a
      // member's own (220). A viewer never writes.
      match /skin/{docId} {
        allow read: if isAdmin() || (isAuth() && (myCompanyId() == companyId || ownsTenantByUid(companyId)));
        allow create, update: if docId == 'config' && notViewer()
          && (isAdmin()
              || (isCompanyAdmin() && myCompanyId() == companyId)
              || ownsTenantByUid(companyId))
          && !request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys().hasAny(['usage', 'usageUpdatedAt'])
          && request.resource.data.get('themes', {}).size() <= 220;
        allow delete: if false;
      }

      match /members/{memberId} {
        // Same-company claim read (4th grant): the Team tab resolves its
        // tenant key from claims.companyId precisely so non-owner
        // company_admins/managers work, but without this grant every
        // non-owner got PERMISSION_DENIED and a silently empty roster
        // (gauntlet gap). Note the old `request.auth.uid == memberId`
        // grant was DEAD CODE — member docs are keyed by EMAIL, so a uid
        // never matches; the claim grant also covers reading your own row.
        allow read: if isAdmin()
          || ownsTenantByUid(companyId)
          || (isAuth() && get(/databases/$(database)/documents/companies/$(companyId)).data.ownerId == request.auth.uid)
          || (isAuth() && request.auth.token.companyId == companyId);
        // CREATE/UPDATE/DELETE are all server-mediated now — clients never
        // write member docs:
        //   - create → createTeamInvite (Pillar 4: enforces plan seat limits)
        //   - update → deactivateUser (disable/enable + status)
        //   - delete → removeMember (strips the member's companyId/role claims
        //     and revokes tokens BEFORE deleting; a bare client deleteDoc left
        //     a removed user with a live companyId claim and full tenant access,
        //     since Firestore authorizes by claim, not roster membership).
        // Admin-SDK callables bypass rules; platform admins keep client access.
        allow create, update, delete: if isAdmin();
      }

      // Owner-only business numbers (2026-10-04, "knowing your numbers"):
      // monthly lead spend per paid source (lead_spend), the Sunday review's
      // weekly "one decision" notes (week_<date>), and the server-counted
      // referral-link opens (referral_clicks_<YYYY-MM>, written by the admin
      // SDK only). Spend and cost-per-lead are cost figures — CRM-only, and
      // only the company OWNER sees them: not managers, not reps, not
      // viewers. The owner of a tenant is the uid the company is keyed by, or
      // the uid the company doc names as ownerId. referral_clicks_* is
      // server-written; a client can never create or edit one.
      match /owner_numbers/{docId} {
        allow read: if isAdmin()
          || ownsTenantByUid(companyId)
          || (isAuth() && get(/databases/$(database)/documents/companies/$(companyId)).data.ownerId == request.auth.uid);
        allow create, update: if isAdmin()
          || (isAuth() && notViewer() && !docId.matches('referral_clicks_.*')
              && (ownsTenantByUid(companyId)
                  || get(/databases/$(database)/documents/companies/$(companyId)).data.ownerId == request.auth.uid));
        allow delete: if isAdmin();
      }
      // ── SOCIAL STUDIO (2026-10-04) ───────────────────────────────────
      // companies/{companyId}/social_posts — every post (caption, media keys,
      // schedule, result URL) lives here, exportable from Social Studio.
      // Owner + company_admin only (same editors as priceBook/catalogCosts);
      // viewers, managers and reps neither read nor write.
      //
      // The publish lifecycle is server-owned: only the socialApprovePost
      // callable (which re-runs the privacy + Kentucky caption filter) can
      // move a DRAFT to approved/scheduled, and only the publisher writes
      // publish/approvedAt/platformPostId. A client may: create a draft,
      // edit a post (any content edit sends it back to 'draft'), reschedule
      // an approved/scheduled/ready post, cancel, or mark a post posted
      // with its URL (the manual "Ready to post" queue). A post the
      // publisher holds ('publishing') is untouchable.
      function socialManager() {
        return isAdmin()
          || (ownsTenantByUid(companyId) && notViewer())
          || (isCompanyAdmin() && companyId == myCompanyId());
      }
      function socialContentChanged() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['caption', 'hashtags', 'media', 'platform', 'kind', 'format', 'video']);
      }
      // Reel Studio (2026-10-04): an AI-made image never sits on a job
      // showcase (aiGenerated is server-set and frozen; this stops a client
      // re-kinding an AI post into a showcase). The callables + publisher
      // enforce the same rule on the media themselves.
      function socialAiRuleOk() {
        return !(request.resource.data.get('aiGenerated', false) == true
          && request.resource.data.get('kind', '') == 'job_showcase');
      }
      function socialStatusOk() {
        let before = resource.data.status;
        let after = request.resource.data.status;
        return (!socialContentChanged() || after == 'draft')
          && (before != 'posted' || after == 'posted')
          && (after != 'scheduled' || request.resource.data.scheduledAt is timestamp)
          && (after == before
            || (after == 'draft' && before in ['draft', 'approved', 'scheduled', 'failed', 'ready', 'cancelled'])
            || (after == 'cancelled' && before in ['draft', 'approved', 'scheduled', 'failed', 'ready'])
            || (after in ['approved', 'scheduled'] && before in ['approved', 'scheduled', 'ready'])
            || (after == 'posted' && before in ['approved', 'scheduled', 'ready', 'failed']
                && request.resource.data.postUrl is string && request.resource.data.postUrl.size() > 0));
      }
      match /social_posts/{postId} {
        allow read: if socialManager();
        allow create: if socialManager()
          && request.resource.data.companyId == companyId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.status == 'draft'
          && !request.resource.data.keys().hasAny(['approvedAt', 'approvedBy', 'publish', 'platformPostId', 'sourceLeadId', 'reelId', 'video', 'aiGenerated']);
        allow update: if socialManager()
          && resource.data.status != 'publishing'
          && didNotChange(['companyId', 'createdBy', 'approvedAt', 'approvedBy', 'publish', 'platformPostId', 'sourceLeadId', 'groupId', 'captionFilter', 'reelId', 'video', 'aiGenerated'])
          && socialAiRuleOk()
          && socialStatusOk();
        allow delete: if socialManager() && resource.data.status != 'publishing';
      }
      // Reel Studio (2026-10-04): reels, their uploaded clips / AI graphics,
      // and the daily render counter. Server-only writes (functions/
      // reel-studio.js callables + the render worker); owner + company_admin
      // read them to drive the Reels tab.
      match /reels/{reelId}        { allow read: if socialManager(); allow write: if false; }
      match /reel_media/{mediaId}  { allow read: if socialManager(); allow write: if false; }
      match /reel_usage/{dayId}    { allow read: if socialManager(); allow write: if false; }
      // On/off switches: { enabled: bool, platforms: { facebook: bool, … } }.
      match /social_settings/{docId} {
        allow read, write: if socialManager();
      }

      // ── LAYOUT DEFAULT / LOCK (2026-10-11, layout system D2) ──
      // companies/{companyId}/settings/layout — { defaultLayout, defaultByDevice,
      // allowed, locked, defaultWidgets }. The admin's starting layout for the
      // team, which layouts members may pick, and whether the choice is theirs
      // at all. Same readers as the sub roster (the whole tenant: the engine
      // reads it at boot to resolve a layout); written by the solo owner or a
      // company_admin of that company — not a manager, rep or viewer, not
      // another tenant. Precedence lives client-side (layout-system.js
      // resolve()): locked company layout > user choice > company default >
      // Classic; a rule can't enforce a UI lock, it can only make sure nobody
      // but an admin can set or lift one. Only the doc id `layout` exists.
      // defaultWidgets (D5, 2026-10-12) holds a layout's starting arrangement,
      // { bento: [ {widgetId,x,y,w,h}, ... ] } = the Bento Board new hires get;
      // bounded to 8 layouts and 24 tiles so a settings doc stays small.
      function layoutDocOk() {
        let d = request.resource.data;
        return d.keys().hasOnly(['defaultLayout', 'defaultByDevice', 'allowed', 'locked', 'defaultWidgets', 'updatedAt', 'updatedBy'])
          && (!('defaultLayout' in d) || d.defaultLayout == null
              || (d.defaultLayout is string && d.defaultLayout.size() <= 32 && d.defaultLayout.matches('^[a-z][a-z0-9-]*$')))
          && (!('defaultByDevice' in d) || (d.defaultByDevice is map
              && d.defaultByDevice.keys().hasOnly(['phone', 'tablet', 'desktop'])))
          && (!('allowed' in d) || d.allowed == null || (d.allowed is list && d.allowed.size() <= 40))
          && (!('locked' in d) || d.locked is bool)
          && (!('defaultWidgets' in d) || (d.defaultWidgets is map && d.defaultWidgets.size() <= 8
              && (!('bento' in d.defaultWidgets)
                  || (d.defaultWidgets.bento is list && d.defaultWidgets.bento.size() <= 24))))
          && (!('updatedBy' in d) || d.updatedBy == request.auth.uid);
      }
      match /settings/layout {
        allow read: if isAdmin()
          || ownsTenantByUid(companyId)
          || (isAuth() && request.auth.token.get('companyId', '') == companyId);
        allow create, update: if isAuth() && notViewer() && layoutDocOk()
          && (ownsTenantByUid(companyId)
              || (isCompanyAdmin() && request.auth.token.get('companyId', '') == companyId));
        allow delete: if isAuth() && notViewer()
          && (ownsTenantByUid(companyId)
              || (isCompanyAdmin() && request.auth.token.get('companyId', '') == companyId));
      }

      // ── LAYOUT USAGE (2026-10-16, layouts idea #13) ──
      // companies/{companyId}/layoutUsage/{YYYY-MM-DD} = { <layoutId>: n }: how many
      // devices had each layout on screen that day. ANONYMOUS: only known layout
      // ids with a whole-number count, no uid, no name. A member of the company
      // (not a viewer) may add exactly ONE to exactly ONE layout per write
      // (js/layout-usage.js uses increment(1)); nobody can set, lower or reset a
      // count, add another key, or delete the day. Only the owner or a
      // company_admin (and platform admins) can read it.
      function layoutUsageIds() { return ['classic', 'field', 'focus', 'mission', 'bento', 'crew', 'island', 'inbox']; }
      function layoutUsageMember() {
        return isAuth() && notViewer()
          && (ownsTenantByUid(companyId) || request.auth.token.get('companyId', '') == companyId);
      }
      function layoutUsageStep(id) {
        let before = resource == null ? 0 : resource.data.get(id, 0);
        let after = request.resource.data.get(id, 0);
        return after is int && (after == before || after == before + 1);
      }
      function layoutUsageOk() {
        let d = request.resource.data;
        let changed = resource == null ? d.keys().toSet() : d.diff(resource.data).affectedKeys();
        return d.keys().hasOnly(layoutUsageIds())
          && changed.size() == 1 && changed.hasOnly(layoutUsageIds())
          && layoutUsageStep('classic') && layoutUsageStep('field') && layoutUsageStep('focus') && layoutUsageStep('mission')
          && layoutUsageStep('bento') && layoutUsageStep('crew') && layoutUsageStep('island') && layoutUsageStep('inbox');
      }
      match /layoutUsage/{day} {
        allow read: if isAdmin()
          || ownsTenantByUid(companyId)
          || (isCompanyAdmin() && request.auth.token.get('companyId', '') == companyId);
        allow create, update: if layoutUsageMember()
          && day.matches('^20[0-9]{2}-[0-1][0-9]-[0-3][0-9]$')
          && layoutUsageOk();
        allow delete: if false;
      }

      // ── SUB ROSTER (production flow, 2026-10-04) ──
      // The company's independent subcontractors: name, phone, trade,
      // insurance-certificate expiry, notes. Keyed under the TENANT key the
      // client stamps on leads (claims.companyId, or a solo operator's own
      // uid) — the same key the members rule above accepts. Readable by the
      // tenant; writable by the solo owner or same-company staff (never a
      // viewer, never a sales_rep). Soft delete (active:false) keeps a sub a
      // past job names.
      //
      // The paperwork fields (W-9 status, certificate dates, legal name, notes; see
      // subPaperworkOk) are narrower: the solo owner or company_admin ONLY. A manager
      // still edits the roster itself, but a write that sets or changes one of those
      // fields is refused (subPaperworkWriter).
      match /subs/{subId} {
        function subPaperworkWriter() {
          return isAuth() && notViewer()
            && (ownsTenantByUid(companyId)
                || (isCompanyAdmin() && request.auth.token.get('companyId', '') == companyId));
        }
        function subPaperworkKeys() {
          return ['legalName', 'entityType', 'w9Status', 'w9ReceivedOn', 'glExpiry', 'wcExpiry', 'wcExempt', 'wcExemptNote',
                  'licenseRequired', 'licenseNote', 'licenseExpiry', 'paperworkNote', 'paperworkReviewedAt'];
        }
        allow read: if isAdmin()
          || ownsTenantByUid(companyId)
          || (isAuth() && request.auth.token.get('companyId', '') == companyId);
        allow create: if isAuth() && notViewer()
          && (ownsTenantByUid(companyId)
              || (isCompanyStaff() && request.auth.token.get('companyId', '') == companyId))
          && subWriteOk()
          && (!request.resource.data.keys().hasAny(subPaperworkKeys()) || subPaperworkWriter());
        allow update: if isAuth() && notViewer()
          && (ownsTenantByUid(companyId)
              || (isCompanyStaff() && request.auth.token.get('companyId', '') == companyId))
          && subWriteOk()
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(subPaperworkKeys()) || subPaperworkWriter());
        allow delete: if isAuth() && notViewer()
          && (ownsTenantByUid(companyId)
              || (isCompanyAdmin() && request.auth.token.get('companyId', '') == companyId));

        // ── SUB PAPERS (W-9 / certificates, 2026-10-19, flag subPaperwork) ──
        // companies/{companyId}/subs/{subId}/papers/{paperId}: a POINTER to a private
        // Storage file (sub-papers/{companyId}/{subId}/{file}, storage.rules): the kind,
        // the path, the display name. Never a URL or a ?token= link (the path regex
        // refuses both), never a tax ID. Read AND write: the solo owner or the
        // company's company_admin only: not a manager, not a sales_rep, and not a
        // viewer (a W-9 carries a tax ID; a viewer sees the status on the sub, not the
        // file). A paper is immutable: replace it by uploading a new one and deleting
        // the old.
        match /papers/{paperId} {
          function subPapersAccess() { return subPaperworkWriter(); }
          function subPaperOk() {
            let d = request.resource.data;
            return d.keys().hasOnly(['kind', 'storagePath', 'fileName', 'uploadedAt', 'uploadedBy'])
              && d.keys().hasAll(['kind', 'storagePath', 'uploadedBy'])
              && d.kind in ['w9', 'gl_coi', 'wc_coi', 'license', 'other']
              && d.storagePath is string
              && d.storagePath.matches('^sub-papers/' + companyId + '/' + subId + '/[A-Za-z0-9._-]{1,160}$')
              && !d.storagePath.matches('.*[.][.].*')
              && (!('fileName' in d) || (d.fileName is string && d.fileName.size() <= 120))
              && (!('uploadedAt' in d) || d.uploadedAt is timestamp)
              && d.uploadedBy == request.auth.uid;
          }
          allow read, delete: if subPapersAccess();
          allow create: if subPapersAccess() && subPaperOk();
          allow update: if false;
        }
      }

      // ── COMPANY DOCUMENTS (own-document expiry, 2026-10-18) ──
      // companies/{companyId}/companyDocs/{docId}: the company's OWN papers that
      // expire (GL certificate, workers' comp, licenses, manufacturer certs,
      // vehicle papers): type, name, issuer, expiry (YYYY-MM-DD), notes, and a
      // PRIVATE file reference (text saying where the file lives; a URL or a
      // Storage ?token= link is refused here, so none can reach a page). The
      // subcontractors' certificates stay on companies/{id}/subs above.
      // Read: the solo owner, the company's company_admin / manager / viewer
      // (never a sales_rep) and the platform admin. Write: the solo owner or the
      // company's company_admin ONLY; never a viewer (decision B, 2026-09-25).
      function companyDocOk() {
        let d = request.resource.data;
        let exp = d.get('expiry', null);
        return d.keys().hasOnly(['type', 'name', 'issuer', 'expiry', 'notes', 'fileRef', 'active', 'createdAt', 'updatedAt', 'updatedBy'])
          && d.get('type', '') in ['gl_coi', 'workers_comp', 'license', 'manufacturer_cert', 'vehicle', 'other']
          && d.get('name', null) is string && d.name.size() > 0 && d.name.size() <= 80
          && (!('issuer' in d) || d.issuer == null || (d.issuer is string && d.issuer.size() <= 80))
          && (exp == null || exp == '' || (exp is string && exp.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
          && (!('notes' in d) || d.notes == null || (d.notes is string && d.notes.size() <= 1000))
          && (!('fileRef' in d) || d.fileRef == null
              || (d.fileRef is string && d.fileRef.size() <= 300
                  && !d.fileRef.lower().matches('.*(https?://|token=|firebasestorage|storage[.]googleapis).*')))
          && (!('active' in d) || d.active is bool)
          && (!('updatedBy' in d) || d.updatedBy == request.auth.uid);
      }
      function companyDocWriter() {
        return isAuth() && notViewer()
          && (ownsTenantByUid(companyId)
              || (isCompanyAdmin() && request.auth.token.get('companyId', '') == companyId));
      }
      match /companyDocs/{docId} {
        allow read: if isAdmin()
          || ownsTenantByUid(companyId)
          || (isAuth() && request.auth.token.get('companyId', '') == companyId
              && request.auth.token.get('role', '') in ['company_admin', 'manager', 'viewer']);
        allow create, update: if companyDocWriter() && companyDocOk();
        allow delete: if companyDocWriter();
      }

      // Per-number contact labels (2026-10-12). Read: the solo owner, the
      // company's pipeline readers (company_admin / manager / viewer — the
      // phone_calls audience) and the platform admin. A sales_rep never reads
      // them: a label is keyed by a phone number, and a rep must not see
      // teammates' numbers. Write: the solo owner or company_admin / manager,
      // never a viewer (decision B). Delete = the same writers (undo of a
      // first label, "Remove label").
      // The uid branch is ownsTenantByUid (QA 2026-10-13): after an owner
      // hand-off (transferCompanyOwnership) the FORMER owner's uid still equals
      // the company id but the company doc names a new ownerId; they hold access
      // only through their claims, like any member.
      match /contact_suggestions/{digits} {
        allow read: if isAdmin()
          || ownsTenantByUid(companyId)
          || (isCompanyReader() && request.auth.token.get('companyId', '') == companyId);
        allow create, update: if isAuth() && notViewer()
          && (ownsTenantByUid(companyId)
              || (isCompanyStaff() && request.auth.token.get('companyId', '') == companyId))
          && contactSuggestionOk(companyId, digits);
        allow delete: if isAuth() && notViewer()
          && (ownsTenantByUid(companyId)
              || (isCompanyStaff() && request.auth.token.get('companyId', '') == companyId));
      }

      match /contact_labels/{digits} {
        allow read: if isAdmin()
          || ownsTenantByUid(companyId)
          || (isCompanyReader() && request.auth.token.get('companyId', '') == companyId);
        allow create: if isAuth() && notViewer()
          && (ownsTenantByUid(companyId)
              || (isCompanyStaff() && request.auth.token.get('companyId', '') == companyId))
          && contactLabelOk(companyId, digits);
        allow update: if isAuth() && notViewer()
          && (ownsTenantByUid(companyId)
              || (isCompanyStaff() && request.auth.token.get('companyId', '') == companyId))
          && contactLabelOk(companyId, digits)
          && request.resource.data.createdAtMs == resource.data.createdAtMs;
        allow delete: if isAuth() && notViewer()
          && (ownsTenantByUid(companyId)
              || (isCompanyStaff() && request.auth.token.get('companyId', '') == companyId));
      }

      // "Let Thursday handle this number" (2026-10-12): the setting per number.
      // Same audience as contact_labels: owner / company_admin / manager write,
      // a viewer reads, a sales_rep neither reads nor writes (numbers are
      // teammates' calls). The doc only changes what Thursday is TOLD and what
      // Today shows; it never sends and never touches carrier forwarding.
      match /thursday_handled/{digits} {
        allow read: if isAdmin()
          || ownsTenantByUid(companyId)
          || (isCompanyReader() && request.auth.token.get('companyId', '') == companyId);
        allow create: if isAuth() && notViewer()
          && (ownsTenantByUid(companyId)
              || (isCompanyStaff() && request.auth.token.get('companyId', '') == companyId))
          && thursdayHandledOk(companyId, digits);
        allow update: if isAuth() && notViewer()
          && (ownsTenantByUid(companyId)
              || (isCompanyStaff() && request.auth.token.get('companyId', '') == companyId))
          && thursdayHandledOk(companyId, digits)
          && request.resource.data.createdAtMs == resource.data.createdAtMs;
        allow delete: if isAuth() && notViewer()
          && (ownsTenantByUid(companyId)
              || (isCompanyStaff() && request.auth.token.get('companyId', '') == companyId));
      }
    }

    // ── TRAINING SESSIONS ────────────────────────────
    match /training_sessions/{sessionId} {
      // isCompanyStaff(), not isManager() — see /knocks (audit 2026-08-02).
      allow read: if isAdmin()
        || isOwner(resource.data.userId)
        || (isCompanyStaff() && sameCompanyAsResource());
      // Phase-1.5: companyId, if present, must be the caller's own tenant.
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid
        && (!('companyId' in request.resource.data)
            || request.resource.data.companyId == myCompanyId()
            || (request.auth.token.get('companyId', '') == ''
                && ownsTenantByUid(request.resource.data.companyId)));
      // Provenance frozen on update — see /photos above.
      allow update: if (isOwner(resource.data.userId) || isAdmin())
        && didNotChange(['userId', 'companyId']);
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ── REAL DEAL ACADEMY ────────────────────────────
    // Per-user training progress. Doc id IS the owner's uid; the live app
    // reads/writes /academy_progress/{uid} (real-deal-academy.js _loadProgress
    // / _saveProgress). No rule existed, so every read/write was
    // PERMISSION_DENIED and the Academy silently fell back to localStorage
    // (progress never synced server-side / cross-device). QA 2026-06-21 #2.
    match /academy_progress/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ── ETERNAL VAULT / PROJECT CODEX ────────────────
    // Jo's personal build-memory tool (docs/pro/js/vault-page.js):
    //   codex/latest         → the full codex snapshot (setDoc)
    //   codex-sessions/{id}   → per-session deltas (e.g. s01-delta)
    // This is a singleton DEV artifact — not tenant data, not per-user
    // owned: the docs carry no userId/companyId field. With no rule they
    // default-deny, so the Vault's "Save to Firestore" silently
    // PERMISSION_DENIED and never synced. Lock to the platform admin OR
    // Jo's uid (the sole operator of this tool). QA 2026-06-21.
    match /codex/{docId} {
      allow read, write: if isAdmin()
        || (isAuth() && request.auth.uid == '1phDvAVXHSg82wDLegAbQFq14Ci1');
    }
    match /codex-sessions/{sessionId} {
      allow read, write: if isAdmin()
        || (isAuth() && request.auth.uid == '1phDvAVXHSg82wDLegAbQFq14Ci1');
    }

    // ── PUBLIC LEAD FORMS ────────────────────────────
    // Direct client creates are DISABLED (C-3). Public forms must now
    // post through the `submitPublicLead` Cloud Function, which enforces
    // App Check + per-IP rate limit + honeypot + origin allowlist before
    // writing here via the admin SDK. Rules can't rate-limit, so direct
    // creates are an unbounded spam/billing DoS vector.
    match /guide_leads/{leadId} {
      allow create, update, delete: if false;
      allow read: if isAdmin();
    }

    match /contact_leads/{leadId} {
      allow create, update, delete: if false;
      allow read: if isAdmin();
    }

    match /estimate_leads/{leadId} {
      allow create, update, delete: if false;
      allow read: if isAdmin();
    }

    match /storm_alert_subscribers/{subId} {
      allow create, update, delete: if false;
      allow read: if isAdmin();
    }

    // ── STORM ALERTS SENT LOG (Cloud Function only) ──
    match /storm_alerts_sent/{alertId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── OTP / VERIFIED PHONES (admin-SDK only) ───────
    match /otp_requests/{docId}    { allow read, write: if false; }
    match /verified_phones/{phone} { allow read, write: if false; }
    match /unmatched_sms/{docId}   { allow read: if isAdmin(); allow write: if false; }

    // ── INVOICES ─────────────────────────────────────
    // Was createdBy-only with no viewer guard: a team manager couldn't read
    // team invoices, and a viewer-role user could mutate/delete them. Mirrors
    // the /expenses tenancy pattern — company-scoped read, companyId required on
    // create, viewer blocked from writes, provenance frozen.
    //
    // 2026-09-15 (Collections foundation): UPDATE was still createdBy-only
    // even though READ already granted the whole team company-scoped access —
    // a manager could SEE a teammate's outstanding invoice in a shared
    // Collections queue but got PERMISSION_DENIED trying to Mark Paid or Send
    // it, exactly the "whoever's free works the queue" use case Collections
    // needs. Mirrors the /leads precedent (isCompanyStaff update): staff who
    // aren't the creator can now act on any tenant invoice; DELETE stays
    // owner + company_admin only (not manager), same split /leads already
    // makes — a manager manages the queue, only the creator or the tenant
    // owner destroys a billing record.
    // Stripe ledger (2026-09-29): one row per Stripe money movement on the
    // platform account (charge / refund / dispute / payout / invoice paid
    // outside Stripe), matched to a CRM customer. Written ONLY by the admin
    // SDK (functions/stripe-ledger.js); a review assignment goes through the
    // assignStripeTransaction callable. Read: owner, same-company staff, admin.
    // Roof Care Plan memberships (2026-10-05, functions/care-plan.js). Written
    // only by the server (checkout, Stripe webhook, the owner's invite
    // callable). Readable inside the tenant, like phone_calls. The event
    // markers and the Stripe portal config are server-internal.
    match /careplans/{planId} {
      allow read: if isOwner(resource.data.userId)
        || isAdmin()
        || (isCompanyReader()
            && resource.data.companyId != null
            && resource.data.companyId == myCompanyId());
      allow write: if false;
    }
    match /careplan_events/{eventId} {
      allow read, write: if false;
    }
    match /careplan_config/{docId} {
      allow read, write: if false;
    }

    match /stripeLedger/{rowId} {
      allow read: if isOwner(resource.data.userId)
        || isAdmin()
        || (isCompanyStaff()
            && resource.data.companyId != null
            && resource.data.companyId == myCompanyId());
      allow write: if false;
    }

    match /invoices/{invoiceId} {
      allow read: if isOwner(resource.data.createdBy)
        || isAdmin()
        || (isCompanyStaff()
            && resource.data.companyId != null
            && resource.data.companyId == myCompanyId());
      // notViewer() on create too (decision B, 2026-09-25): the viewer guard
      // above covered update/delete only, so a viewer could still bill.
      allow create: if isAuth()
        && notViewer()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.companyId is string
        && request.resource.data.companyId.size() > 0
        && (request.resource.data.companyId == myCompanyId()
            || (request.auth.token.get('companyId', '') == ''
                && ownsTenantByUid(request.resource.data.companyId)))
        // 2026-10-05 (security review): an invoice that names a lead must
        // name one the writer may reach (leadReachable) — the money-paper
        // trigger files PDFs onto, and drafts tasks under, the invoice's
        // lead. No leadId (an estimate never tied to a lead) still passes.
        && (noLeadId(request.resource.data.get('leadId', null))
            || leadReachable(request.resource.data.leadId))
        // …and (R3-6, 2026-10-06) the id is a plain doc id naming only the
        // writer's own / company's lead: payment-timeline.js writes a
        // payment note onto it.
        && dealLeadOk(request.resource.data)
        // Backfill markers are owner-side only (a rep cannot mint or fake a backfill invoice).
        && (!hasBackfillMark(request.resource.data) || backfillWriterOk())
        && (!('payments' in request.resource.data) || (request.resource.data.payments is list && request.resource.data.payments.size() <= 200));
      // .get('role','') — reading an absent claim with != THROWS (solo owners
      // have no role claim). Freeze owner/tenant/provenance and the lead/job
      // it bills (R3-6); money fields stay mutable (markPaid rewrites
      // balanceDue/amountPaid/status).
      allow update: if isAdmin()
        || (
          (
            (isOwner(resource.data.createdBy) && notViewer())
            || (isCompanyStaff()
                && resource.data.companyId != null
                && resource.data.companyId == myCompanyId())
          )
          // jobId frozen (R3-6); leadId frozen once set — a lead-less
          // invoice may be attached once, to a lead the writer can reach
          // (leadIdStable, 2026-10-05).
          && didNotChange(['createdBy', 'companyId', 'estimateId', 'createdAt', 'jobId'])
          && leadIdStable()
          && backfillMarksFrozen()
          && invoiceVoidNoted()
          && (!('payments' in request.resource.data) || (request.resource.data.payments is list && request.resource.data.payments.size() <= 200))
        );
      allow delete: if isAdmin()
        || (isOwner(resource.data.createdBy) && notViewer())
        || (isCompanyAdmin()
            && resource.data.companyId != null
            && resource.data.companyId == myCompanyId());
    }

    // ── EMAIL DRIP ───────────────────────────────────
    // notViewer() on the writes of every owner-only block from here to
    // /deal_rooms (decision B, 2026-09-25); read is unchanged.
    match /drip_queue/{docId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuth() && notViewer() && request.resource.data.userId == request.auth.uid;
      allow update: if ((isOwner(resource.data.userId) && notViewer()) || isAdmin())
        && ownershipWriteOnce();
      allow delete: if (isOwner(resource.data.userId) && notViewer()) || isAdmin();
    }
    match /drip_log/{docId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if false;
    }

    // ── EMAIL / SMS LOG (admin-SDK write only) ─
    // Owner always reads own rows. Company staff/readers with matching
    // companyId see the full tenant thread for a lead (team Comm Log).
    // Legacy rows without companyId stay owner-only.
    match /email_log/{docId} {
      allow read: if isOwner(resource.data.uid)
        || isAdmin()
        || (isCompanyReader() && sameCompanyAsResource());
      allow write: if false;
    }
    match /sms_log/{docId} {
      allow read: if isOwner(resource.data.uid)
        || isAdmin()
        || (isCompanyReader() && sameCompanyAsResource());
      allow write: if false;
    }

    // ── LEAD DOCUMENTS ───────────────────────────────
    match /lead_documents/{docId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow update: if ((isOwner(resource.data.userId) && notViewer()) || isAdmin())
        && ownershipWriteOnce();
      allow delete: if (isOwner(resource.data.userId) && notViewer()) || isAdmin();
      allow create: if isAuth() && notViewer() && request.resource.data.userId == request.auth.uid;
    }

    // ── REFERRALS ────────────────────────────────────
    // R3-5 (2026-10-06): onReferralLeadWrite searches codes across tenants, so
    // a referral doc is pinned to the writer's company and to a referrer lead
    // of that company on create, and its identity fields are frozen after.
    function referralLeadOk(d) {
      let lid = d.get('referrerLeadId', null);
      return lid is string && lid.matches('^[A-Za-z0-9_-]{1,128}$')
        && exists(/databases/$(database)/documents/leads/$(lid))
        && (get(/databases/$(database)/documents/leads/$(lid)).data.get('userId', '') == request.auth.uid
            || (request.auth.token.get('companyId', '') != ''
                && get(/databases/$(database)/documents/leads/$(lid)).data.get('companyId', '')
                     == request.auth.token.get('companyId', '')));
    }
    match /referrals/{docId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuth() && notViewer() && request.resource.data.userId == request.auth.uid
        && request.resource.data.get('companyId', null) is string
        && (request.resource.data.companyId == request.auth.token.get('companyId', '')
            || (request.auth.token.get('companyId', '') == ''
                && ownsTenantByUid(request.resource.data.companyId)))
        && referralLeadOk(request.resource.data);
      allow update: if isAdmin()
        || (isOwner(resource.data.userId) && notViewer()
            && didNotChange(['userId', 'companyId', 'code', 'referrerLeadId']));
      allow delete: if isAdmin();
    }

    // ── REVIEW REQUESTS ──────────────────────────────
    match /review_requests/{docId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuth() && notViewer() && request.resource.data.userId == request.auth.uid;
      allow update: if ((isOwner(resource.data.userId) && notViewer()) || isAdmin())
        && ownershipWriteOnce();
      allow delete: if isAdmin();
    }

    // ── REPORTS ──────────────────────────────────────
    match /reports/{docId} {
      // Team visibility: a report carries the creator's companyId (stamped by
      // saveReport). Same-company members can read it so teammates/managers see
      // each other's inspection reports on shared leads — this also lets the
      // unfiltered per-lead query (where leadId == X) succeed for colleagues.
      // sameCompanyAsResource() requires BOTH companyIds non-null, so a solo
      // user (no companyId claim) or a legacy report (no companyId field) still
      // falls back to owner-only via isOwner — no cross-tenant leak.
      allow read: if isOwner(resource.data.userId) || isAdmin() || sameCompanyAsResource();
      // Pin companyId on create (mirrors /leads, /expenses, /invoices). Without
      // this a crafted write could set ANY companyId and inject a report into
      // another tenant's team-visible feed (sameCompanyAsResource read) — and
      // report.html renders same-origin, so that was a cross-tenant stored-XSS
      // vector. saveReport already stamps companyId = claims.companyId || uid.
      allow create: if isAuth()
        && notViewer()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.companyId is string
        && request.resource.data.companyId.size() > 0
        && (request.resource.data.companyId == myCompanyId()
            || (request.auth.token.get('companyId', '') == ''
                && ownsTenantByUid(request.resource.data.companyId)));
      allow update: if isAdmin();
      // Owners must be able to delete their own saved reports — the My
      // Reports list exposes a delete button to every owner, and admin-only
      // delete left it permanently failing (NEW-D11).
      allow delete: if (isOwner(resource.data.userId) && notViewer()) || isAdmin();
    }

    // ── INVITES (admin-SDK only) ─────────────────────
    // Legacy collection: its only writer (sendTeamInviteEmail) was retired
    // 2026-08-06 (tenant-lifecycle CL8). The deny stays as a tombstone over
    // any historical docs; the live invite flow is teamInvites via the
    // createTeamInvite callable.
    match /invites/{token} { allow read, write: if false; }

    // ── AUDIT LOG (admin-only reads, admin-SDK writes) ─
    match /audit_log/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── PORTAL TOKENS (admin-SDK only) ─────────────────
    // Minted by createPortalToken, consumed by getHomeownerPortalView.
    // Tokens are sensitive — a leaked token grants read of a
    // homeowner's redacted project view, so clients get no direct
    // access. The homeowner-facing page talks to the HTTP endpoint.
    match /portal_tokens/{token} {
      allow read, write: if false;
    }

    // ── REMOTE-SIGNING TOKENS (admin-SDK only) ─────────
    // Signatures PR4/5. createSignRequest mints these; the homeowner
    // signs via the public getSignDocument / submitSignature endpoints
    // (token-authed, admin SDK). No Firebase-auth client ever touches
    // this collection — same lockdown as portal_tokens.
    match /doc_sign_tokens/{token} {
      allow read, write: if false;
    }

    // ── E-SIGN ENVELOPES ───────────────────────────────
    // PDF-native signing: a rep uploads any PDF, places typed fields on it,
    // and a homeowner completes it from a single-use link.
    //
    // The envelope itself is owner-readable so the rep can see status,
    // resend and void — the old signing path had NO status surface at all,
    // which is why a rep could never tell a delivered link from a dead one.
    //
    // But it is NOT client-writable after creation. The envelope carries the
    // executed record's audit trail (signer IP, user agent, consent, both
    // SHA-256 digests) and the rep is an interested party to the contract
    // that trail is evidence for. Every mutation goes through a Cloud
    // Function with the admin SDK, so the party who benefits from a rewrite
    // cannot perform one.
    match /esign_envelopes/{envelopeId} {
      allow read: if isAuth() && resource.data.ownerUid == request.auth.uid;
      allow write: if false;
    }

    // Same lockdown as doc_sign_tokens: minted and burned by the admin SDK,
    // never touched by a Firebase-auth client.
    match /esign_tokens/{token} {
      allow read, write: if false;
    }

    // ── CLOSE BOARD DEAL ROOMS ────────────────────────
    // Shareable deal rooms (close-board.js syncDealToFirestore). Owner-keyed on
    // userId. createDealAcceptToken (admin SDK) reads this doc to owner-scope a
    // share token + snapshot tier prices, so userId MUST be trustworthy: pin it
    // to the caller on create (a rep can't plant a deal under another uid).
    // Without this rule the client write default-denied and deals never synced.
    // Read split from the writes 2026-09-25 so they can carry notViewer().
    // A deal the homeowner accepted (or the rep signed / scheduled) is a signed
    // record, locked like a signed contract (Jo, 2026-09-25): nobody deletes
    // it, moves it back out of a closed status, or rewrites what was accepted.
    // syncDealToFirestore pushes the rep's whole LOCAL copy, so a tab that
    // hadn't re-read the server since a remote acceptance wrote status 'sent'
    // back over 'accepted' (2026-09-28). Other fields (notes, install date)
    // stay editable.
    function dealIsClosed(d) {
      return d.get('status', '') in ['accepted', 'signed', 'scheduled'];
    }
    function dealAcceptanceIntact() {
      return !dealIsClosed(resource.data)
        || (dealIsClosed(request.resource.data)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'acceptedTier', 'acceptedPrice', 'acceptedFinancing',
              'acceptedSignature', 'acceptedAt', 'acceptedVia']));
    }
    // deal_rooms.leadId (2026-10-05): a deal names only the writer's own lead
    // or one in the writer's company. The accepted deal writes to that lead
    // (createDealAcceptToken re-checks the same thing server-side). A lead id
    // with no doc yet is allowed — nothing to write to, and the server drops
    // it at mint time. Checked on create and whenever leadId changes.
    function dealLeadOk(d) {
      let lid = d.get('leadId', null);
      return lid == null || lid == ''
        || (lid is string && lid.matches('^[A-Za-z0-9_-]{1,128}$')
            && (!exists(/databases/$(database)/documents/leads/$(lid))
                || get(/databases/$(database)/documents/leads/$(lid)).data.get('userId', '') == request.auth.uid
                || (request.auth.token.get('companyId', '') != ''
                    && get(/databases/$(database)/documents/leads/$(lid)).data.get('companyId', '')
                         == request.auth.token.get('companyId', ''))));
    }
    match /deal_rooms/{dealId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow update: if ((isOwner(resource.data.userId) && notViewer()) || isAdmin())
        && dealAcceptanceIntact()
        && ownershipWriteOnce()
        && (request.resource.data.get('leadId', null) == resource.data.get('leadId', null)
            || isAdmin() || dealLeadOk(request.resource.data));
      allow delete: if ((isOwner(resource.data.userId) && notViewer()) || isAdmin())
        && !dealIsClosed(resource.data);
      allow create: if isAuth() && notViewer() && request.resource.data.userId == request.auth.uid
        && dealLeadOk(request.resource.data);
    }

    // Close Board deal acceptance (1a). createDealAcceptToken mints these;
    // the homeowner accepts via the public getDealRoom / submitDealAcceptance
    // endpoints (token-authed, admin SDK). No Firebase-auth client ever
    // touches this collection — same lockdown as doc_sign_tokens.
    match /deal_accept_tokens/{token} {
      allow read, write: if false;
    }

    // Inspection report sharing. createReportShareToken mints these; the
    // homeowner views the report via the public getSharedReport endpoint
    // (token-authed, admin SDK reads the report HTML inline). No Firebase-auth
    // client ever touches this collection — same lockdown as deal_accept_tokens.
    match /report_share_tokens/{token} {
      allow read, write: if false;
    }

    // Calendar feed tokens. createCalendarFeedToken mints these; the rep's
    // phone fetches /calendar/<token>.ics through the public getCalendarFeed
    // endpoint (token-authed, admin SDK reads the schedule). No Firebase-auth
    // client ever touches this collection — a readable token here would hand
    // any signed-in user a teammate's whole book. Same lockdown as
    // report_share_tokens.
    match /calendar_feed_tokens/{token} {
      allow read, write: if false;
    }

    // ── PARCEL CACHE (admin-SDK only) ──────────────────
    // Regrid lookup cache — reads are a privacy issue (address →
    // owner name). Only the Cloud Function accesses via admin SDK.
    match /parcel_cache/{key} {
      allow read, write: if false;
    }

    // ── MEASUREMENTS (owner + same-company read) ───────
    // Created by requestMeasurement, filled by measurementWebhook.
    // Owner or same-company teammate can read (90-day same-roof reuse in
    // requestMeasurement/findReusableMeasurement depends on this — see
    // functions/integrations/measurement.js); writes are admin-SDK only
    // (webhook). companyId is fully server-stamped from the caller's Auth
    // custom claim, never client-writable, so this is a read-only
    // relaxation. sameCompanyAsResource() requires BOTH companyIds
    // non-null, so a legacy doc with no companyId field falls back to
    // owner-only — no cross-tenant leak (mirrors /pins, /zones).
    match /measurements/{jobId} {
      allow read: if isOwner(resource.data.ownerId) || sameCompanyAsResource() || isAdmin();
      allow write: if false;
    }

    // ── APPOINTMENTS (Cal.com webhook output) ──────────
    // Written by calcomWebhook, read by the owning rep.
    match /appointments/{bookingId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if false;
    }

    // ── ACCOUNT ERASURE REQUESTS (admin-SDK only) ──────
    // D7: two-step GDPR erasure. The token hash never leaves the
    // server, so the only way to confirm a deletion is through
    // the confirmAccountErasure HTTP endpoint (which validates the
    // emailed token against the hash).
    match /account_erasures/{uid} {
      allow read, write: if false;
    }

    // ── EMAIL QUEUE (admin-SDK only) ───────────────────
    // Enqueued by server-side flows (GDPR confirmations, dunning,
    // portal invites). A worker processes + clears entries. Clients
    // should never touch this — they'd be able to spoof senders or
    // mine the queue for email addresses.
    match /email_queue/{id} {
      allow read, write: if false;
    }

    // ── DEVICE FINGERPRINTS (admin-SDK only) ───────────
    // D9: per-uid list of seen device fingerprints, used by the
    // new-device Slack alert. Writes only via server triggers.
    match /user_devices/{uid} {
      allow read, write: if false;
      match /seen/{fingerprint} {
        allow read, write: if false;
      }
    }

    // ── FEATURE FLAGS (read by any authed user) ────────
    // F9: _default holds the platform defaults. {uid} is an
    // optional per-user override. Platform admin only writes.
    match /feature_flags/_default {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
    match /feature_flags/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // ── V2 ESTIMATE DRAFTS (owner only) ────────────────
    // F7: one draft doc per user keyed by uid. Owner reads/writes
    // their own; everyone else (including platform admin) is blocked
    // because drafts are ephemeral + the finalized estimate survives
    // in `estimates/`.
    match /estimate_drafts/{uid} {
      allow read, write: if isOwner(uid);
    }

    // ── SMS OPT-OUT LIST (admin-SDK only) ──────────────
    // F3: TCPA compliance. incomingSMS (Twilio webhook) writes here
    // when a recipient replies STOP. sendSMS + sendD2DSMS read it
    // before sending. Both paths go through the admin SDK; clients
    // never need direct access, and leaking the list would identify
    // every number that opted out.
    match /sms_opt_outs/{phone} {
      allow read, write: if false;
    }

    // ── SMS DO NOT TEXT LIST (admin-SDK only, 2026-10-05) ──
    // sms_dnc/{companyId}__{phoneKey}: a company's internal Do Not Text
    // list. Written and read ONLY by functions (manageSmsCompliance, and
    // incomingSMS copying a STOP reply); enforced in sms-optout.js
    // isOptedOut. A client write could take a number off the list (texting
    // someone who asked not to be texted) or plant one on another company's.
    match /sms_dnc/{id} {
      allow read, write: if false;
    }

    // ── SMS TEXTING MASTER SWITCH (admin-SDK only, 2026-10-05) ──
    // sms_settings/{companyId}: { enabled, registered }. Read and written only
    // through functions (manageSmsCompliance getSettings / setEnabled; every
    // send path reads it, sms-texting-gate.js). A client write could set
    // registered: true and text another business's customers under NBD's
    // registered brand, or switch a company's texting back on.
    match /sms_settings/{id} {
      allow read, write: if false;
    }

    // ── MESSAGING KILL SWITCH (admin-SDK only, 2026-10-19) ──
    // messaging_controls/{global,internal}: the master customer-send switch,
    // canary flag and the owner's alert contact. messaging_controls_audit and
    // messaging_controls_counters: append-only flip log and the internal-alert
    // hourly counters. Written only by manageMessagingControls / the send
    // paths; a client write could switch customer messaging back on.
    match /messaging_controls/{id} {
      allow read, write: if false;
    }
    match /messaging_controls_audit/{id} {
      allow read, write: if false;
    }
    match /messaging_controls_counters/{id} {
      allow read, write: if false;
    }

    // ── EMAIL UNSUBSCRIBE REGISTER (2026-09-22, CAN-SPAM) ──
    // email_suppressions/{companyId}__{sha256(email)} — per TENANT. Written
    // ONLY by the admin SDK (functions/email-unsubscribe.js: the public
    // unsubscribe endpoint and the markEmailUnsubscribed callable). A client
    // write could un-suppress someone who opted out (legal exposure) or forge
    // an opt-out.
    //
    // READ: a single-doc GET by a member of the tenant named in the doc id —
    // the customer page's "Unsubscribed from email" badge. The tenant key is
    // the companyId claim, or the uid for a claim-less solo operator (the
    // companyProfile convention). The check is on the ID PREFIX, not
    // resource.data, so a missing doc answers not-found (badge off) instead
    // of permission-denied, and another tenant cannot probe existence: its
    // get is denied whether or not the doc exists. An existing doc must also
    // carry the same companyId it is filed under. No list: nothing needs it.
    match /email_suppressions/{supId} {
      function supTenant() { return supId.split('__')[0]; }
      function supMember() {
        return isAuth() && supTenant() != ''
          && (supTenant() == request.auth.token.get('companyId', '')
              || ownsTenantByUid(supTenant()));
      }
      allow get: if supMember()
        && (resource == null || resource.data.companyId == supTenant());
      allow list: if false;
      allow write: if false;
    }

    // email_unsub_tokens/{token} — the 256-bit secret behind every
    // unsubscribe link. Admin SDK only; no client may read, list or write
    // one (a readable token is a working unsubscribe for someone else).
    match /email_unsub_tokens/{token} {
      allow read, write: if false;
    }

    // ── SMS OUTBOX IDEMPOTENCY CLAIMS (admin-SDK only) ─
    // sendSMS claims {uid}_{clientMsgId} in a transaction before it replays a
    // text from the offline outbox (docs/pro/js/sms-outbox.js), so a retry of
    // a text that already went out answers "duplicate" instead of texting the
    // homeowner twice. A client that could write here could pre-claim ids and
    // make its own queued texts report "sent" without sending; one that could
    // read would see recipient keys. Covered by the default deny below;
    // spelled out so the intent survives a future rules edit.
    match /sms_client_ids/{claimId} {
      allow read, write: if false;
    }

    // Entries for the annual "One Free Roof" giveaway. Written only by
    // the submitPublicLead Cloud Function via admin SDK; NBD staff
    // triages entries through the Firebase console (server-side) so no
    // client read surface is needed.
    match /free_roof_entries/{id} {
      allow read, write: if false;
    }

    // Public cache doc for /api/google-reviews. Written by the Cloud
    // Function with admin SDK; clients fetch the function endpoint,
    // never the doc directly.
    match /public_cache/{key} {
      allow read, write: if false;
    }

    // ── STRIPE WEBHOOK IDEMPOTENCY (admin-SDK only) ──
    // F-07 + invoiceWebhook idempotency: stripe.js atomic-creates a
    // doc here keyed by event.id to block duplicate deliveries. The
    // admin SDK bypasses rules; clients never need to touch this.
    // An explicit rule (vs. falling through to default-deny) makes
    // the intent clear for future readers.
    // ── MIGRATION FRAMEWORK STATE (admin-SDK only) ──────
    // /system/migrations holds appliedVersion + lastError for the
    // versioned runner in functions/migrations/runner.js. Clients
    // never need to read or write this — admin scripts and the
    // scheduled tick are the only legitimate writers.
    match /system/{docId} {
      allow read, write: if false;
    }
    match /system/migrations/history/{historyId} {
      allow read, write: if false;
    }

    match /stripe_events/{eventId} {
      allow read, write: if false;
    }

    // Job-spine idempotency markers (functions/job-spine.js, 2026-10-03):
    // one doc per (leadId, event, sourceId), created in the same transaction
    // as the automatic stage move it records. Admin SDK only — a client that
    // could write here could pre-claim a marker and silently suppress a real
    // move (a payoff, a signed contract); reading one would leak another
    // tenant's lead ids and payment metadata.
    match /job_events/{markerId} {
      allow read, write: if false;
    }

    // Resend webhook delivery ids, claimed with create() so two concurrent
    // redeliveries of the same event cannot both record a suppression.
    // Admin-SDK only, exactly like stripe_events.
    match /resend_events/{eventId} {
      allow read, write: if false;
    }

    // Tenant microsite slug claim docs (Pillar 5). Admin-SDK only — written
    // transactionally by setSiteSlug as the uniqueness lock + reverse index;
    // clients never read or write them (getPublicSiteConfig reads server-side).
    match /siteSlugs/{slug} {
      allow read, write: if false;
    }

    // Thumbtack webhook landing collections (integrations/thumbtack.js).
    // Admin-SDK only: thumbtackWebhook is the sole writer, and the CRM never
    // reads these directly — lead events reach the pipeline via the
    // leadBridgeThumbtack mirror into `leads`, which carries its own tenant
    // scoping. They hold raw customer names and phone numbers, so keeping them
    // closed to clients is deliberate, not incidental. Covered by the default
    // deny below; spelled out so the intent survives a future rules edit.
    match /thumbtack_leads/{docId} {
      allow read, write: if false;
    }
    match /thumbtack_messages/{docId} {
      allow read, write: if false;
    }
    match /thumbtack_reviews/{docId} {
      allow read, write: if false;
    }
    match /thumbtack_events/{docId} {
      allow read, write: if false;
    }

    // Thursday — the Bland AI receptionist's call log (integrations/thursday.js).
    // One doc per call (id bland_calls__{call_id}): transcript, extraction,
    // route, notification state. Admin-SDK only for writes — the webhook, the
    // processing trigger and the thursdayCallAction callable (which enforces
    // not-viewer + owner/company staff). Reads mirror /leads: the owner, the
    // platform admin, and the company's pipeline readers (company_admin,
    // manager, viewer) — sales_rep stays own-leads-only, so a rep never sees
    // calls about teammates' customers. Recordings live in Storage calls/
    // (server-only) and are streamed by getThursdayRecording, never linked.
    match /thursday_calls/{docId} {
      allow read: if isOwner(resource.data.userId)
        || isAdmin()
        || (isCompanyReader() && sameCompanyAsResource());
      allow write: if false;
    }
    // Call Center (call-center.js): Jo's phone-call recordings filed from
    // Cube ACR. Server-written only; reads mirror thursday_calls. Audio lives
    // in Storage calls/{uid}/cube-acr/ (owner-only read, server-only write).
    match /phone_calls/{docId} {
      allow read: if isOwner(resource.data.userId)
        || isAdmin()
        || (isCompanyReader() && sameCompanyAsResource());
      allow write: if false;
    }
    // Text Inbox (text-inbox.js): Jo's texts from the phone's SMS backup.
    // Server-written only; same readers as phone_calls.
    match /phone_texts/{docId} {
      allow read: if isOwner(resource.data.userId)
        || isAdmin()
        || (isCompanyReader() && sameCompanyAsResource());
      allow write: if false;
    }
    // Text notes per conversation-day (text-inbox.js textInboxNotes).
    // Server-written only; same readers as phone_texts.
    match /phone_text_days/{docId} {
      allow read: if isOwner(resource.data.userId)
        || isAdmin()
        || (isCompanyReader() && sameCompanyAsResource());
      allow write: if false;
    }
    // Per-tenant Thursday settings (notification destinations, SMS flag).
    // Written only by scripts/thursday-config.js; the CRM reads it to decide
    // whether to show the Thursday inbox widget.
    match /thursday_config/{companyId} {
      allow read: if isAuth() && (ownsTenantByUid(companyId)
        || isAdmin()
        || (isCompanyReader() && myCompanyId() == companyId));
      allow write: if false;
    }

    // ── JOBS, collection-group reads (2026-09-30) ─────
    // The pipeline loads a company's jobs in ONE query
    // (collectionGroup('jobs').where('companyId'|'userId', '==', …)) instead
    // of one read per customer. A collection-group query only matches a
    // recursive rule, so this grants READ ONLY, on the job's own ownership
    // stamps — which jobWriteOk() forces to equal the parent lead's, and the
    // server mirror (functions/jobs-mirror.js) keeps in step. Same audience
    // as the nested rule: the owner, a company reader of the job's tenant, or
    // a platform admin. The only 'jobs' collection in the database is the one
    // under /leads.
    match /{path=**}/jobs/{jobId} {
      allow read: if isAuth() && (isAdmin()
        || resource.data.get('userId', '') == request.auth.uid
        || (isCompanyReader()
            && request.auth.token.get('companyId', '') != ''
            && resource.data.get('companyId', '') == request.auth.token.get('companyId', '')));
    }

    // Material orders across a tenant's jobs (production flow, 2026-10-04):
    // the Schedule view's 7-day busy strip and delivery warnings load them
    // with collectionGroup('orders').where('userId'|'companyId','==',…). Same
    // shape as the jobs grant directly above; orderWriteOk pins both fields
    // to the parent lead's.
    match /{path=**}/orders/{orderId} {
      allow read: if isAuth() && (isAdmin()
        || resource.data.get('userId', '') == request.auth.uid
        || (isCompanyReader()
            && request.auth.token.get('companyId', '') != ''
            && resource.data.get('companyId', '') == request.auth.token.get('companyId', '')));
    }

    // ── TASKS, collection-group reads (2026-10-03) ────
    // The dashboard loads every task in ONE query
    // (collectionGroup('tasks').where('companyId'|'userId', '==', …),
    // docs/pro/js/tasks.js + today-plan.js tasksQuery) instead of one read
    // per lead. A collection-group query only matches a recursive rule, so
    // this grants READ ONLY, on the task's own stamps — which taskStampOk()
    // keeps inside the task's tenant and functions/tasks-stamp.js fills from
    // the parent lead. Same audience as the nested rule: the owner, a company
    // reader of the task's tenant, or a platform admin. (It also matches the
    // retired top-level /tasks docs, whose own rule already lets the owner
    // read them; the client drops those rows.)
    match /{path=**}/tasks/{taskId} {
      allow read: if isAuth() && (isAdmin()
        || resource.data.get('userId', '') == request.auth.uid
        || (isCompanyReader()
            && request.auth.token.get('companyId', '') != ''
            && resource.data.get('companyId', '') == request.auth.token.get('companyId', '')));
    }

    // ── DEFAULT DENY ─────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
