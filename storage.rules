rules_version = '2';

// NBD Pro Firebase Storage Security Rules — HARDENED
// Deploy: firebase deploy --only storage
//
// Every path is owner-scoped by uid. "Public" customer-facing links
// require a short-lived signed URL (signImageUrl Cloud Function) —
// no direct `allow read` on user content.
//
// D2 rev: explicit content-type allowlists per path. Prevents
// photos/... from accepting application/octet-stream uploads that
// bypass the `image/*` intent. Size caps tightened where the
// previous limits were larger than the real use case.

service firebase.storage {
  match /b/{bucket}/o {

    function isAuth() { return request.auth != null; }
    function isOwner(uid) { return isAuth() && request.auth.uid == uid; }
    function isAdmin() { return isAuth() && request.auth.token.role == 'admin'; }

    // 2026-09-25 (Jo's decision B): the 'viewer' role is READ-ONLY on tenant
    // data. Every path below is keyed by the uploader's uid, so a viewer could
    // upload photos, contracts, receipts and audio under their own prefix
    // even though firestore.rules now refuses every doc that would point at
    // them. ownerWrites() is the owner check plus that bar; it is false only
    // for role == 'viewer', so no other role loses anything. .get() because a
    // solo operator has NO role claim (a bare token.role read throws). Same
    // rule as notViewer() in firestore.rules. Reads are unchanged.
    function ownerWrites(uid) {
      return isOwner(uid) && request.auth.token.get('role', '') != 'viewer';
    }

    // Safe content-type helpers — handle the case where a malicious
    // upload omits the Content-Type header entirely (Firebase sets
    // request.resource.contentType to null in that case and
    // `null.matches(...)` blows the whole rule).
    function isImage() {
      return request.resource != null
        && request.resource.contentType != null
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif|avif|gif)');
    }
    // Raster images only (security checklist 2026-10-01): 'image/.+' admitted
    // image/svg+xml, which can carry script and runs it when opened from its
    // download URL. Same image list as isImage().
    function isDocType() {
      return request.resource != null
        && request.resource.contentType != null
        && request.resource.contentType.matches(
             'application/pdf|application/msword|application/vnd\\.openxmlformats-officedocument\\..+|text/plain|text/csv|image/(jpeg|png|webp|heic|heif|avif|gif)'
           );
    }
    function isHtmlOnly() {
      return request.resource != null
        && request.resource.contentType != null
        && request.resource.contentType.matches('text/html; ?charset=.+|text/html');
    }

    // The EXISTING object is a signed record (customMetadata signed: 'true').
    // Null-safe for a new upload (no resource) and for objects with no custom
    // metadata at all.
    function storedObjectIsSigned() {
      return resource != null
        && resource.metadata != null
        && resource.metadata.get('signed', '') == 'true';
    }

    // ── PHOTOS ─────────────────────────────────────────
    // Path: photos/{uid}/{file}
    match /photos/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if ownerWrites(uid)
        && request.resource.size < 15 * 1024 * 1024
        && isImage();
      allow delete: if ownerWrites(uid) || isAdmin();
    }
    // Legacy un-scoped path: blocked.
    match /photos/{file} {
      allow read, write: if false;
    }

    // ── DOCUMENTS ──────────────────────────────────────
    // Path: docs/{uid}/{file}
    // Contract PDFs, signed docs, insurance scopes live here. Accepts
    // PDFs, Office docs, plaintext/CSV, and images (for inlined
    // attachments). Rejects executable / archive types by default.
    match /docs/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if ownerWrites(uid)
        && request.resource.size < 25 * 1024 * 1024
        && isDocType();
      allow delete: if ownerWrites(uid) || isAdmin();
    }
    match /docs/{file} {
      allow read, write: if false;
    }

    // ── CUSTOMER PORTALS ──────────────────────────────
    // Path: portals/{uid}/{leadId}.html
    // The only place HTML uploads are allowed — and only for the
    // owning rep. Customer-facing pages bypass Storage entirely
    // now (portal.html is served by Hosting).
    match /portals/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if ownerWrites(uid)
        && request.resource.size < 5 * 1024 * 1024
        && isHtmlOnly();
      allow delete: if ownerWrites(uid) || isAdmin();
    }

    // ── GENERATED DOCUMENTS (rep-owned HTML) ──────────
    // Path: documents/{uid}/{leadId}/{docId}.html
    // The doc generator (document-generator.js onPersistFinalized) uploads
    // each rendered doc's HTML here so it can be re-opened from the customer
    // page documents tab AND served to a remote signer via getSignDocument
    // (Signatures PR4). This path was previously default-DENIED — every
    // upload silently failed (the generator swallows the storage error) so
    // htmlPath pointed at a nonexistent object, breaking both re-open and
    // remote signing. Owner-only HTML, same shape as portals/.
    // 2026-09-29 — a SIGNED document's HTML is locked (Jo, 2026-09-25: a
    // signed contract is never changed). In-person signing
    // (document-generator.js onPersistFinalized) uploads the signed HTML over
    // the draft with customMetadata { signed: 'true' }; after that no client
    // overwrites or deletes the object. The file name is not the Firestore
    // doc id, so the tag on the object itself is what carries "signed" here.
    // Admin-SDK paths (lead-deletion cleanup) are unaffected.
    match /documents/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if ownerWrites(uid)
        && request.resource.size < 5 * 1024 * 1024
        && isHtmlOnly()
        && !storedObjectIsSigned();
      allow delete: if (ownerWrites(uid) || isAdmin()) && !storedObjectIsSigned();
    }

    // ── E-SIGN ENVELOPES ───────────────────────────────
    // Path: esign/{uid}/{leadId}/{envelopeId}/source.pdf   (rep uploads)
    //       esign/{uid}/{leadId}/{envelopeId}/signed.pdf   (function writes)
    //
    // PDF ONLY, deliberately: documents/ is isHtmlOnly() and the envelope
    // system is PDF end to end. Narrower than isDocType() — an envelope has
    // exactly one source format, so accepting .doc/.csv/images here would
    // only widen what a compromised rep session could stage.
    //
    // NO public read. The signer never touches Storage: getEsignEnvelope
    // streams the bytes through the Cloud Function against a single-use
    // token. That is the deliberate difference from the photo pipeline,
    // where permanent download tokens made every object URL-public and
    // bypassed these rules entirely. Do not "simplify" this by handing the
    // signer a download URL.
    // 2026-09-29: signed.pdf is written ONLY by the function (admin SDK) and
    // is the signed record — no client writes or deletes it (the lock). The
    // rep's own source.pdf keeps its rules.
    match /esign/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isAdmin();
      // (allPaths is a path, not a string — the object's full name is.)
      allow write: if ownerWrites(uid)
        && request.resource != null
        && !request.resource.name.matches('.*/signed[.]pdf')
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType != null
        && request.resource.contentType.matches('application/pdf');
      allow delete: if (ownerWrites(uid) || isAdmin())
        && !(resource != null && resource.name.matches('.*/signed[.]pdf'));
    }

    // ── DEAL ROOMS ─────────────────────────────────────
    // close-board.js uploadDealPage() uploads the shareable deal page as
    // text/html — isDocType() does NOT match text/html, so every
    // share-link upload was storage/unauthorized and the Copy/Text/Email
    // link actions always failed (NEW-D13). Deal rooms only ever store
    // HTML pages, so gate on isHtmlOnly() like documents/.
    match /deal_rooms/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if ownerWrites(uid)
        && request.resource.size < 5 * 1024 * 1024
        && isHtmlOnly();
      allow delete: if ownerWrites(uid) || isAdmin();
    }

    // ── SHARED GALLERIES ──────────────────────────────
    match /galleries/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if ownerWrites(uid)
        && request.resource.size < 10 * 1024 * 1024
        && isImage();
      allow delete: if ownerWrites(uid) || isAdmin();
    }

    // ── SHARED REPORTS ────────────────────────────────
    match /reports/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if ownerWrites(uid)
        && request.resource.size < 10 * 1024 * 1024
        && isDocType();
      allow delete: if ownerWrites(uid) || isAdmin();
    }

    // ── SHARED DOCUMENTS ──────────────────────────────
    match /shared_docs/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if ownerWrites(uid)
        && request.resource.size < 25 * 1024 * 1024
        && isDocType();
      allow delete: if ownerWrites(uid) || isAdmin();
    }

    // ── VOICE INTELLIGENCE AUDIO (C2) ──────────────────
    // Path: audio/{uid}/{leadId}/{recordingId}.{ext}
    //
    // Owner-keyed (matches photos/, docs/, etc.). The finalize
    // event at this path triggers functions/integrations/
    // voice-intelligence.js::onAudioUploaded. The rep's client
    // uploads here via uploadBytesResumable; the processing
    // function reads via admin SDK (bypasses these rules).
    //
    // 200MB cap = ~2.5 hours at 160kbps opus/webm. A longer
    // recording is almost always user error (forgot to stop);
    // the client splits before upload.
    //
    // Content-type allowlist covers MediaRecorder outputs from
    // Chrome/Firefox (audio/webm) and Safari/iOS (audio/mp4,
    // audio/m4a) plus common upload formats (mp3, ogg, wav, aac).
    function isAudioType() {
      return request.resource != null
        && request.resource.contentType != null
        && request.resource.contentType.matches(
             'audio/(webm|mpeg|mp3|mp4|m4a|ogg|wav|x-m4a|aac)(;.*)?'
           );
    }
    match /audio/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if ownerWrites(uid)
        && request.resource.size < 200 * 1024 * 1024
        && isAudioType();
      allow delete: if ownerWrites(uid) || isAdmin();
    }

    // ── EXPENSE RECEIPTS ──────────────────────────────
    // Path: receipts/{uid}/{file}
    // The original receipt image or PDF backing an expenses/{id} doc.
    // Owner-keyed like docs/ — accepts images (phone camera capture) and
    // PDFs (emailed/scanned receipts), rejects executables/archives.
    // 25MB cap matches docs/. Customer/team display goes through a
    // short-lived signed URL (signImageUrl), never a direct public read.
    // Kept immutable in spirit: filenames are unique (uid + timestamp) so
    // uploads never overwrite a prior original — the IRS recordkeeping
    // (Rev. Proc. 97-22) non-alteration expectation.
    match /receipts/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if ownerWrites(uid)
        && request.resource.size < 25 * 1024 * 1024
        && isDocType();
      allow delete: if ownerWrites(uid) || isAdmin();
    }
    match /receipts/{file} {
      allow read, write: if false;
    }

    // ── PAYMENT PROOFS ────────────────────────────────
    // Path: payment-proofs/{uid}/{invoiceId}/{ts}_{name}
    // The check photo, Zelle screenshot or bank PDF backing a manual payment
    // in invoices/{id}.payments[] (invoice-pipeline.js Record Payment /
    // 📎 Attach proof, 2026-09-29). Modeled exactly on receipts/: owner
    // writes (never a viewer), owner + platform admin read, images + PDFs
    // (isDocType), 25MB cap. The CRM opens it through getDownloadURL under
    // these same rules. Unique ts_ filenames — an upload never overwrites a
    // prior proof.
    match /payment-proofs/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if ownerWrites(uid)
        && request.resource.size < 25 * 1024 * 1024
        && isDocType();
      allow delete: if ownerWrites(uid) || isAdmin();
    }
    match /payment-proofs/{file} {
      allow read, write: if false;
    }

    // ── YARD-SIGN PHOTOS ──────────────────────────────
    // Path: yard-signs/{uid}/{ts}_{name} — a photo of each placed yard sign
    // (yard-signs.js, 2026-09-29). Same owner posture and image limits as
    // photos/; the Firestore doc (yardSigns/{id}) only holds photoPath.
    match /yard-signs/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if ownerWrites(uid)
        && request.resource.size < 15 * 1024 * 1024
        && isImage();
      allow delete: if ownerWrites(uid) || isAdmin();
    }
    match /yard-signs/{file} {
      allow read, write: if false;
    }

    // ── SERVER-RENDERED PDFs ──────────────────────────
    // Path: pdf-renders/{uid}/{ts}-{filename}.pdf
    // Written ONLY by functions/render-pdf.js through the admin SDK, which
    // bypasses these rules entirely. Nothing client-side may write, update or
    // delete here — `allow write` covers all three, so the absence of an
    // `allow delete` line is deliberate, not an oversight. The retention
    // reaper (functions/pdf-render-retention.js) also runs as admin.
    //
    // Stated explicitly rather than inherited from the catch-all below. It
    // previously had NO block at all, so the posture was real but invisible:
    // nothing said pdf-renders/ held customer invoices, contracts and
    // warranties, and a future catch-all edit would have widened it silently.
    //
    // READ HERE IS NOT THE WHOLE STORY. A Firebase download token
    // (`metadata.firebaseStorageDownloadTokens`) bypasses this rule completely
    // — an object carrying one is fetchable by anyone with the URL, forever,
    // with no auth and no revocation short of rotating the token. On
    // 2026-09-08, 19 of 21 prod objects under this prefix carried one, and an
    // unauthenticated HEAD on a customer roofing contract returned 200 OK
    // (the same URL with the token stripped returned 403 — the token was
    // exactly what granted access). render-pdf.js now mints a token only on
    // the signing-failure fallback path, so the normal path leaves these
    // rules actually governing reads. Do not reintroduce an unconditional
    // token stamp here or in the renderer.
    match /pdf-renders/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    // Homeowner portal uploads (functions/portal.js onPortalMessageDraft /
    // the photo-upload handler) — admin-SDK write only, from a burned
    // single-use portal token, never a client. Had NO rules block at all
    // until 2026-09-14 (fell through to the default-deny catch-all below,
    // which already blocked a stranger — but also meant a rep's own client
    // could never read it directly either, only via the 7-day baked-in
    // signed URL portal.js writes into the photo doc). Same posture as
    // pdf-renders above: owner/admin read, no client write.
    match /homeowner-uploads/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    // Thursday call recordings (functions/integrations/thursday.js). Copied
    // from Bland by the admin SDK — Bland's own recording_url needs the API
    // key, so it can never be played in a browser. The CRM plays them through
    // the getThursdayRecording callable (company-scoped check there); no
    // download token is ever minted. Same posture as pdf-renders.
    match /calls/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    // ── MY SKIN (personal appearance images) ───────────
    // Path: skins/{uid}/{slot}, slot one of wallpaper | texture | mascot.
    // Each user's own pictures for their own screen (my-skin.js, 2026-10-01).
    // Strictly personal: only the user reads or writes them. No admin read,
    // no team read, and the CRM reads them with getBlob() under these rules
    // (never a token download URL). Not tenant data, so a 'viewer' may style
    // their own screen. The client re-encodes through a canvas first, so only
    // jpeg/png/webp arrive, capped at 4MB.
    match /skins/{uid}/{slot} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && slot in ['wallpaper', 'texture', 'mascot']
        && request.resource.size < 4 * 1024 * 1024
        && request.resource.contentType != null
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isOwner(uid);
    }

    // ── REEL STUDIO UPLOADS (2026-10-04) ──────────────
    // Path: reel-uploads/{companyId}/{uid}/{mediaId}
    // Phone clips, photos and AI-made graphics for Reel Studio. The page
    // asks reelStartUpload for a slot first (it writes companies/{c}/
    // reel_media/{mediaId}); the reelIngestUpload trigger refuses any object
    // without a matching slot, transcodes it to a metadata-stripped
    // intermediate, and DELETES this raw file (it carries the phone's GPS).
    // Write-once (create) by the uploader into their own folder, only for
    // their own company as owner (solo: companyId == uid) or company_admin;
    // never readable or deletable by any client. Resumable uploads finalise
    // as one create. 500 MB cap.
    match /reel-uploads/{companyId}/{uid}/{mediaId} {
      allow read: if false;
      allow create: if ownerWrites(uid)
        && resource == null
        // Solo owner = a folder named for themselves AND no other company
        // on the token (the server's requireSocialManager rule: companyId =
        // token.companyId || uid). A sales rep / viewer of another company
        // cannot open a "company of one" folder of their own.
        && ((companyId == uid && request.auth.token.get('companyId', uid) == uid)
            || (request.auth.token.get('companyId', '') == companyId
                && request.auth.token.get('role', '') == 'company_admin')
            || isAdmin())
        && request.resource.size < 500 * 1024 * 1024
        && request.resource.contentType != null
        && request.resource.contentType.matches('video/(mp4|quicktime|x-m4v|webm|3gpp)|image/(jpeg|png|webp|heic|heif)');
      allow update, delete: if false;
    }
    // Rendered reels, intermediates and social copies are server-only
    // (served through /api/social-media); the default deny below covers
    // reel-work/ and social-media/.

    // ── DEFAULT DENY ──────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
